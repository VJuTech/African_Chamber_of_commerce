<!-- ACC Chapter 17: form for creating a product or service listing. -->
<section class="marketplace-form-shell">
  <div class="page-header compact-header">
    <div>
      <p class="eyebrow">Create listing</p>
      <h1>List a product or service</h1>
    </div>
    <a href="/marketplace" class="button button--secondary">Back to marketplace</a>
  </div>

  <% if (error) { %>
    <div class="status-banner error"><%= error %></div>
  <% } %>

  <% if (message) { %>
    <div class="status-banner success"><%= message %></div>
  <% } %>

  <form method="post" action="/marketplace/create" class="marketplace-form" enctype="multipart/form-data">
    <div class="form-grid">
      <div class="field-group span-2">
        <label for="title">Listing title</label>
        <input id="title" name="title" type="text" value="<%= formData.title || '' %>" required />
      </div>

      <div class="field-group span-2">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="5" required><%= formData.description || '' %></textarea>
      </div>

      <div class="field-group">
        <label for="category">Category</label>
        <select id="category" name="category" required>
          <option value="">Select business category</option>
          <% (marketplaceCategories || []).forEach((category) => { %>
            <option value="<%= category %>" <%= formData.category === category ? 'selected' : '' %>><%= category %></option>
          <% }) %>
        </select>
      </div>

      <div class="field-group">
        <label for="type">Type</label>
        <select id="type" name="type" required>
          <option value="product" <%= formData.type === 'product' ? 'selected' : '' %>>Product</option>
          <option value="service" <%= formData.type === 'service' ? 'selected' : '' %>>Service</option>
        </select>
      </div>

      <div class="field-group">
        <label for="pricingModel">Pricing model</label>
        <select id="pricingModel" name="pricingModel" required>
          <option value="fixed" <%= formData.pricingModel === 'fixed' ? 'selected' : '' %>>Fixed price</option>
          <option value="negotiable" <%= formData.pricingModel === 'negotiable' ? 'selected' : '' %>>Negotiable</option>
          <option value="range" <%= formData.pricingModel === 'range' ? 'selected' : '' %>>Price range</option>
        </select>
      </div>

      <div class="field-group">
        <label for="currency">Currency</label>
        <input id="currency" name="currency" type="text" value="<%= formData.currency || 'USD' %>" required />
      </div>

      <div class="field-group">
        <label for="price">Price</label>
        <input id="price" name="price" type="number" min="0" step="0.01" value="<%= formData.price || 0 %>" />
      </div>

      <div class="field-group">
        <label for="minPrice">Minimum price</label>
        <input id="minPrice" name="minPrice" type="number" min="0" step="0.01" value="<%= formData.minPrice || 0 %>" />
      </div>

      <div class="field-group">
        <label for="maxPrice">Maximum price</label>
        <input id="maxPrice" name="maxPrice" type="number" min="0" step="0.01" value="<%= formData.maxPrice || 0 %>" />
      </div>

      <div class="field-group">
        <label for="inventory">Stock quantity</label>
        <input id="inventory" name="inventory" type="number" min="0" value="<%= formData.inventory || 0 %>" />
      </div>

      <div class="field-group">
        <label for="visibility">Visibility</label>
        <select id="visibility" name="visibility" required>
          <option value="public" <%= formData.visibility === 'public' ? 'selected' : '' %>>Public</option>
          <option value="private" <%= formData.visibility === 'private' ? 'selected' : '' %>>Private</option>
          <option value="draft" <%= formData.visibility === 'draft' ? 'selected' : '' %>>Draft</option>
        </select>
      </div>

      <div class="field-group">
        <label for="availability">Availability</label>
        <select id="availability" name="availability">
          <option value="in_stock" <%= formData.availability === 'in_stock' ? 'selected' : '' %>>In stock</option>
          <option value="limited" <%= formData.availability === 'limited' ? 'selected' : '' %>>Limited</option>
          <option value="available" <%= formData.availability === 'available' ? 'selected' : '' %>>Available</option>
          <option value="unavailable" <%= formData.availability === 'unavailable' ? 'selected' : '' %>>Unavailable</option>
        </select>
      </div>

      <div class="field-group span-2">
        <label for="location">Business location</label>
        <div class="marketplace-country-picker" data-marketplace-country-picker>
          <input id="location" name="location" type="hidden" value="<%= formData.location || '' %>" required />
          <button type="button" class="marketplace-country-picker__trigger" aria-haspopup="listbox" aria-expanded="false">
            <span class="marketplace-country-picker__selected"><span class="marketplace-country-picker__placeholder">Select business location</span></span>
          </button>
          <div class="marketplace-country-picker__menu" role="listbox" aria-label="Business location">
            <% (africanCountries || []).forEach((country) => { %>
              <button type="button" class="marketplace-country-picker__option" role="option" data-value="<%= country.name %>" data-label="<%= country.name %>" data-flag="<%= country.flagUrl %>">
                <img src="<%= country.flagUrl %>" alt="" width="24" height="16" loading="lazy" />
                <span><%= country.name %></span>
              </button>
            <% }) %>
          </div>
        </div>
      </div>

      <div class="field-group span-2">
        <label for="tags">Tags</label>
        <input id="tags" name="tags" type="text" value="<%= formData.tags || '' %>" placeholder="coffee, organic, wholesale" />
      </div>

      <div class="field-group span-2">
        <label for="listingImage">Product image</label>
        <input id="listingImage" name="listingImage" type="file" accept="image/jpeg,image/png" />
        <small class="field-help">JPEG or PNG, up to 2 MB.</small>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="button button--primary">Create listing</button>
      <a href="/marketplace" class="button button--secondary">Cancel</a>
    </div>
  </form>
</section>

<script>
  document.querySelectorAll('[data-marketplace-country-picker]').forEach(function (picker) {
    const input = picker.querySelector('input[type="hidden"]');
    const trigger = picker.querySelector('.marketplace-country-picker__trigger');
    const selected = picker.querySelector('.marketplace-country-picker__selected');
    const options = picker.querySelectorAll('.marketplace-country-picker__option');

    function showSelected(option) {
      selected.innerHTML = '<img src="' + option.dataset.flag + '" alt="" width="24" height="16" />' +
        '<span>' + option.dataset.label + '</span>';
    }

    options.forEach(function (option) {
      if (option.dataset.value === input.value) showSelected(option);
      option.addEventListener('click', function () {
        input.value = option.dataset.value;
        showSelected(option);
        picker.classList.remove('is-open');
        trigger.setAttribute('aria-expanded', 'false');
      });
    });

    trigger.addEventListener('click', function () {
      const isOpen = picker.classList.toggle('is-open');
      trigger.setAttribute('aria-expanded', String(isOpen));
    });
  });

  document.addEventListener('click', function (event) {
    document.querySelectorAll('[data-marketplace-country-picker].is-open').forEach(function (picker) {
      if (!picker.contains(event.target)) {
        picker.classList.remove('is-open');
        picker.querySelector('.marketplace-country-picker__trigger').setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>
