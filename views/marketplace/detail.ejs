<!-- ACC Chapter 17: product or service detail page with pricing, availability, and business information. -->
<section class="marketplace-detail-shell">
  <div class="page-header compact-header">
    <div>
      <p class="eyebrow">Listing detail</p>
      <h1><%= listing.title %></h1>
    </div>
    <a href="/marketplace" class="button button--secondary">Back to marketplace</a>
  </div>

  <% if (message) { %>
    <div class="status-banner success"><%= message %></div>
  <% } %>

  <div class="marketplace-detail">
    <div class="marketplace-detail__media">
      <% if (listing.media && listing.media.length) { %>
        <img class="listing-image" src="<%= listing.media[0] %>" alt="<%= listing.title %> product image" />
      <% } else { %>
        <div class="listing-hero"><span><%= listing.type === 'product' ? 'Product listing' : 'Service listing' %></span></div>
      <% } %>
    </div>

    <div class="marketplace-detail__content">
      <div class="detail-topline">
        <span class="listing-tag"><%= listing.category %></span>
        <span class="listing-status listing-status--public"><%= listing.visibility %></span>
      </div>

      <p class="detail-description"><%= listing.description %></p>

      <div class="detail-summary">
        <div>
          <span>Pricing</span>
          <% if (listing.pricingModel === 'range') { %>
            <strong><%= listing.currency %> <%= listing.minPrice %> - <%= listing.maxPrice %></strong>
          <% } else if (listing.pricingModel === 'negotiable') { %>
            <strong>Negotiable</strong>
          <% } else { %>
            <strong><%= listing.currency %> <%= listing.price %></strong>
          <% } %>
        </div>
        <div>
          <span>Availability</span>
          <strong><%= listing.availability || 'available' %></strong>
        </div>
        <div>
          <span>Location</span>
          <strong><%= listing.location || 'Worldwide' %></strong>
        </div>
      </div>

      <% if (listing.tags && listing.tags.length) { %>
        <div class="detail-tags">
          <% listing.tags.forEach((tag) => { %>
            <span><%= tag %></span>
          <% }); %>
        </div>
      <% } %>

      <div class="detail-actions">
        <% if (user) { %>
          <% if (listing.type === 'product') { %>
            <form method="post" action="/cart/items" class="inline-form">
              <input type="hidden" name="listingId" value="<%= listing.id %>" />
              <input type="number" name="quantity" value="1" min="1" class="quantity-input" aria-label="Quantity" />
              <button type="submit" class="button button--primary">Add to cart</button>
            </form>
          <% } %>
          <form method="post" action="/messages/start" class="inline-form">
            <input type="hidden" name="targetId" value="<%= listing.sellerId %>" />
            <input type="hidden" name="subject" value="Regarding <%= listing.title %>" />
            <button type="submit" class="button button--secondary">Contact seller</button>
          </form>
          <a href="/procurement/create" class="button button--secondary">Request quote</a>
        <% } else { %>
          <a href="/login?message=Please sign in to buy or contact a seller." class="button button--primary">Sign in to continue</a>
        <% } %>
      </div>
    </div>
  </div>
</section>
