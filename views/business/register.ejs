<div class="business-shell">
  <div class="business-card">
    <div class="page-header">
      <div>
        <p class="eyebrow">African Chamber of Commerce</p>
        <h1>Register Business</h1>
      </div>
      <a class="button secondary" href="/business/my-businesses">My businesses</a>
    </div>

    <% if (error) { %>
      <div class="message error"><%= error %></div>
    <% } %>
    <% if (success) { %>
      <div class="message success"><%= success %></div>
    <% } %>

    <form method="post" action="/business/register" class="business-form" enctype="multipart/form-data">
      <div class="form-section">
        <h3>Business information</h3>
        <div class="form-grid">
          <div class="field-group">
            <label for="businessName">Business Name</label>
            <input id="businessName" name="businessName" type="text" value="<%= formData && formData.businessName ? formData.businessName : '' %>" required />
          </div>
          <div class="field-group">
            <label for="businessType">Business Type</label>
            <select id="businessType" name="businessType" required>
              <option value="">Select business type</option>
              <option value="Sole Proprietorship" <%= formData && formData.businessType === 'Sole Proprietorship' ? 'selected' : '' %>>Sole Proprietorship</option>
              <option value="Partnership" <%= formData && formData.businessType === 'Partnership' ? 'selected' : '' %>>Partnership</option>
              <option value="Limited Liability Company (LLC)" <%= formData && formData.businessType === 'Limited Liability Company (LLC)' ? 'selected' : '' %>>Limited Liability Company (LLC)</option>
              <option value="Corporation" <%= formData && formData.businessType === 'Corporation' ? 'selected' : '' %>>Corporation</option>
              <option value="Non-Governmental Organization (NGO)" <%= formData && formData.businessType === 'Non-Governmental Organization (NGO)' ? 'selected' : '' %>>Non-Governmental Organization (NGO)</option>
              <option value="Government Agency" <%= formData && formData.businessType === 'Government Agency' ? 'selected' : '' %>>Government Agency</option>
              <option value="Informal Business" <%= formData && formData.businessType === 'Informal Business' ? 'selected' : '' %>>Informal Business</option>
            </select>
          </div>
          <div class="field-group">
            <label for="countryOfResidence">Country of Residence</label>
            <div class="country-picker" data-country-picker>
              <input id="countryOfResidence" name="countryOfResidence" type="hidden" value="<%= formData && formData.countryOfResidence ? formData.countryOfResidence : '' %>" required />
              <button type="button" class="country-picker__trigger" aria-haspopup="listbox" aria-expanded="false">
                <span class="country-picker__selected"><span class="country-picker__placeholder">Select country of residence</span></span>
              </button>
              <div class="country-picker__menu" role="listbox" aria-label="Country of residence">
                <% africanCountries.forEach((country) => { %>
                  <button type="button" class="country-picker__option" role="option" data-value="<%= country.name %>" data-label="<%= country.name %>" data-flag="<%= country.flagUrl %>">
                    <img src="<%= country.flagUrl %>" alt="" width="24" height="16" loading="lazy" />
                    <span><%= country.name %></span>
                  </button>
                <% }) %>
              </div>
            </div>
          </div>
          <div class="field-group">
            <label for="countryOfRegistration">Country of Registration</label>
            <div class="country-picker" data-country-picker>
              <input id="countryOfRegistration" name="countryOfRegistration" type="hidden" value="<%= formData && formData.countryOfRegistration ? formData.countryOfRegistration : '' %>" required />
              <button type="button" class="country-picker__trigger" aria-haspopup="listbox" aria-expanded="false">
                <span class="country-picker__selected"><span class="country-picker__placeholder">Select country of registration</span></span>
              </button>
              <div class="country-picker__menu" role="listbox" aria-label="Country of registration">
                <% africanCountries.forEach((country) => { %>
                  <button type="button" class="country-picker__option" role="option" data-value="<%= country.name %>" data-label="<%= country.name %>" data-flag="<%= country.flagUrl %>">
                    <img src="<%= country.flagUrl %>" alt="" width="24" height="16" loading="lazy" />
                    <span><%= country.name %></span>
                  </button>
                <% }) %>
              </div>
            </div>
          </div>
          <div class="field-group">
            <label for="industryCategory">Industry Category</label>
            <select id="industryCategory" name="industryCategory" required>
              <option value="">Select industry category</option>
              <% industryCategories.forEach((category) => { %>
                <option value="<%= category %>" <%= formData && formData.industryCategory === category ? 'selected' : '' %>><%= category %></option>
              <% }) %>
            </select>
          </div>
          <div class="field-group full-width">
            <label for="businessAddress">Business Address</label>
            <textarea id="businessAddress" name="businessAddress" rows="3" required><%= formData && formData.businessAddress ? formData.businessAddress : '' %></textarea>
          </div>
          <div class="field-group">
            <label for="contactEmail">Contact Email</label>
            <input id="contactEmail" name="contactEmail" type="email" value="<%= formData && formData.contactEmail ? formData.contactEmail : '' %>" required />
          </div>
          <div class="field-group">
            <label for="contactPhone">Contact Phone</label>
            <input id="contactPhone" name="contactPhone" type="tel" value="<%= formData && formData.contactPhone ? formData.contactPhone : '' %>" required />
          </div>
          <div class="field-group">
            <label for="registrationNumber">Registration Number (optional)</label>
            <input id="registrationNumber" name="registrationNumber" type="text" value="<%= formData && formData.registrationNumber ? formData.registrationNumber : '' %>" />
          </div>
          <div class="field-group">
            <label for="taxIdentificationNumber">Tax Identification Number (optional)</label>
            <input id="taxIdentificationNumber" name="taxIdentificationNumber" type="text" value="<%= formData && formData.taxIdentificationNumber ? formData.taxIdentificationNumber : '' %>" />
          </div>
          <div class="field-group">
            <label for="website">Website (optional)</label>
            <input id="website" name="website" type="url" value="<%= formData && formData.website ? formData.website : '' %>" />
          </div>
          <div class="field-group">
            <label for="logo">Business logo (optional)</label>
            <input id="logo" name="logo" type="file" accept="image/jpeg,image/png,image/webp" />
            <small>JPEG, PNG, or WebP up to 2 MB.</small>
          </div>
          <div class="field-group full-width">
            <label for="businessDescription">Business Description</label>
            <textarea id="businessDescription" name="businessDescription" rows="4"><%= formData && formData.businessDescription ? formData.businessDescription : '' %></textarea>
          </div>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="button primary">Create Business Account</button>
        <button type="button" class="button secondary" id="save-draft-btn">Save Draft</button>
      </div>
    </form>

    <form id="draft-form" method="post" action="/business/draft" style="display:none;">
      <div id="draft-form-fields"></div>
    </form>
  </div>
</div>

<script>
  document.querySelectorAll('[data-country-picker]').forEach(function (picker) {
    const input = picker.querySelector('input[type="hidden"]');
    const trigger = picker.querySelector('.country-picker__trigger');
    const selected = picker.querySelector('.country-picker__selected');
    const options = picker.querySelectorAll('.country-picker__option');

    function showSelected(option) {
      selected.innerHTML = '<img src="' + option.dataset.flag + '" alt="" width="24" height="16" />' +
        '<span>' + option.dataset.label + '</span>';
    }

    options.forEach(function (option) {
      if (option.dataset.value === input.value) showSelected(option);
      option.addEventListener('click', function () {
        input.value = option.dataset.value;
        showSelected(option);
        picker.classList.remove('is-open');
        trigger.setAttribute('aria-expanded', 'false');
      });
    });

    trigger.addEventListener('click', function () {
      const isOpen = picker.classList.toggle('is-open');
      trigger.setAttribute('aria-expanded', String(isOpen));
    });
  });

  document.addEventListener('click', function (event) {
    document.querySelectorAll('[data-country-picker].is-open').forEach(function (picker) {
      if (!picker.contains(event.target)) {
        picker.classList.remove('is-open');
        picker.querySelector('.country-picker__trigger').setAttribute('aria-expanded', 'false');
      }
    });
  });

  document.getElementById('save-draft-btn')?.addEventListener('click', function () {
    const form = document.querySelector('.business-form');
    const draftForm = document.getElementById('draft-form');
    const fieldsContainer = document.getElementById('draft-form-fields');
    fieldsContainer.innerHTML = '';

    Array.from(new FormData(form).entries()).forEach(([key, value]) => {
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = key;
      input.value = value;
      fieldsContainer.appendChild(input);
    });

    draftForm.submit();
  });
</script>

<style>
  .business-shell {
    display: flex;
    justify-content: center;
    padding: 2rem 0;
  }
  .business-card {
    width: min(980px, 100%);
    background: #fff;
    border-radius: 18px;
    box-shadow: 0 8px 30px rgba(17, 39, 67, 0.08);
    padding: 2rem;
  }
  .page-header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  .eyebrow {
    color: #285baf;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }
  .message {
    margin-bottom: 1rem;
    padding: 0.8rem 1rem;
    border-radius: 10px;
    font-weight: 600;
  }
  .message.error { background: #fff1f0; color: #a32b2b; }
  .message.success { background: #ebfff5; color: #0f6a3a; }
  .form-section {
    margin-bottom: 1.5rem;
  }
  .form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }
  .field-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .field-group.full-width {
    grid-column: 1 / -1;
  }
  .field-group label {
    font-weight: 600;
    color: #213b52;
  }
  .field-group input,
  .field-group select,
  .field-group textarea {
    width: 100%;
    padding: 0.8rem 0.9rem;
    border: 1px solid #d8e0eb;
    border-radius: 10px;
    font: inherit;
    color: #1d2d3d;
    background: #fff;
  }
  .country-picker {
    position: relative;
  }
  .country-picker__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 48px;
    padding: 0.8rem 0.9rem;
    border: 1px solid #d8e0eb;
    border-radius: 10px;
    font: inherit;
    text-align: left;
    color: #1d2d3d;
    background: #fff;
    cursor: pointer;
  }
  .country-picker__trigger::after {
    content: "\\25BE";
    color: #587087;
  }
  .country-picker__selected,
  .country-picker__option {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .country-picker__selected img,
  .country-picker__option img {
    flex: 0 0 auto;
    object-fit: cover;
    border: 1px solid #d8e0eb;
  }
  .country-picker__placeholder {
    color: #6b7d8d;
  }
  .country-picker__menu {
    display: none;
    position: absolute;
    z-index: 10;
    top: calc(100% + 0.35rem);
    left: 0;
    right: 0;
    max-height: 260px;
    overflow-y: auto;
    padding: 0.35rem;
    border: 1px solid #d8e0eb;
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 12px 28px rgba(17, 39, 67, 0.16);
  }
  .country-picker.is-open .country-picker__menu { display: block; }
  .country-picker__option {
    width: 100%;
    padding: 0.6rem 0.55rem;
    border: 0;
    border-radius: 7px;
    font: inherit;
    text-align: left;
    color: #1d2d3d;
    background: transparent;
    cursor: pointer;
  }
  .country-picker__option:hover,
  .country-picker__option:focus-visible { background: #eef5fb; }
  .form-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: flex-start;
    margin-top: 1rem;
  }
  @media (max-width: 640px) {
    .business-card { padding: 1rem; }
    .page-header { flex-direction: column; align-items: flex-start; }
    .form-actions { flex-direction: column; }
  }
</style>
