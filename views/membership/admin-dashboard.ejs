<!-- Admin Membership Management Dashboard -->
<!-- Requirement ACC-FRS-MEM-008: Membership Audit Logging (Admin View) -->

<div class="admin-membership-dashboard">
  <div class="page-header">
    <h1>Membership Management</h1>
    <p class="subtitle">Administrative dashboard for membership and account management</p>
  </div>

  <div class="admin-tabs">
    <div class="tab-navigation">
      <button class="tab-button active" onclick="switchTab('tiers')">Membership Tiers</button>
      <button class="tab-button" onclick="switchTab('users')">Manage Users</button>
      <button class="tab-button" onclick="switchTab('audit')">Audit Logs</button>
    </div>

    <!-- TIERS TAB -->
    <div id="tiers-tab" class="tab-content active">
      <h2>Membership Tiers</h2>
      
      <% if (tiers && tiers.length > 0) { %>
        <div class="tiers-grid">
          <% tiers.forEach(tier => { %>
            <div class="tier-card">
              <div class="tier-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <h3><%= tier.tier_name %></h3>
                <span class="tier-slug"><%= tier.tier_slug.toUpperCase() %></span>
              </div>

              <div class="tier-body">
                <div class="tier-info">
                  <p><strong>Price:</strong> 
                    <% if (tier.pricing === 0) { %>
                      FREE
                    <% } else if (tier.pricing) { %>
                      $<%= tier.pricing %> / <%= tier.billing_cycle %>
                    <% } else { %>
                      Custom
                    <% } %>
                  </p>
                  <p><strong>Description:</strong> <%= tier.description || 'N/A' %></p>
                  <p><strong>Status:</strong> 
                    <span class="badge <%= tier.is_active ? 'active' : 'inactive' %>">
                      <%= tier.is_active ? 'Active' : 'Inactive' %>
                    </span>
                  </p>
                </div>

                <div class="tier-actions">
                  <button class="btn-small btn-edit" onclick="editTier(<%= tier.id %>)">Edit</button>
                  <button class="btn-small btn-view" onclick="viewTierDetails(<%= tier.id %>)">View Details</button>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="alert alert-warning">
          <p>No membership tiers configured.</p>
        </div>
      <% } %>
    </div>

    <!-- USERS TAB -->
    <div id="users-tab" class="tab-content">
      <h2>Manage User Memberships</h2>
      
      <div class="user-management-form">
        <h3>Change User Membership</h3>
        <form id="userMembershipForm" method="POST" action="/membership/api/admin/change-tier" onsubmit="handleUserMembershipChange(event)">
          <div class="form-row">
            <div class="form-group">
              <label for="userId">User ID or Email:</label>
              <input type="text" id="userId" name="userId" placeholder="Enter user ID or email" required>
            </div>

            <div class="form-group">
              <label for="tierId">New Tier:</label>
              <select id="tierId" name="tierId" required>
                <option value="">Select a tier...</option>
                <% if (tiers && tiers.length > 0) { %>
                  <% tiers.forEach(tier => { %>
                    <option value="<%= tier.id %>"><%= tier.tier_name %></option>
                  <% }); %>
                <% } %>
              </select>
            </div>

            <div class="form-group">
              <label for="reason">Reason:</label>
              <input type="text" id="reason" name="reason" placeholder="Reason for change" required>
            </div>

            <button type="submit" class="btn btn-primary">Apply Change</button>
          </div>
        </form>
      </div>

      <div class="user-actions-form">
        <h3>Account Actions</h3>
        
        <div class="action-section">
          <h4>Suspend Account</h4>
          <form id="suspendForm" method="POST" action="/membership/api/suspend" onsubmit="handleSuspend(event)">
            <div class="form-row">
              <input type="hidden" name="userId" id="suspendUserId">
              <div class="form-group">
                <input type="text" id="suspendUserInput" placeholder="Enter user ID" required>
              </div>
              <div class="form-group">
                <input type="text" id="suspendReason" name="reason" placeholder="Reason for suspension" required>
              </div>
              <button type="submit" class="btn btn-danger">Suspend</button>
            </div>
          </form>
        </div>

        <div class="action-section">
          <h4>Reactivate Account</h4>
          <form id="reactivateForm" method="POST" action="/membership/api/reactivate" onsubmit="handleReactivate(event)">
            <div class="form-row">
              <input type="hidden" name="userId" id="reactivateUserId">
              <div class="form-group">
                <input type="text" id="reactivateUserInput" placeholder="Enter user ID" required>
              </div>
              <button type="submit" class="btn btn-success">Reactivate</button>
            </div>
          </form>
        </div>

        <div class="action-section">
          <h4>Process Expired Memberships</h4>
          <p>Find and update all expired memberships to 'expired' status</p>
          <form id="processExpiryForm" method="POST" action="/membership/api/process-expired" onsubmit="handleProcessExpiry(event)">
            <button type="submit" class="btn btn-warning">Process Expiries</button>
          </form>
        </div>
      </div>
    </div>

    <!-- AUDIT TAB -->
    <div id="audit-tab" class="tab-content">
      <h2>Membership Audit Logs</h2>
      
      <div class="audit-filters">
        <h3>Filter Logs</h3>
        <form id="auditFilterForm" method="GET" action="/membership/api/audit-logs">
          <div class="form-row">
            <div class="form-group">
              <label for="eventType">Event Type:</label>
              <select id="eventType" name="eventType">
                <option value="">All Events</option>
                <option value="UPGRADE">Upgrade</option>
                <option value="DOWNGRADE">Downgrade</option>
                <option value="SUSPENSION">Suspension</option>
                <option value="REACTIVATION">Reactivation</option>
                <option value="EXPIRY">Expiry</option>
                <option value="DEACTIVATION">Deactivation</option>
              </select>
            </div>

            <div class="form-group">
              <label for="auditUserId">User ID:</label>
              <input type="text" id="auditUserId" name="userId" placeholder="Filter by user">
            </div>

            <button type="submit" class="btn btn-primary">Filter</button>
          </div>
        </form>
      </div>

      <% if (recentAuditLogs && recentAuditLogs.length > 0) { %>
        <div class="audit-table-container">
          <h3>Recent Events (Last 50)</h3>
          <table class="audit-table">
            <thead>
              <tr>
                <th>User ID</th>
                <th>Event Type</th>
                <th>Action</th>
                <th>From</th>
                <th>To</th>
                <th>Initiated By</th>
                <th>Outcome</th>
                <th>Date/Time</th>
              </tr>
            </thead>
            <tbody>
              <% recentAuditLogs.forEach(log => { %>
                <tr class="audit-row <%= log.outcome %>">
                  <td><%= log.user_id || 'N/A' %></td>
                  <td>
                    <span class="event-badge <%= log.event_type.toLowerCase() %>">
                      <%= log.event_type %>
                    </span>
                  </td>
                  <td><%= log.action %></td>
                  <td><%= log.previous_tier || 'N/A' %></td>
                  <td><%= log.new_tier || 'N/A' %></td>
                  <td>
                    <span class="initiated-by <%= log.initiated_by %>">
                      <%= log.initiated_by %>
                    </span>
                  </td>
                  <td>
                    <span class="outcome-badge <%= log.outcome %>">
                      <%= log.outcome %>
                    </span>
                  </td>
                  <td><%= new Date(log.created_at).toLocaleString() %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="alert alert-info">
          <p>No audit logs found.</p>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script>
function switchTab(tabName) {
  // Hide all tabs
  document.querySelectorAll('.tab-content').forEach(tab => {
    tab.classList.remove('active');
  });
  
  // Remove active class from all buttons
  document.querySelectorAll('.tab-button').forEach(btn => {
    btn.classList.remove('active');
  });
  
  // Show selected tab
  document.getElementById(tabName + '-tab').classList.add('active');
  event.target.classList.add('active');
}

function editTier(tierId) {
  alert('Edit tier functionality would be implemented here for tier ID: ' + tierId);
}

function viewTierDetails(tierId) {
  alert('View tier details for tier ID: ' + tierId);
}

function handleUserMembershipChange(event) {
  event.preventDefault();
  if (confirm('Are you sure you want to change this user\'s membership?')) {
    document.getElementById('userMembershipForm').submit();
  }
}

function handleSuspend(event) {
  event.preventDefault();
  const userId = document.getElementById('suspendUserInput').value;
  document.getElementById('suspendUserId').value = userId;
  
  if (confirm('Are you sure you want to suspend this account? User will lose access.')) {
    document.getElementById('suspendForm').submit();
  }
}

function handleReactivate(event) {
  event.preventDefault();
  const userId = document.getElementById('reactivateUserInput').value;
  document.getElementById('reactivateUserId').value = userId;
  
  if (confirm('Reactivate this account?')) {
    document.getElementById('reactivateForm').submit();
  }
}

function handleProcessExpiry(event) {
  event.preventDefault();
  if (confirm('Process all expired memberships? This will update their status to "expired".')) {
    document.getElementById('processExpiryForm').submit();
  }
}
</script>

<style>
