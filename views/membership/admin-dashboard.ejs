    padding: 20px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .page-header {
    text-align: center;
    margin-bottom: 30px;
  }

  .page-header h1 {
    font-size: 2rem;
    color: #333;
    margin-bottom: 10px;
  }

  .subtitle {
    color: #666;
  }

  .admin-tabs {
    background: white;
    border-radius: 12px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    overflow: hidden;
  }

  .tab-navigation {
    display: flex;
    border-bottom: 2px solid #f0f0f0;
    background-color: #f8f9fa;
  }

  .tab-button {
    flex: 1;
