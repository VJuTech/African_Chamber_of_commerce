  }

  .btn-edit {
    background-color: #667eea;
    color: white;
  }

  .btn-edit:hover {
    background-color: #5568d3;
  }

  .btn-view {
    background-color: #17a2b8;
    color: white;
  }

  .btn-view:hover {
    background-color: #138496;
  }

  .user-management-form,
  .user-actions-form,
  .audit-filters {
    background-color: #f8f9fa;
    padding: 20px;
    border-radius: 8px;
    margin-bottom: 25px;
  }

  .user-management-form h3,
  .user-actions-form h3,
  .audit-filters h3 {
    margin-top: 0;
