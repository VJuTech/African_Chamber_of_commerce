<!-- Membership Downgrade View -->
<!-- Requirement ACC-FRS-MEM-003: Downgrade Membership -->

<div class="downgrade-membership-container">
  <div class="page-header">
    <h1>Downgrade Your Membership</h1>
    <p class="subtitle">Lower your membership tier (effective at end of billing cycle)</p>
  </div>

  <div class="info-alert">
    <h3>⚠️ Important Information</h3>
    <p>Your downgrade will take effect at the end of your current billing cycle. You will continue to enjoy all benefits of your current tier until the renewal date.</p>
    <p>Current renewal date: <strong><%= currentMembership.membership_renewal_date ? new Date(currentMembership.membership_renewal_date).toLocaleDateString() : 'N/A' %></strong></p>
  </div>

  <% if (currentMembership) { %>
    <div class="current-tier-card">
      <h3>Your Current Membership</h3>
      <div class="tier-info">
        <strong><%= currentMembership.tier_name %></strong>
        <span class="badge"><%= currentMembership.tier_slug.toUpperCase() %></span>
      </div>
    </div>
  <% } %>

  <% if (availableTiers && availableTiers.length > 0) { %>
    <div class="tiers-grid">
      <% availableTiers.forEach(tier => { %>
        <div class="tier-card">
          <div class="tier-header">
            <h3><%= tier.tier_name %></h3>
            <span class="tier-slug"><%= tier.tier_slug %></span>
          </div>

          <div class="tier-price">
            <% if (tier.pricing === 0) { %>
              <span class="price">FREE</span>
            <% } else if (tier.pricing) { %>
              <span class="price">$<%= tier.pricing %></span>
              <span class="billing">/ <%= tier.billing_cycle || 'month' %></span>
            <% } else { %>
              <span class="price">Custom</span>
            <% } %>
          </div>

          <div class="tier-description">
            <p><%= tier.description || 'Standard membership tier' %></p>
          </div>

          <% if (tier.features && tier.features.length > 0) { %>
            <div class="features-list">
              <h4>Features Included:</h4>
              <ul>
                <% tier.features.slice(0, 5).forEach(feature => { %>
                  <li>
                    <span class="checkmark">✓</span>
                    <span><%= feature.feature_name %></span>
                  </li>
                <% }); %>
              </ul>
            </div>
          <% } %>

          <button class="btn-downgrade" onclick="initiateMembershipDowngrade(<%= tier.id %>, '<%= tier.tier_name %>')">
            Downgrade to this Tier
          </button>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="alert alert-info">
      <p>You are already on the lowest membership tier. No downgrades available.</p>
    </div>
  <% } %>
</div>

<script>
function initiateMembershipDowngrade(tierId, tierName) {
  const reason = prompt(`Why are you downgrading to ${tierName}? (optional)`, '');
  
  if (reason !== null) {
    if (!confirm(`Your downgrade to ${tierName} will take effect at the end of your billing cycle. Continue?`)) {
      return;
    }

    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/membership/api/downgrade';
    
    const tierInput = document.createElement('input');
    tierInput.type = 'hidden';
    tierInput.name = 'newTierId';
    tierInput.value = tierId;
    form.appendChild(tierInput);
    
    if (reason) {
      const reasonInput = document.createElement('input');
      reasonInput.type = 'hidden';
      reasonInput.name = 'reason';
      reasonInput.value = reason;
      form.appendChild(reasonInput);
    }
    
    document.body.appendChild(form);
    form.submit();
  }
}
</script>

