<!-- Deactivate Account View -->
<!-- Requirement ACC-FRS-MEM-006: Deactivate Account (User Initiated) -->

<div class="deactivate-account-container">
  <div class="page-header">
    <h1>Deactivate Your Account</h1>
    <p class="subtitle">Permanently deactivate your account</p>
  </div>

  <div class="warning-alert">
    <h3>⚠️ Warning: This Action Cannot Be Undone</h3>
    <ul>
      <li>Your account will be immediately deactivated</li>
      <li>You will lose access to all platform features</li>
      <li>All active memberships will be terminated</li>
      <li>Your data will be retained for 30 days before deletion</li>
      <li>You will no longer be able to log in</li>
    </ul>
  </div>

  <div class="deactivation-form-container">
    <form id="deactivateForm" method="POST" action="/membership/api/deactivate" onsubmit="handleDeactivation(event)">
      <div class="form-section">
        <h3>Before You Go...</h3>
        <p>Please tell us why you're deactivating your account (optional):</p>
        
        <div class="form-group">
          <label for="reason">Reason for Deactivation:</label>
          <textarea 
            id="reason" 
            name="reason" 
            placeholder="Help us improve - what could we do better?" 
            rows="5"
            maxlength="500"
          ></textarea>
          <small>Max 500 characters</small>
        </div>
      </div>

      <div class="confirmation-section">
        <h3>Confirm Deactivation</h3>
        <p>To proceed, please confirm that you understand the consequences:</p>
        
        <div class="checkbox-group">
          <label class="checkbox-label">
            <input type="checkbox" name="confirmDeactivation" id="confirmDeactivation" required>
            <span>I understand that deactivating my account is permanent and cannot be reversed</span>
          </label>
        </div>

        <div class="checkbox-group">
          <label class="checkbox-label">
            <input type="checkbox" name="confirmDataLoss" id="confirmDataLoss" required>
            <span>I confirm that I will lose all access to my account immediately</span>
          </label>
        </div>

        <div class="checkbox-group">
          <label class="checkbox-label">
            <input type="checkbox" name="confirmMembershipTermination" id="confirmMembershipTermination" required>
            <span>I acknowledge that my membership will be terminated</span>
          </label>
        </div>
      </div>

      <div class="action-buttons">
        <a href="/membership/status" class="btn btn-cancel">Cancel</a>
        <button type="submit" class="btn btn-danger" id="deactivateBtn" disabled>
          Deactivate Account Permanently
        </button>
      </div>
    </form>
  </div>
</div>

<script>
// Enable submit button only when all checkboxes are checked
document.getElementById('confirmDeactivation').addEventListener('change', updateButtonState);
document.getElementById('confirmDataLoss').addEventListener('change', updateButtonState);
document.getElementById('confirmMembershipTermination').addEventListener('change', updateButtonState);

function updateButtonState() {
  const allChecked = 
    document.getElementById('confirmDeactivation').checked &&
    document.getElementById('confirmDataLoss').checked &&
    document.getElementById('confirmMembershipTermination').checked;
  
  document.getElementById('deactivateBtn').disabled = !allChecked;
}

function handleDeactivation(event) {
  event.preventDefault();
  
  const confirmed = confirm(
    '⚠️ FINAL WARNING: Are you absolutely sure you want to permanently deactivate your account? This cannot be undone!'
  );
  
  if (confirmed) {
    document.getElementById('deactivateForm').submit();
  }
}
</script>

