<!-- Membership Upgrade View -->
<!-- Requirement ACC-FRS-MEM-002: Upgrade Membership -->

<div class="upgrade-membership-container">
  <div class="page-header">
    <h1>Upgrade Your Membership</h1>
    <p class="subtitle">Choose a higher tier to unlock more features and benefits</p>
  </div>

  <% if (currentMembership) { %>
    <div class="current-tier-card">
      <h3>Your Current Membership</h3>
      <div class="tier-info">
        <strong><%= currentMembership.tier_name %></strong>
        <span class="badge"><%= currentMembership.tier_slug.toUpperCase() %></span>
      </div>
    </div>
  <% } %>

  <% if (availableTiers && availableTiers.length > 0) { %>
    <div class="tiers-grid">
      <% availableTiers.forEach(tier => { %>
        <div class="tier-card">
          <div class="tier-header">
            <h3><%= tier.tier_name %></h3>
            <span class="tier-slug"><%= tier.tier_slug %></span>
          </div>

          <div class="tier-price">
            <% if (tier.pricing === 0) { %>
              <span class="price">FREE</span>
            <% } else if (tier.pricing) { %>
              <span class="price">$<%= tier.pricing %></span>
              <span class="billing">/ <%= tier.billing_cycle || 'month' %></span>
            <% } else { %>
              <span class="price">Custom</span>
            <% } %>
          </div>

          <div class="tier-description">
            <p><%= tier.description || 'Premium membership tier' %></p>
          </div>

          <% if (tier.features && tier.features.length > 0) { %>
            <div class="features-list">
              <h4>Features Included:</h4>
              <ul>
                <% tier.features.slice(0, 5).forEach(feature => { %>
                  <li>
                    <span class="checkmark">✓</span>
                    <span><%= feature.feature_name %></span>
                  </li>
                <% }); %>
                <% if (tier.features.length > 5) { %>
                  <li class="more-features">
                    + <%= tier.features.length - 5 %> more features
                  </li>
                <% } %>
              </ul>
            </div>
          <% } %>

          <% if (tier.limits && tier.limits.length > 0) { %>
            <div class="limits-list">
              <h4>Limits:</h4>
              <ul>
                <% tier.limits.slice(0, 3).forEach(limit => { %>
                  <li>
                    <span class="limit-key"><%= limit.limit_key.replace(/_/g, ' ').toUpperCase() %>:</span>
                    <span class="limit-value"><%= limit.limit_value %></span>
                  </li>
                <% }); %>
              </ul>
            </div>
          <% } %>

          <button class="btn-upgrade" onclick="initiateMembershipUpgrade(<%= tier.id %>)">
            Upgrade Now
          </button>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="alert alert-info">
      <p>No higher membership tiers are available for upgrade at this time.</p>
    </div>
  <% } %>
</div>

<script>
function initiateMembershipUpgrade(tierId) {
  if (confirm('Are you sure you want to upgrade your membership? You will be redirected to payment.')) {
    // In a production system, this would integrate with a payment gateway
    // For now, we'll submit the form to process the upgrade
    
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/membership/api/upgrade';
    
    const tierInput = document.createElement('input');
    tierInput.type = 'hidden';
    tierInput.name = 'newTierId';
    tierInput.value = tierId;
    form.appendChild(tierInput);
    
    document.body.appendChild(form);
    form.submit();
  }
}
</script>

