<main class="security-page security-page--narrow">
  <section class="security-panel"><p class="security-eyebrow">MFA enrollment</p><h1>Confirm your method</h1><p><%= message %></p><% if (error) { %><div class="security-alert security-alert--error"><%= error %></div><% } %>
    <form method="post" action="/security/mfa/verify" class="security-form"><label for="code">Verification code</label><input id="code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" minlength="6" maxlength="6" required /><button type="submit" class="primary-btn">Enable MFA</button></form>
    <a class="security-back-link" href="/security/settings">Cancel enrollment</a>
  </section>
</main>
