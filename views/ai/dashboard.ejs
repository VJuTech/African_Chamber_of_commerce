<main class="ai-page">
  <section class="ai-hero"><div><p class="ai-eyebrow">ACC intelligence layer</p><h1>Discover what moves your business forward</h1><p>Personalized discovery, smarter search, and useful signals built from your ACC activity and privacy choices.</p></div><span class="ai-live"><i></i>PostgreSQL intelligence</span></section>
  <% if (message) { %><p class="ai-notice"><%= message %></p><% } %>
  <form class="ai-search" action="/ai/search" method="get"><input type="search" name="q" value="<%= query || '' %>" placeholder="Search businesses, products, services, or categories" aria-label="Search ACC" required><button type="submit">Search ACC</button></form>
  <% if (searchResults && searchResults.query) { %><section class="ai-panel ai-panel--wide"><div class="ai-panel__head"><div><h2>Search results</h2><small>Ranked for “<%= searchResults.query %>”</small></div><span class="ai-pill"><%= searchResults.results.length %> results</span></div><div class="ai-cards"><% searchResults.results.forEach((item) => { %><article class="ai-card"><h3><a href="/marketplace/<%= item.id %>"><%= item.title %></a></h3><p><%= item.description %></p><small><%= item.category %> · Relevance <%= Math.round(item.score) %></small><div class="ai-actions"><button type="button" data-ai-interaction data-event-type="search_click" data-resource-type="listing" data-resource-id="<%= item.id %>">Useful</button></div></article><% }); %></div><% if (!searchResults.results.length) { %><p class="ai-empty">No matching listings were found. Try a category or broader phrase.</p><% } %></section><% } %>
  <div class="ai-grid">
    <section class="ai-panel ai-panel--wide"><div class="ai-panel__head"><div><p class="ai-eyebrow">Personalized discovery</p><h2>Recommended for you</h2></div><span class="ai-pill"><%= enabled ? 'Personalized' : 'Privacy controlled' %></span></div><% if (enabled && recommendations.length) { %><div class="ai-cards"><% recommendations.forEach((item) => { %><article class="ai-card"><h3><a href="/marketplace/<%= item.id %>"><%= item.title %></a></h3><p><%= item.description %></p><small><%= item.category %> · <%= item.reason %></small><div class="ai-actions"><button type="button" data-ai-feedback data-id="<%= item.id %>" data-feedback="positive">Relevant</button><button type="button" data-ai-feedback data-id="<%= item.id %>" data-feedback="dismissed">Hide</button></div></article><% }); %></div><% } else { %><p class="ai-empty"><%= message || 'Enable recommendations below to receive personalized businesses, products, and services.' %></p><% } %></section>
    <section class="ai-panel"><div class="ai-panel__head"><div><p class="ai-eyebrow">Behavior signals</p><h2>Your activity patterns</h2></div></div><div class="ai-patterns"><% insights.patterns.forEach((pattern) => { %><div class="ai-pattern"><span><%= pattern.eventType.replace(/_/g, ' ') %></span><strong><%= pattern.count %></strong></div><% }); %><% if (!insights.patterns.length) { %><p class="ai-empty">Your activity patterns will appear here as you explore ACC.</p><% } %></div></section>
    <section class="ai-panel"><div class="ai-panel__head"><div><p class="ai-eyebrow">Privacy by design</p><h2>AI preferences</h2></div></div><form class="ai-form" action="/ai/privacy" method="post"><label>Personalization scope<select name="personalizationScope"><option value="none" <%= consent.personalizationScope === 'none' ? 'selected' : '' %>>Off</option><option value="platform" <%= consent.personalizationScope === 'platform' ? 'selected' : '' %>>ACC platform activity</option><option value="business" <%= consent.personalizationScope === 'business' ? 'selected' : '' %>>My business activity</option></select></label><label class="ai-check"><input type="checkbox" name="behaviorAnalysisEnabled" value="true" <%= consent.behaviorAnalysisEnabled ? 'checked' : '' %>> Analyze my interactions to improve relevance</label><label class="ai-check"><input type="checkbox" name="fraudAlertsEnabled" value="true" <%= consent.fraudAlertsEnabled ? 'checked' : '' %>> Receive security and AI alerts</label><button type="submit">Save privacy settings</button></form></section>
    <section class="ai-panel"><div class="ai-panel__head"><div><p class="ai-eyebrow">Opportunity planning</p><h2>Generate a forecast</h2></div></div><form class="ai-form" action="/ai/predictions" method="post"><label>Business ID<input type="number" name="businessId" min="1" placeholder="Optional: your business ID"></label><small class="ai-muted">Forecasts use persisted order activity and show their confidence and horizon.</small><button type="submit">Generate demand forecast</button></form></section>
  </div>
</main>
<script src="/scripts/ai.js" defer></script>
