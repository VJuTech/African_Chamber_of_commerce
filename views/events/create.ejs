<!-- Chapter 15: organizer form for creating and publishing ACC events. -->
<section class="event-form-shell">
  <div class="page-header compact-header">
    <div>
      <p class="eyebrow">Create event</p>
      <h1>Host a business engagement</h1>
    </div>
    <a href="/events" class="button button--secondary">Back to events</a>
  </div>

  <% if (error) { %>
    <div class="status-banner error"><%= error %></div>
  <% } %>

  <form method="post" action="/events/create" class="event-form">
    <div class="form-grid">
      <div class="field-group span-2">
        <label for="title">Event title</label>
        <input id="title" name="title" type="text" value="<%= formData.title || '' %>" required />
      </div>

      <div class="field-group span-2">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="5" required><%= formData.description || '' %></textarea>
      </div>

      <div class="field-group">
        <label for="organizer">Organizer</label>
        <input id="organizer" name="organizer" type="text" value="<%= formData.organizer || '' %>" required />
      </div>

      <div class="field-group">
        <label for="eventType">Event type</label>
        <select id="eventType" name="eventType" required>
          <option value="physical" <%= formData.eventType === 'physical' ? 'selected' : '' %>>Physical</option>
          <option value="virtual" <%= formData.eventType === 'virtual' ? 'selected' : '' %>>Virtual</option>
          <option value="hybrid" <%= formData.eventType === 'hybrid' ? 'selected' : '' %>>Hybrid</option>
          <option value="private" <%= formData.eventType === 'private' ? 'selected' : '' %>>Private</option>
          <option value="public" <%= formData.eventType === 'public' ? 'selected' : '' %>>Public</option>
        </select>
      </div>

      <div class="field-group">
        <label for="eventFormat">Format</label>
        <select id="eventFormat" name="eventFormat">
          <option value="physical" <%= formData.eventFormat === 'physical' ? 'selected' : '' %>>Physical</option>
          <option value="virtual" <%= formData.eventFormat === 'virtual' ? 'selected' : '' %>>Virtual</option>
          <option value="hybrid" <%= formData.eventFormat === 'hybrid' ? 'selected' : '' %>>Hybrid</option>
        </select>
      </div>

      <div class="field-group">
        <label for="startDate">Start date & time</label>
        <input id="startDate" name="startDate" type="datetime-local" value="<%= formData.startDate || '' %>" required />
      </div>

      <div class="field-group">
        <label for="endDate">End date & time</label>
        <input id="endDate" name="endDate" type="datetime-local" value="<%= formData.endDate || '' %>" />
      </div>

      <div class="field-group span-2">
        <label for="location">Location / virtual link</label>
        <input id="location" name="location" type="text" value="<%= formData.location || '' %>" placeholder="Venue name or Zoom/Teams link" required />
      </div>

      <div class="field-group">
        <label for="visibility">Visibility</label>
        <select id="visibility" name="visibility" required>
          <option value="public" <%= formData.visibility === 'public' ? 'selected' : '' %>>Public</option>
          <option value="private" <%= formData.visibility === 'private' ? 'selected' : '' %>>Private</option>
          <option value="invite-only" <%= formData.visibility === 'invite-only' ? 'selected' : '' %>>Invite-only</option>
        </select>
      </div>

      <div class="field-group">
        <label for="capacity">Capacity</label>
        <input id="capacity" name="capacity" type="number" min="0" value="<%= formData.capacity || 50 %>" />
      </div>

      <div class="field-group">
        <label for="ticketType">Ticket type</label>
        <select id="ticketType" name="ticketType">
          <option value="free" <%= formData.ticketType === 'free' ? 'selected' : '' %>>Free</option>
          <option value="paid" <%= formData.ticketType === 'paid' ? 'selected' : '' %>>Paid</option>
        </select>
      </div>

      <div class="field-group">
        <label for="price">Ticket price</label>
        <input id="price" name="price" type="number" min="0" step="0.01" value="<%= formData.price || 0 %>" />
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="button button--primary">Create event</button>
      <a href="/events" class="button button--secondary">Cancel</a>
    </div>
  </form>
</section>
