<!-- Chapter 24 case detail, evidence, moderation, mediation, and resolution page. -->
<div class="dispute-shell"><section class="dispute-hero"><div><p class="dispute-kicker"><%= dispute.reference %> / Case file</p><h1>Dispute case</h1><p><%= dispute.issueDescription %></p></div><a class="dispute-button dispute-button--secondary" href="/disputes">Back to history</a></section><% if (message) { %><div class="dispute-notice"><%= message %></div><% } %><div class="dispute-grid"><section class="dispute-panel"><div class="dispute-panel__header"><div><h2>Case overview</h2><p>Linked transaction and current lifecycle state.</p></div><span class="dispute-status dispute-status--<%= dispute.status %>"><%= dispute.status.replace(/_/g, ' ') %></span></div><dl class="dispute-summary"><div><dt>Parties</dt><dd><%= dispute.partyIds.join(', ') %></dd></div><div><dt>Order</dt><dd><%= dispute.orderId || 'Not linked' %></dd></div><div><dt>Contract</dt><dd><%= dispute.contractId || 'Not linked' %></dd></div><div><dt>Raised by</dt><dd><%= dispute.raisedBy %></dd></div><div><dt>Description</dt><dd><%= dispute.issueDescription %></dd></div><div><dt>Resolution</dt><dd><%= dispute.resolutionType || 'Pending decision' %> <%= dispute.resolutionDetails || '' %></dd></div></dl><div class="dispute-actions"><% if (['open', 'under_review', 'in_mediation', 'escalated'].includes(dispute.status)) { %><form method="post" action="/disputes/<%= dispute.id %>/escalate"><input type="hidden" name="reason" value="Additional review requested." /><button class="dispute-button dispute-button--quiet" type="submit">Escalate case</button></form><% } %><% if (dispute.status === 'in_mediation') { %><a class="dispute-button dispute-button--quiet" href="/messages">Open mediation messages</a><% } %><% if (dispute.contractId) { %><a class="dispute-button dispute-button--quiet" href="/contracts/<%= dispute.contractId %>">Open contract</a><% } %></div></section><section class="dispute-panel"><div class="dispute-panel__header"><div><h2>Evidence</h2><p>Private case evidence with integrity checks.</p></div></div><form class="dispute-form" method="post" action="/disputes/<%= dispute.id %>/evidence" enctype="multipart/form-data"><div class="dispute-field"><label for="evidence">Upload evidence</label><input id="evidence" name="evidence" type="file" accept=".pdf,.doc,.docx,.txt,.jpg,.jpeg,.png" required /></div><div class="dispute-field"><label for="evidenceType">Evidence type</label><select id="evidenceType" name="evidenceType"><option value="document">Document</option><option value="image">Image</option><option value="communication_log">Communication log</option><option value="transaction_history">Transaction history</option></select></div><button class="dispute-button" type="submit">Submit evidence</button></form><% if (evidence.length) { %><ul class="dispute-evidence"><% evidence.forEach(function(item) { %><li><span><%= item.fileName || item.evidenceType %> · <%= item.evidenceType %></span><a href="/disputes/<%= dispute.id %>/evidence/<%= item.id %>">Download</a></li><% }) %></ul><% } else { %><p class="dispute-help">No evidence has been submitted yet.</p><% } %></section><% if (isModerator) { %><section class="dispute-panel dispute-panel--wide"><div class="dispute-panel__header"><div><h2>Resolution workspace</h2><p>Moderation actions are recorded in the case audit trail.</p></div></div><div class="dispute-moderator-grid"><form class="dispute-actions" method="post" action="/disputes/<%= dispute.id %>/assign"><button class="dispute-button dispute-button--quiet" type="submit">Assign to me</button></form><form class="dispute-actions" method="post" action="/disputes/<%= dispute.id %>/mediate"><button class="dispute-button dispute-button--quiet" type="submit">Start mediation</button></form><a class="dispute-button dispute-button--quiet" href="/messages">Open messaging workspace</a><form class="dispute-form" method="post" action="/disputes/<%= dispute.id %>/resolve"><div class="dispute-form__grid"><div class="dispute-field"><label for="resolutionType">Resolution</label><select id="resolutionType" name="resolutionType"><% resolutionTypes.forEach(function(type) { %><option value="<%= type %>"><%= type.replace(/_/g, ' ') %></option><% }) %></select></div><div class="dispute-field"><label for="resolutionDetails">Decision details</label><input id="resolutionDetails" name="resolutionDetails" type="text" required /></div></div><button class="dispute-button" type="submit">Record resolution</button></form><% if (dispute.status === 'resolved') { %><form method="post" action="/disputes/<%= dispute.id %>/close"><button class="dispute-button dispute-button--secondary" type="submit">Close case</button></form><% } %></div></section><% } %></div></div>
