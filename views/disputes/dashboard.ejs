<!-- Chapter 24 dispute history dashboard for parties and moderators. -->
<div class="dispute-shell"><section class="dispute-hero"><div><p class="dispute-kicker">Chapter 24 / Trust protection</p><h1>Dispute resolution</h1><p>Raise, review, and resolve transaction conflicts with a transparent evidence trail.</p></div><a class="dispute-button" href="/disputes/create">Raise a dispute</a></section><% if (message) { %><div class="dispute-notice"><%= message %></div><% } %><section class="dispute-panel"><div class="dispute-panel__header"><div><h2>Dispute history</h2><p>Cases visible to your account and authorized moderation staff.</p></div></div><% if (disputes.length) { %><ul class="dispute-list"><% disputes.forEach(function(dispute) { %><li class="dispute-list__item"><h3><a href="/disputes/<%= dispute.id %>"><%= dispute.reference %></a></h3><p class="dispute-meta"><span><%= dispute.orderId ? 'Order ' + dispute.orderId : 'Contract ' + dispute.contractId %></span><span>Raised by <%= dispute.raisedBy %></span><span class="dispute-status dispute-status--<%= dispute.status %>"><%= dispute.status.replace(/_/g, ' ') %></span></p><p class="dispute-meta"><span><%= dispute.issueDescription %></span></p></li><% }) %></ul><% } else { %><p class="dispute-help">No disputes are associated with your account yet.</p><% } %></section></div>
