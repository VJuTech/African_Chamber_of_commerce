<!-- Chapter 24 dispute creation form linked to an order or contract. -->
<div class="dispute-shell"><section class="dispute-hero"><div><p class="dispute-kicker">Chapter 24 / New case</p><h1>Raise a dispute</h1><p>Provide a factual description so the parties and resolution team can review the issue fairly.</p></div><a class="dispute-button dispute-button--secondary" href="/disputes">Back to disputes</a></section><section class="dispute-panel"><form class="dispute-form" method="post" action="/disputes/create"><div class="dispute-form__grid"><div class="dispute-field"><label for="orderId">Order ID</label><input id="orderId" name="orderId" type="number" value="<%= orderId %>" placeholder="Use an order or contract" /></div><div class="dispute-field"><label for="contractId">Contract ID</label><input id="contractId" name="contractId" type="number" value="<%= contractId %>" placeholder="Use an order or contract" /></div><div class="dispute-field dispute-field--full"><label for="issueDescription">Issue description</label><textarea id="issueDescription" name="issueDescription" required placeholder="Explain what happened, what outcome you are seeking, and relevant dates."></textarea></div></div><div class="dispute-actions"><button class="dispute-button" type="submit">Submit dispute</button><a class="dispute-button dispute-button--quiet" href="/disputes">Cancel</a></div></form></section></div>
