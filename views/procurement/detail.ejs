<!-- Chapter 22 request detail, supplier quotation, and buyer evaluation page. -->
<div class="procurement-shell">
  <section class="procurement-hero"><div><p class="procurement-kicker"><%= rfq.reference %> / <%= rfq.visibility %> sourcing</p><h1><%= rfq.title %></h1><p><%= rfq.description %></p></div><a class="procurement-button procurement-button--secondary" href="/procurement">Back to procurement</a></section>
  <% if (message) { %><div class="procurement-notice"><%= message %></div><% } %>
  <div class="procurement-detail">
    <section class="procurement-panel"><div class="procurement-panel__header"><div><h2>Request details</h2><p>Transparent requirements for every participating business.</p></div><span class="procurement-status procurement-status--<%= rfq.status %>"><%= rfq.status.replace(/_/g, ' ') %></span></div><dl class="procurement-detail__summary"><div><dt>Category</dt><dd><%= rfq.category %></dd></div><div><dt>Quantity / scope</dt><dd><%= rfq.quantityRequired %> <%= rfq.unitOfMeasurement %></dd></div><div><dt>Budget</dt><dd><%= rfq.budgetAmount === null ? 'Not disclosed' : rfq.budgetCurrency + ' ' + rfq.budgetAmount.toFixed(2) %></dd></div><div><dt>Bid deadline</dt><dd><%= rfq.deadline %></dd></div><div><dt>Delivery location</dt><dd><%= rfq.deliveryLocation || 'To be agreed' %></dd></div></dl><div class="procurement-actions"><a class="procurement-button procurement-button--quiet" href="/messages">Discuss with participants</a><% if (isBuyer && rfq.status === 'draft') { %><form method="post" action="/procurement/<%= rfq.id %>/publish"><button class="procurement-button" type="submit">Publish request</button></form><% } %><% if (isBuyer && ['open', 'under_evaluation'].includes(rfq.status)) { %><form method="post" action="/procurement/<%= rfq.id %>/close"><button class="procurement-button procurement-button--secondary" type="submit">Close request</button></form><% } %></div></section>
    <% if (!isBuyer && ['open', 'under_evaluation'].includes(rfq.status)) { %><section class="procurement-panel"><div class="procurement-panel__header"><div><h2>Submit quotation</h2><p>Provide a clear commercial offer and delivery commitment.</p></div></div><form class="procurement-form" method="post" action="/procurement/<%= rfq.id %>/bids"><div class="procurement-field"><label for="quotedPrice">Proposed price</label><input id="quotedPrice" name="quotedPrice" type="number" min="0.01" step="0.01" required /></div><div class="procurement-field"><label for="currency">Currency</label><input id="currency" name="currency" type="text" value="<%= rfq.budgetCurrency %>" maxlength="10" /></div><div class="procurement-field"><label for="deliveryTimeframe">Delivery timeline</label><input id="deliveryTimeframe" name="deliveryTimeframe" type="text" required placeholder="e.g. 21 days after award" /></div><div class="procurement-field"><label for="termsConditions">Terms and conditions</label><textarea id="termsConditions" name="termsConditions" required></textarea></div><button class="procurement-button" type="submit">Submit quotation</button></form><form method="post" action="/messages/start"><input type="hidden" name="targetId" value="<%= rfq.buyerId %>" /><input type="hidden" name="subject" value="Procurement discussion: <%= rfq.title %>" /><input type="hidden" name="type" value="procurement" /><button class="procurement-button procurement-button--quiet" type="submit">Message buyer</button></form></section><% } %>
    <% if (isBuyer) { %><section class="procurement-panel"><div class="procurement-panel__header"><div><h2>Quotation evaluation</h2><p>Compare offers and record the preferred supplier.</p></div></div><% if (quotations.length) { %><% quotations.forEach(function(quote) { %><article class="procurement-quotation"><div class="procurement-quotation__details"><strong><%= quote.reference %></strong><p>Supplier ID <%= quote.supplierId %> · <%= quote.currency %> <%= quote.quotedPrice.toFixed(2) %> · <%= quote.deliveryTimeframe || 'Timeline not provided' %></p><p><%= quote.termsConditions || 'No additional terms provided.' %></p></div><div class="procurement-actions"><form method="post" action="/messages/start"><input type="hidden" name="targetId" value="<%= quote.supplierId %>" /><input type="hidden" name="subject" value="Procurement discussion: <%= rfq.title %>" /><input type="hidden" name="type" value="procurement" /><button class="procurement-button procurement-button--quiet" type="submit">Message supplier</button></form><% if (rfq.status === 'under_evaluation' && quote.status === 'pending') { %><form method="post" action="/procurement/<%= rfq.id %>/award"><input type="hidden" name="quotationId" value="<%= quote.id %>" /><button class="procurement-button" type="submit">Award supplier</button></form><% } else { %><span class="procurement-status"><%= quote.status %></span><% } %></div></article><% }) %><% } else { %><p class="procurement-help">No quotations have been submitted yet.</p><% } %></section><% } %>
  </div>
</div>
