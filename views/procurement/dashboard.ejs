<!-- Chapter 22 buyer and supplier workspace dashboard. -->
<div class="procurement-shell">
  <section class="procurement-hero"><div><p class="procurement-kicker">Chapter 22 / Enterprise trade engine</p><h1>Procurement &amp; B2B sourcing</h1><p>Source at scale, compare supplier quotations, and move awarded work into payment and delivery.</p></div><a class="procurement-button" href="/procurement/create">Create request</a></section>
  <% if (message) { %><div class="procurement-notice"><%= message %></div><% } %>
  <div class="procurement-grid">
    <section class="procurement-panel procurement-panel--wide"><div class="procurement-panel__header"><div><h2>My procurement requests</h2><p>Draft, publish, evaluate, and close your sourcing events.</p></div></div><% if (buyerRequests.length) { %><ul class="procurement-list"><% buyerRequests.forEach(function(rfq) { %><li class="procurement-list__item"><h3><a href="/procurement/<%= rfq.id %>"><%= rfq.title %></a></h3><p class="procurement-meta"><span><%= rfq.reference %></span><span><%= rfq.quantityRequired %> <%= rfq.unitOfMeasurement %></span><span>Due <%= rfq.deadline %></span><span class="procurement-status procurement-status--<%= rfq.status %>"><%= rfq.status.replace(/_/g, ' ') %></span></p></li><% }) %></ul><% } else { %><p class="procurement-help">You have not created a procurement request yet.</p><% } %></section>
    <section class="procurement-panel"><div class="procurement-panel__header"><div><h2>Available requests</h2><p>Open opportunities matched to your supplier access.</p></div></div><% if (availableRequests.length) { %><ul class="procurement-list"><% availableRequests.forEach(function(rfq) { %><li class="procurement-list__item"><h3><a href="/procurement/<%= rfq.id %>"><%= rfq.title %></a></h3><p class="procurement-meta"><span><%= rfq.category %></span><span>Due <%= rfq.deadline %></span></p></li><% }) %></ul><% } else { %><p class="procurement-help">No open requests are currently available.</p><% } %></section>
    <section class="procurement-panel"><div class="procurement-panel__header"><div><h2>My quotations</h2><p>Track responses submitted to buyers.</p></div></div><% if (supplierBids.length) { %><ul class="procurement-list"><% supplierBids.forEach(function(bid) { %><li class="procurement-list__item"><h3>Quotation <%= bid.reference %></h3><p class="procurement-meta"><span><%= bid.currency %> <%= bid.quotedPrice.toFixed(2) %></span><span class="procurement-status"><%= bid.status %></span></p><a href="/procurement/<%= bid.rfqId %>">View request</a></li><% }) %></ul><% } else { %><p class="procurement-help">Your submitted quotations will appear here.</p><% } %></section>
    <section class="procurement-panel procurement-panel--wide"><div class="procurement-panel__header"><div><h2>Awarded procurement orders</h2><p>Continue with Chapter 19 payment, Chapter 21 logistics, and Chapter 23 contracts.</p></div></div><% if (orders.length) { %><ul class="procurement-list"><% orders.forEach(function(order) { %><li class="procurement-list__item"><h3><%= order.reference %></h3><p class="procurement-meta"><span><%= order.currency %> <%= order.orderAmount.toFixed(2) %></span><span>Payment: <%= order.paymentStatus %></span><span>Delivery: <%= order.deliveryStatus %></span></p><div class="procurement-actions"><a class="procurement-button procurement-button--quiet" href="<%= order.contractPath %>">Create contract</a><a class="procurement-button procurement-button--quiet" href="<%= order.paymentPath %>">Open payments</a><a class="procurement-button procurement-button--quiet" href="<%= order.logisticsPath %>">Open logistics</a></div></li><% }) %></ul><% } else { %><p class="procurement-help">Awards and fulfillment hand-offs will appear here.</p><% } %></section>
  </div>
</div>
