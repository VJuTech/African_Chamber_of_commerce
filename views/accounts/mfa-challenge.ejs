<main class="security-page security-page--narrow">
  <section class="security-panel">
    <p class="security-eyebrow">Secure sign-in</p>
    <h1>Verify your sign-in</h1>
    <p><%= message %></p>
    <% if (error) { %><div class="security-alert security-alert--error"><%= error %></div><% } %>
    <form method="post" action="/mfa/challenge" class="security-form">
      <label for="code">Verification code</label>
      <input id="code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" minlength="6" maxlength="6" required />
      <button type="submit" class="primary-btn">Verify and continue</button>
    </form>
    <a class="security-back-link" href="/login">Return to sign in</a>
  </section>
</main>
