<!-- Registration form template for new users. -->
<div class="auth-shell">
  <div class="auth-card">
    <div class="auth-header">
      <span class="eyebrow">African Chamber of Commerce</span>
      <h2>Create your account</h2>
      <p>Join ACC and start building trusted business connections.</p>
    </div>

    <% if (error) { %>
      <div class="message error"><%= error %></div>
    <% } %>
    <% if (success) { %>
      <div class="message success"><%= success %></div>
    <% } %>

    <form method="post" action="/register" class="auth-form">
      <div class="form-section">
        <h3>Personal details</h3>
        <div class="form-grid">
          <div class="field-group">
            <label for="firstName">First name</label>
            <input id="firstName" name="firstName" type="text" value="<%= formData && formData.firstName ? formData.firstName : '' %>" required aria-required="true" maxlength="100" />
          </div>
          <div class="field-group">
            <label for="lastName">Last name</label>
            <input id="lastName" name="lastName" type="text" value="<%= formData && formData.lastName ? formData.lastName : '' %>" required aria-required="true" maxlength="100" />
          </div>
          <div class="field-group">
            <label for="middleName">Middle name (optional)</label>
            <input id="middleName" name="middleName" type="text" value="<%= formData && formData.middleName ? formData.middleName : '' %>" maxlength="100" />
          </div>
          <div class="field-group">
            <label for="email">Email address</label>
            <input id="email" name="email" type="email" value="<%= formData && formData.email ? formData.email : '' %>" required aria-required="true" maxlength="255" />
          </div>
          <div class="field-group">
            <label for="phone">Mobile number</label>
            <input id="phone" name="phone" type="tel" inputmode="tel" value="<%= formData && formData.phone ? formData.phone : '' %>" pattern="[0-9+\-()\s]{7,20}" required aria-required="true" placeholder="e.g. +2348123456789" title="Enter a valid phone number" />
          </div>
          <div class="field-group">
            <label for="country">Country</label>
            <div class="account-country-picker" data-account-country-picker>
              <input id="country" name="country" type="hidden" value="<%= formData && formData.country ? formData.country : '' %>" required aria-required="true" />
              <button type="button" class="account-country-picker__trigger" aria-haspopup="listbox" aria-expanded="false">
                <span class="account-country-picker__selected"><span class="account-country-picker__placeholder">Select your country</span></span>
              </button>
              <div class="account-country-picker__menu" role="listbox" aria-label="Country">
                <% (africanCountries || []).forEach((country) => { %>
                  <button type="button" class="account-country-picker__option" role="option" data-value="<%= country.name %>" data-label="<%= country.name %>" data-flag="<%= country.flagUrl %>">
                    <img src="<%= country.flagUrl %>" alt="" width="24" height="16" loading="lazy" />
                    <span><%= country.name %></span>
                  </button>
                <% }) %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="form-section">
        <h3>Account details</h3>
        <div class="form-grid">
          <div class="field-group">
            <label for="preferredLanguage">Preferred language (optional)</label>
            <select id="preferredLanguage" name="preferredLanguage">
              <option value="">Select a language</option>
              <option value="English" <%= formData && formData.preferredLanguage === 'English' ? 'selected' : '' %>>English</option>
              <option value="French" <%= formData && formData.preferredLanguage === 'French' ? 'selected' : '' %>>French</option>
              <option value="Arabic" <%= formData && formData.preferredLanguage === 'Arabic' ? 'selected' : '' %>>Arabic</option>
              <option value="Portuguese" <%= formData && formData.preferredLanguage === 'Portuguese' ? 'selected' : '' %>>Portuguese</option>
            </select>
          </div>
          <div class="field-group">
            <label for="organizationName">Organization name (optional)</label>
            <input id="organizationName" name="organizationName" type="text" value="<%= formData && formData.organizationName ? formData.organizationName : '' %>" maxlength="200" />
          </div>
          <div class="field-group">
            <label for="referralCode">Referral code (optional)</label>
            <input id="referralCode" name="referralCode" type="text" value="<%= formData && formData.referralCode ? formData.referralCode : '' %>" maxlength="80" />
          </div>
          <div class="field-group">
            <label for="role">Role</label>
            <select id="role" name="role" required aria-required="true">
              <option value="">Select a role</option>
              <option value="member" selected>Member</option>
            </select>
          </div>
          <div class="field-group">
            <label for="password">Password</label>
            <div class="password-input-wrapper">
              <input id="password" name="password" type="password" required aria-required="true" minlength="8" />
              <button type="button" class="password-toggle-btn" data-target="password" title="Toggle password visibility">
                <svg class="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </button>
            </div>
            <div class="password-requirements">
              <p class="requirements-title">Password requirements:</p>
              <ul class="requirement-list">
                <li data-requirement="length">At least 8 characters</li>
                <li data-requirement="uppercase">One uppercase letter (A-Z)</li>
                <li data-requirement="lowercase">One lowercase letter (a-z)</li>
                <li data-requirement="number">One number (0-9)</li>
                <li data-requirement="special">One special character (!@#$%^&*)</li>
              </ul>
            </div>
          </div>
          <div class="field-group">
            <label for="password2">Confirm password</label>
            <div class="password-input-wrapper">
              <input id="password2" name="password2" type="password" required aria-required="true" minlength="8" />
              <button type="button" class="password-toggle-btn" data-target="password2" title="Toggle password visibility">
                <svg class="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>

      <div class="consent-block">
        <label class="check-option">
          <input type="checkbox" name="acceptTerms" value="true" required />
          <span>I accept the Terms of Service.</span>
        </label>
        <label class="check-option">
          <input type="checkbox" name="acceptPrivacy" value="true" required />
          <span>I accept the Privacy Policy.</span>
        </label>
      </div>

      <p class="helper-text">Password must contain at least 8 characters, including uppercase, lowercase, a number, and a special character.</p>

      <button type="submit" class="primary-btn">Create account</button>
    </form>

    <p class="switch-link">Already have an account? <a href="/login">Sign in</a>.</p>
  </div>
</div>

<script>
  document.querySelectorAll('[data-account-country-picker]').forEach(function (picker) {
    const input = picker.querySelector('input[type="hidden"]');
    const trigger = picker.querySelector('.account-country-picker__trigger');
    const selected = picker.querySelector('.account-country-picker__selected');
    const options = picker.querySelectorAll('.account-country-picker__option');

    function showSelected(option) {
      selected.innerHTML = '<img src="' + option.dataset.flag + '" alt="" width="24" height="16" />' +
        '<span>' + option.dataset.label + '</span>';
    }

    options.forEach(function (option) {
      if (option.dataset.value === input.value) showSelected(option);
      option.addEventListener('click', function () {
        input.value = option.dataset.value;
        showSelected(option);
        picker.classList.remove('is-open');
        trigger.setAttribute('aria-expanded', 'false');
      });
    });

    trigger.addEventListener('click', function () {
      const isOpen = picker.classList.toggle('is-open');
      trigger.setAttribute('aria-expanded', String(isOpen));
    });
  });

  document.addEventListener('click', function (event) {
    document.querySelectorAll('[data-account-country-picker].is-open').forEach(function (picker) {
      if (!picker.contains(event.target)) {
        picker.classList.remove('is-open');
        picker.querySelector('.account-country-picker__trigger').setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>
