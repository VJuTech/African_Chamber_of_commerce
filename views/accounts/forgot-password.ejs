<div class="auth-shell">
  <div class="auth-card auth-card--narrow">
    <div class="auth-header">
      <span class="eyebrow">African Chamber of Commerce</span>
      <h2>Reset your password</h2>
      <p>Enter the email linked to your account and we will guide you through a secure password reset.</p>
    </div>

    <% if (message) { %>
      <div class="message success"><%= message %></div>
    <% } %>
    <% if (error) { %>
      <div class="message error"><%= error %></div>
    <% } %>

    <form method="post" action="/forgot-password" class="auth-form">
      <div class="form-section">
        <div class="field-group">
          <label for="email">Email address</label>
          <input id="email" name="email" type="email" placeholder="you@example.com" required />
        </div>
      </div>

      <p class="form-note">For security, the reset link expires after 30 minutes. In this build, the reset link is generated and displayed so you can test the flow locally.</p>

      <% if (showResetLink && resetUrl) { %>
        <div class="reset-link-banner">
          <strong>Reset link:</strong><br />
          <a class="inline-link" href="<%= resetUrl %>"><%= resetUrl %></a>
        </div>
      <% } %>

      <button type="submit" class="primary-btn">Send reset instructions</button>
    </form>

    <div class="auth-actions">
      <a class="inline-link" href="/login">Back to sign in</a>
    </div>
  </div>
</div>
