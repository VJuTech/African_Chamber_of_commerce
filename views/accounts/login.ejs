<!-- Login form template for existing users. -->
<div class="card">
  <h2>Sign in</h2>
  <!-- Display any success message passed from the controller. -->
  <% if (message) { %>
    <div class="message success"><%= message %></div>
  <% } %>
  <!-- Display validation or authentication errors. -->
  <% if (error) { %>
    <div class="message error"><%= error %></div>
  <% } %>

  <form method="post" action="/login">
    <label for="identifier">Email or mobile number</label>
    <input id="identifier" name="identifier" type="text" required />

    <label for="password">Password</label>
    <input id="password" name="password" type="password" required />

    <label class="checkbox">
      <input name="rememberMe" type="checkbox" value="true" />
      Remember me for 7 days
    </label>

    <button type="submit">Sign In</button>
  </form>

  <p class="muted">No account yet? <a href="/register">Create one</a>.</p>
</div>
