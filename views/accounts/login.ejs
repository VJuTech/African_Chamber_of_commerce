<!-- Login form template for existing users. -->
<div class="auth-shell">
  <div class="auth-card" style="max-width: 500px;">
    <div class="auth-header">
      <span class="eyebrow">African Chamber of Commerce</span>
      <h2>Welcome back</h2>
      <p>Sign in to continue to your account.</p>
    </div>

    <% if (message) { %>
      <div class="message success"><%= message %></div>
    <% } %>
    <% if (error) { %>
      <div class="message error"><%= error %></div>
    <% } %>

    <form method="post" action="/login" class="auth-form">
      <div class="form-section">
        <div class="field-group">
          <label for="identifier">Email or mobile number</label>
          <input id="identifier" name="identifier" type="text" required />
        </div>

        <div class="field-group">
          <label for="password">Password</label>
          <div class="password-input-wrapper">
            <input id="password" name="password" type="password" required />
            <button type="button" class="password-toggle-btn" data-target="password" title="Toggle password visibility">
              <svg class="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <label class="check-option">
        <input name="rememberMe" type="checkbox" value="true" />
        <span>Remember me for 7 days</span>
      </label>

      <button type="submit" class="primary-btn">Sign In</button>
    </form>

    <p class="switch-link">No account yet? <a href="/register">Create one</a>.</p>
  </div>
</div>
