<main class="support-page">
  <header class="support-hero"><div><p class="support-kicker">ACC support</p><h1>Help center</h1><p>Find practical answers, guides, and a direct path to the support team.</p></div><a class="support-button" href="/support/report">Report an issue <span aria-hidden="true">&rarr;</span></a></header>
  <% if (message) { %><p class="support-feedback"><%= message %></p><% } %>
  <section class="support-section" aria-labelledby="help-articles-title"><div class="support-section__heading"><div><p class="support-kicker">Self-service</p><h2 id="help-articles-title">Guides and answers</h2></div><span><%= articles.length %> published resources</span></div><div class="support-article-grid"><% articles.forEach((article) => { %><article class="support-article"><span><%= article.articleType %></span><h3><%= article.title %></h3><p><%= article.summary %></p><div class="support-article__body"><%= article.body %></div></article><% }); %><% if (!articles.length) { %><p class="support-empty">The support team is preparing the first help resources.</p><% } %></div></section>
  <% if (user) { %><section class="support-section" aria-labelledby="support-tickets-title"><div class="support-section__heading"><div><p class="support-kicker">Your support</p><h2 id="support-tickets-title">Recent tickets</h2></div><span><%= tickets.length %> tickets</span></div><div class="support-ticket-list"><% tickets.forEach((ticket) => { %><div class="support-ticket-row"><div><strong><%= ticket.ticketNumber %> &middot; <%= ticket.title %></strong><small><%= ticket.category %> &middot; <%= ticket.priority %></small></div><span class="support-status support-status--<%= ticket.status %>"><%= ticket.status.replace('_', ' ') %></span></div><% }); %><% if (!tickets.length) { %><p class="support-empty">No tickets yet.</p><% } %></div></section><% } %>
</main>
