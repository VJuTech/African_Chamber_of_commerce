<!-- Landing page section for the ACC public homepage. -->
<section class="landing-page">
  <!-- Hero section introduces the platform value proposition. -->
  <section class="hero">
    <div class="hero__content">
      <p class="eyebrow">Connect. Grow. Trade. Lead.</p>
      <h1>Build trusted business relationships across Africa.</h1>
      <p class="hero__text">
        The African Chamber of Commerce helps businesses discover opportunities,
        connect with verified partners, and expand into new markets with confidence.
      </p>

      <div class="hero__actions">
        <a class="button button--primary" href="/register">Join the chamber</a>
        <a class="button button--secondary" href="/directory">Explore directory</a>
      </div>

      <div class="hero__metrics" aria-label="Key platform metrics">
        <div class="metric">
          <strong>12k+</strong>
          <span>Businesses</span>
        </div>
        <div class="metric">
          <strong>38</strong>
          <span>Countries</span>
        </div>
        <div class="metric">
          <strong>4.9/5</strong>
          <span>Member rating</span>
        </div>
      </div>
    </div>

    <div class="hero__visual" aria-label="Business network illustration">
      <div class="visual-card visual-card--main">
        <span class="badge badge--success">Verified network</span>
        <h3>Regional trade growth</h3>
        <div class="network-map">
          <span class="node node--one">Lagos</span>
          <span class="node node--two">Nairobi</span>
          <span class="node node--three">Accra</span>
          <span class="node node--four">Cairo</span>
        </div>
      </div>
      <div class="visual-card visual-card--floating">
        <p>Pipeline growth</p>
        <strong>+48.2%</strong>
      </div>
    </div>
  </section>

  <!-- Trust section highlights the value of verified memberships and community. -->
  <section class="trust-strip" aria-label="Chamber trust indicators">
    <div class="trust-item">
      <span class="trust-item__icon">✓</span>
      <div>
        <strong>Verified members</strong>
        <small>Trusted by business leaders</small>
      </div>
    </div>
    <div class="trust-item">
      <span class="trust-item__icon">⇄</span>
      <div>
        <strong>Active networking</strong>
        <small>Partnership opportunities</small>
      </div>
    </div>
    <div class="trust-item">
      <span class="trust-item__icon">◎</span>
      <div>
        <strong>Market access</strong>
        <small>Regional insight and sourcing</small>
      </div>
    </div>
  </section>

  <!-- Feature section explains the core platform capabilities. -->
  <section class="features">
    <div class="section-heading">
      <p class="eyebrow">Why ACC</p>
      <h2>Everything a growing business needs in one ecosystem.</h2>
    </div>

    <div class="features__grid">
      <article class="feature-card">
        <div class="feature-icon">🏢</div>
        <h3>Business directory</h3>
        <p>Discover verified companies by industry, country, and region.</p>
      </article>

      <article class="feature-card">
        <div class="feature-icon">🤝</div>
        <h3>Smart networking</h3>
        <p>Build relationships with suppliers, clients, partners, and investors.</p>
      </article>

      <article class="feature-card">
        <div class="feature-icon">📈</div>
        <h3>Growth support</h3>
        <p>Access platform opportunities, market intelligence, and visibility tools.</p>
      </article>
    </div>
  </section>

  <!-- Opportunity section showcases member categories and trade benefits. -->
  <section class="opportunity">
    <div class="section-heading section-heading--left">
      <p class="eyebrow">Business opportunities</p>
      <h2>Built for partnerships, procurement, and scale.</h2>
    </div>

    <div class="opportunity__list">
      <div class="opportunity__item">
        <span>01</span>
        <div>
          <h3>Find the right partners</h3>
          <p>Match with businesses aligned to your industry, growth stage, and market focus.</p>
        </div>
      </div>

      <div class="opportunity__item">
        <span>02</span>
        <div>
          <h3>Trade with confidence</h3>
          <p>Reduce uncertainty with verified profiles, rich business details, and structured trust signals.</p>
        </div>
      </div>

      <div class="opportunity__item">
        <span>03</span>
        <div>
          <h3>Expand regionally</h3>
          <p>Move beyond local markets through cross-border discovery and professional introductions.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Showcase section for categories of industries represented on the platform. -->
  <section class="categories">
    <div class="section-heading">
      <p class="eyebrow">Industries represented</p>
      <h2>From agriculture to finance and logistics.</h2>
    </div>

    <div class="categories__grid">
      <span>Agri-business</span>
      <span>Technology</span>
      <span>Manufacturing</span>
      <span>Logistics</span>
      <span>Construction</span>
      <span>Healthcare</span>
      <span>Finance</span>
      <span>Energy</span>
    </div>
  </section>

  <!-- Testimonial block adds social proof to the landing page. -->
  <section class="testimonials">
    <div class="section-heading">
      <p class="eyebrow">Member voices</p>
      <h2>Trusted by ambitious business leaders.</h2>
    </div>

    <div class="testimonials__grid">
      <blockquote class="quote-card">
        “ACC helped us connect with the right manufacturing partners and created new regional opportunities.”
        <footer>— Ada Okafor, Operations Director</footer>
      </blockquote>

      <blockquote class="quote-card">
        “The directory and networking tools gave our company more visibility than we had in the last three years.”
        <footer>— Daniel Kamau, Founder</footer>
      </blockquote>
    </div>
  </section>

  <!-- Final CTA motivates user registration or directory browsing. -->
  <section class="cta">
    <div>
      <p class="eyebrow">Ready to grow?</p>
      <h2>Join Africa’s business network today.</h2>
    </div>
    <div class="cta__actions">
      <a class="button button--primary" href="/register">Create account</a>
      <a class="button button--secondary" href="/directory">Browse directory</a>
    </div>
  </section>
</section>
