<!-- ACC Chapter 21: shipment detail, status timeline, provider assignment, and delivery confirmation. -->
<section class="logistics-shell">
  <header class="logistics-header logistics-header--compact">
    <div><p class="logistics-eyebrow">Order #<%= order.id %> / shipment control</p><h1><%= shipment ? shipment.id : 'Delivery setup' %></h1><p><%= order.listingTitle %> · <%= order.shippingAddress %></p></div>
    <a class="button button--secondary" href="/logistics">Back to logistics</a>
  </header>
  <% if (message) { %><div class="logistics-alert logistics-alert--success"><%= message %></div><% } %>

  <% if (!shipment) { %>
    <div class="logistics-detail-grid"><section class="logistics-panel"><p class="logistics-kicker">Seller action</p><h2>Create shipment</h2><p class="logistics-muted">Assign a provider and estimated date to generate a shipment ID and unique tracking number.</p>
      <form method="post" action="/logistics/orders/<%= order.id %>/shipments" class="logistics-form">
        <label for="deliveryMethod">Delivery method</label><select id="deliveryMethod" name="deliveryMethod" required><% ['standard','express','pickup','third_party'].forEach((method) => { %><option value="<%= method %>" <%= order.deliveryMethod === method ? 'selected' : '' %>><%= method.replace(/_/g, ' ') %></option><% }); %></select>
        <label for="carrier">Logistics provider</label><select id="carrier" name="carrier" required><% providers.forEach((provider) => { %><option value="<%= provider %>"><%= provider %></option><% }); %></select>
        <label for="estimatedDeliveryDate">Estimated delivery date</label><input id="estimatedDeliveryDate" type="date" name="estimatedDeliveryDate" />
        <button class="button button--primary" type="submit">Create shipment</button>
      </form>
    </section><aside class="logistics-panel logistics-panel--accent"><p class="logistics-kicker">Buyer selection</p><h2>Delivery preference</h2><p>Current method: <strong><%= order.deliveryMethod.replace(/_/g, ' ') %></strong></p><form method="post" action="/logistics/orders/<%= order.id %>/delivery-method" class="logistics-form"><select name="deliveryMethod"><% ['standard','express','pickup','third_party'].forEach((method) => { %><option value="<%= method %>" <%= order.deliveryMethod === method ? 'selected' : '' %>><%= method.replace(/_/g, ' ') %></option><% }); %></select><button class="button button--secondary" type="submit">Save preference</button></form></aside></div>
  <% } else { %>
    <div class="logistics-detail-grid"><section class="logistics-panel logistics-panel--wide"><div class="logistics-detail-topline"><div><p class="logistics-kicker">Tracking number</p><h2><%= shipment.trackingNumber %></h2></div><span class="logistics-status logistics-status--<%= shipment.status %>"><%= shipment.status.replace(/_/g, ' ') %></span></div><div class="logistics-facts"><div><span>Carrier</span><strong><%= shipment.carrier %></strong></div><div><span>Method</span><strong><%= shipment.deliveryMethod.replace(/_/g, ' ') %></strong></div><div><span>Estimated delivery</span><strong><%= shipment.estimatedDeliveryDate || 'To be confirmed' %></strong></div><div><span>Destination</span><strong><%= shipment.deliveryAddress %></strong></div></div><div class="logistics-timeline"><div class="logistics-timeline__step logistics-timeline__step--active"><span></span><strong>Shipment created</strong></div><div class="logistics-timeline__step <%= ['dispatched','in_transit','out_for_delivery','delivered'].includes(shipment.status) ? 'logistics-timeline__step--active' : '' %>"><span></span><strong>Dispatched</strong></div><div class="logistics-timeline__step <%= ['in_transit','out_for_delivery','delivered'].includes(shipment.status) ? 'logistics-timeline__step--active' : '' %>"><span></span><strong>In transit</strong></div><div class="logistics-timeline__step <%= ['out_for_delivery','delivered'].includes(shipment.status) ? 'logistics-timeline__step--active' : '' %>"><span></span><strong>Out for delivery</strong></div><div class="logistics-timeline__step <%= shipment.status === 'delivered' ? 'logistics-timeline__step--active' : '' %>"><span></span><strong>Delivered</strong></div></div></section><aside class="logistics-panel"><p class="logistics-kicker">Operations</p><h2>Update shipment</h2><form method="post" action="/logistics/orders/<%= order.id %>/shipments/<%= shipment.id %>/status" class="logistics-form"><label for="status">Delivery status</label><select id="status" name="status"><% deliveryStatuses.forEach((status) => { %><option value="<%= status %>" <%= shipment.status === status ? 'selected' : '' %>><%= status.replace(/_/g, ' ') %></option><% }); %></select><label for="details">Update note</label><textarea id="details" name="details" rows="3" placeholder="Add a carrier or delivery update"></textarea><button class="button button--primary" type="submit">Save status</button></form><% if (shipment.status === 'delivered' && !shipment.deliveryConfirmedAt) { %><form method="post" action="/logistics/orders/<%= order.id %>/shipments/<%= shipment.id %>/confirm" class="logistics-form logistics-form--confirm"><button class="button button--secondary" type="submit">Confirm receipt</button></form><% } %></aside></div>
  <% } %>
</section>
