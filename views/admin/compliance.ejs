<main class="compliance-page">
  <header class="compliance-hero"><div><p class="compliance-eyebrow">ACC Management</p><h1>Compliance operations</h1><p>Review identity, business, transaction, AML, and audit signals from PostgreSQL.</p></div><a class="compliance-button" href="/admin/dashboard">Management dashboard</a></header>
  <% if (message) { %><p class="compliance-alert"><%= message %></p><% } %>
  <section class="compliance-grid"><article class="compliance-panel"><h2>Pending KYC</h2><p class="compliance-status"><%= summary.pending_kyc %></p></article><article class="compliance-panel"><h2>Business reviews</h2><p class="compliance-status"><%= summary.pending_business %></p></article><article class="compliance-panel"><h2>Open flags</h2><p class="compliance-status"><%= summary.open_flags %></p></article></section>
  <section class="compliance-panel"><h2>KYC review queue</h2><table class="compliance-table"><thead><tr><th>Member</th><th>Risk</th><th>Submitted</th><th>Decision</th></tr></thead><tbody><% data.kyc.forEach((item) => { %><tr><td><%= item.email %></td><td><%= item.riskLevel %></td><td><%= formatDate(item.submittedAt) %></td><td><form action="/admin/compliance/kyc/<%= item.id %>" method="post"><select name="status"><option value="under_review">Under review</option><option value="needs_information">Needs information</option><option value="approved">Approve</option><option value="rejected">Reject</option></select><input name="notes" placeholder="Decision notes" /><button class="compliance-button" type="submit">Record</button></form></td></tr><% }) %></tbody></table></section>
  <section class="compliance-panel"><h2>Active AML restrictions</h2><table class="compliance-table"><thead><tr><th>User</th><th>Business</th><th>Reason</th><th>Created</th></tr></thead><tbody><% data.restrictions.forEach((item) => { %><tr><td><%= item.userId || '—' %></td><td><%= item.businessId || '—' %></td><td><%= item.reason %></td><td><%= formatDate(item.createdAt) %></td></tr><% }) %></tbody></table></section>
  <section class="compliance-panel"><h2>Recent compliance audit</h2><table class="compliance-table"><thead><tr><th>Event</th><th>Entity</th><th>Outcome</th><th>Created</th></tr></thead><tbody><% data.audit.forEach((item) => { %><tr><td><%= item.eventType %></td><td><%= item.entityType || '—' %></td><td><%= item.outcome %></td><td><%= formatDate(item.createdAt) %></td></tr><% }) %></tbody></table></section>
</main>