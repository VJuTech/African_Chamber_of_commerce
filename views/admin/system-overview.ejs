<section class="system-overview-page">
  <header class="system-overview-hero"><div><p class="eyebrow">Chapter 2 / Platform perspective</p><h1>System overview</h1><p>See how ACC connects people, businesses, trade workflows, PostgreSQL, and external services in one operating model.</p></div><div class="system-overview-hero__mark"><strong>ACC</strong><span>Cloud commerce platform</span></div></header>
  <% if (message) { %><div class="system-overview-alert" role="status"><%= message %></div><% } %>
  <section class="system-overview-section"><div class="system-overview-heading"><div><p class="eyebrow">Product perspective</p><h2>Users to trade</h2></div><span class="system-overview-flow">Users → Businesses → Marketplace → Trade → Payments → Analytics</span></div><div class="system-overview-stats"><div><strong><%= counts.users %></strong><span>Users</span></div><div><strong><%= counts.businesses %></strong><span>Businesses</span></div><div><strong><%= counts.listings %></strong><span>Active listings</span></div><div><strong><%= counts.orders %></strong><span>Orders</span></div><div><strong><%= counts.payments %></strong><span>Payments</span></div><div><strong><%= counts.auditEvents %></strong><span>Audit events</span></div></div></section>
  <section class="system-overview-section"><div class="system-overview-heading"><div><p class="eyebrow">Conceptual architecture</p><h2>One connected stack</h2></div><span class="system-overview-note">PostgreSQL remains the system of record.</span></div><div class="system-overview-layers"><% architectureLayers.forEach((layer, index) => { %><div class="system-overview-layer"><span class="system-overview-layer__number">0<%= index + 1 %></span><div><h3><%= layer.label %></h3><p><%= layer.detail %></p></div></div><% }); %></div><p class="system-overview-boundary"><strong>Organization boundary:</strong> business ownership, business relationships, and RBAC currently serve as the primary organization boundary. Dedicated <code>tenant_id</code> isolation across every domain table is a future architecture phase.</p></section>
  <section class="system-overview-section"><div class="system-overview-heading"><div><p class="eyebrow">Constraints and dependencies</p><h2>External service posture</h2></div><span class="system-overview-note"><%= integrations.length %> registered services</span></div><div class="system-overview-integrations"><% integrations.forEach((integration) => { %><article class="system-overview-integration"><div class="system-overview-integration__top"><div><span class="system-overview-type"><%= integration.integrationType %></span><h3><%= integration.displayName %></h3><p><%= integration.provider %> · <%= integration.environment %></p></div><span class="system-overview-status system-overview-status--<%= integration.status %>"><%= integration.status.replace('_', ' ') %></span></div><p><%= integration.notes || 'No operational notes recorded.' %></p><form method="post" action="/admin/system-overview/integrations/<%= integration.id %>" class="system-overview-form"><select name="status" aria-label="Status for <%= integration.displayName %>"><% ['configured','healthy','degraded','unavailable','not_configured'].forEach((status) => { %><option value="<%= status %>" <%= integration.status === status ? 'selected' : '' %>><%= status.replace('_', ' ') %></option><% }); %></select><input name="notes" value="<%= integration.notes || '' %>" maxlength="2000" aria-label="Notes for <%= integration.displayName %>" /><button class="button button--primary" type="submit">Update</button></form></article><% }); %></div></section>
  <section class="system-overview-section system-overview-users"><div class="system-overview-heading"><div><p class="eyebrow">User classes</p><h2>Designed for the whole ecosystem</h2></div></div><div class="system-overview-class-grid"><div><strong>Primary users</strong><span>Individuals, business owners, and entrepreneurs.</span></div><div><strong>Secondary users</strong><span>Corporate organizations, suppliers, and vendors.</span></div><div><strong>Administrative users</strong><span>Platform administrators, moderators, and compliance officers.</span></div><div><strong>Operating environment</strong><span>Chrome, Edge, Safari, Android, iOS, and cloud hosting.</span></div></div></section>
</section>
