<section class="admin-page"><header class="admin-page__heading"><div><p class="admin-eyebrow">Administration / configuration</p><h1>System settings</h1><p>Manage durable platform configuration and module availability.</p></div></header><div class="admin-settings-grid"><section class="admin-panel"><div class="admin-panel__heading"><h2>Platform settings</h2></div><div class="admin-setting-list"><% settings.forEach((setting) => { %><form class="admin-setting" method="post" action="/admin/settings/<%= setting.setting_key %>"><div><strong><%= setting.setting_key %></strong><small><%= setting.description %></small></div><input name="value" value='<%= JSON.stringify(setting.setting_value) %>' aria-label="Value for <%= setting.setting_key %>" required><button type="submit">Save</button></form><% }); %></div></section><section class="admin-panel"><div class="admin-panel__heading"><h2>Feature availability</h2></div><div class="admin-setting-list"><% flags.forEach((flag) => { %><form class="admin-setting" method="post" action="/admin/features/<%= flag.feature_key %>"><div><strong><%= flag.display_name %></strong><small><%= flag.description %></small></div><select name="enabled" aria-label="Availability for <%= flag.display_name %>"><option value="true" <%= flag.enabled ? 'selected' : '' %>>Enabled</option><option value="false" <%= !flag.enabled ? 'selected' : '' %>>Disabled</option></select><button type="submit">Save</button></form><% }); %></div></section></div></section>
