<main class="ai-page"><section class="ai-hero"><div><p class="ai-eyebrow">ACC control room / intelligence</p><h1>AI &amp; recommendation system</h1><p>Review explainable recommendations, search quality, fraud risk, forecasts, privacy signals, and model health from one governed surface.</p></div><span class="ai-live"><i></i>Operational monitoring</span></section><% if (message) { %><p class="ai-notice"><%= message %></p><% } %><section class="ai-cards" style="margin:24px 0"><article class="ai-card"><small>Interactions, 30 days</small><h2><%= metrics.interactions %></h2></article><article class="ai-card"><small>Recommendations generated</small><h2><%= metrics.recommendations %></h2></article><article class="ai-card"><small>Positive feedback</small><h2><%= metrics.positiveFeedback %></h2></article><article class="ai-card"><small>Searches, 30 days</small><h2><%= metrics.searches %></h2></article><article class="ai-card"><small>Open fraud cases</small><h2><%= metrics.openCases %></h2></article><article class="ai-card"><small>Unread AI alerts</small><h2><%= metrics.unreadAlerts %></h2></article></section><div class="ai-grid"><section class="ai-panel ai-panel--wide"><div class="ai-panel__head"><div><p class="ai-eyebrow">Risk operations</p><h2>Fraud cases</h2></div><form class="ai-form" style="display:flex;flex-direction:row" action="/admin/ai/evaluate-fraud" method="post"><input name="orderId" type="number" min="1" placeholder="Order ID"><button type="submit">Evaluate order</button></form></div><div class="ai-table-wrap"><table class="ai-table"><thead><tr><th>Case</th><th>Subject</th><th>Risk</th><th>Indicators</th><th>Status</th><th>Action</th></tr></thead><tbody><% cases.forEach((item) => { %><tr><td>#<%= item.id %><small><%= item.email || 'Unknown user' %></small></td><td><%= item.subject_type %> <%= item.subject_id || '' %></td><td><span class="ai-pill <%= ['high','critical'].includes(item.risk_level) ? 'ai-pill--risk' : '' %>"><%= item.risk_level %> · <%= item.risk_score %></span></td><td><%= Array.isArray(item.indicators) ? item.indicators.join(', ') : item.indicators %></td><td><span class="ai-status"><%= item.status %></span></td><td><form action="/admin/ai/fraud/<%= item.id %>" method="post"><select name="status"><option value="reviewing">Review</option><option value="confirmed">Confirm</option><option value="dismissed">Dismiss</option><option value="blocked">Block</option></select><button type="submit">Save</button></form></td></tr><% }); %><% if (!cases.length) { %><tr><td colspan="6" class="ai-empty">No fraud cases require review.</td></tr><% } %></tbody></table></div></section><section class="ai-panel"><div class="ai-panel__head"><div><p class="ai-eyebrow">Timely signals</p><h2>AI alerts</h2></div></div><div class="ai-patterns"><% alerts.slice(0,12).forEach((item) => { %><div class="ai-pattern"><span><strong><%= item.title %></strong><small><%= item.message %></small></span><form action="/admin/ai/alerts/<%= item.id %>" method="post"><input type="hidden" name="status" value="acknowledged"><button type="submit">Acknowledge</button></form></div><% }); %><% if (!alerts.length) { %><p class="ai-empty">No AI alerts have been generated.</p><% } %></div></section><section class="ai-panel"><div class="ai-panel__head"><div><p class="ai-eyebrow">Model health</p><h2>Performance</h2></div></div><div class="ai-patterns"><% models.forEach((model) => { %><div class="ai-pattern"><span><strong><%= model.model_key %></strong><small><%= model.model_type %> · <%= model.version %></small></span><span class="ai-status"><%= model.status %></span></div><% }); %></div></section><section class="ai-panel ai-panel--wide"><div class="ai-panel__head"><div><p class="ai-eyebrow">Forecasts</p><h2>Predictive analytics</h2></div></div><div class="ai-table-wrap"><table class="ai-table"><thead><tr><th>Type</th><th>Subject</th><th>Confidence</th><th>Horizon</th><th>Forecast</th><th>Generated</th></tr></thead><tbody><% predictions.forEach((prediction) => { %><tr><td><%= prediction.prediction_type %></td><td><%= prediction.subject_type %> <%= prediction.subject_id || '' %></td><td><%= prediction.confidence %>%</td><td><%= prediction.horizon %></td><td><%= JSON.stringify(prediction.forecast) %></td><td><%= new Date(prediction.generated_at).toLocaleString() %></td></tr><% }); %><% if (!predictions.length) { %><tr><td colspan="6" class="ai-empty">No predictions have been generated.</td></tr><% } %></tbody></table></div></section></div></main>
