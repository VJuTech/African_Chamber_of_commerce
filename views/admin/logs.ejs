<section class="admin-page"><header class="admin-page__heading"><div><p class="admin-eyebrow">Administration / observability</p><h1>System logs</h1><p>Search user activity, system events, and administrative actions from PostgreSQL.</p></div><form class="admin-search" method="get"><input name="search" value="<%= search %>" placeholder="Search events, resources, or outcomes" aria-label="Search logs"><button type="submit">Search</button></form></header><div class="admin-panel"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Event</th><th>Resource</th><th>Actor</th><th>Outcome</th><th>Created</th></tr></thead><tbody><% logs.forEach((log) => { %><tr><td><strong><%= log.event_type %></strong></td><td><%= log.resource_type %> <%= log.resource_id || '' %></td><td><%= log.actor_name || 'System' %></td><td><%= log.outcome || 'recorded' %></td><td><%= new Date(log.created_at).toLocaleString() %></td></tr><% }); %></tbody></table></div></div></section>
