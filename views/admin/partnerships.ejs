<main class="partnership-page">
  <header class="partnership-hero"><div><p class="partnership-eyebrow">Chapter 44 / ecosystem expansion</p><h1>Third-party partnerships</h1><p>Onboard trusted financial, logistics, government, technology, and business-network partners with governed access and durable exchange evidence.</p></div><a class="partnership-button partnership-button--light" href="/admin/dashboard">Management dashboard</a></header>
  <% if (message) { %><div class="partnership-alert"><%= message %></div><% } %>
  <% if (newlyIssuedSecret) { %><div class="partnership-secret"><strong>New partner credential</strong><code><%= newlyIssuedSecret %></code><small>Copy this credential now. ACC stores only its hash.</small></div><% } %>
  <section class="partnership-metrics"><article><span>Total partners</span><strong><%= metrics.total %></strong><small>Registered in PostgreSQL</small></article><article><span>Active partners</span><strong><%= metrics.active %></strong><small>Approved ecosystem access</small></article><article><span>Onboarding queue</span><strong><%= metrics.onboarding %></strong><small>Applicants and setup work</small></article><article><span>Exchanges / 24h</span><strong><%= metrics.exchanges_24h %></strong><small><%= metrics.failed_24h %> failed or rejected</small></article></section>
  <div class="partnership-grid">
    <section class="partnership-panel"><div class="partnership-panel__heading"><div><p class="partnership-kicker">Registration</p><h2>Register a partner</h2></div></div><form class="partnership-form" method="post" action="/admin/partnerships/partners"><label>Legal name<input name="legalName" required maxlength="180"></label><label>Display name<input name="displayName" required maxlength="160"></label><label>Partner type<select name="partnerType" required><option value="">Choose type</option><% partnerTypes.forEach((type) => { %><option value="<%= type %>"><%= type.replace(/_/g, ' ') %></option><% }) %></select></label><label>Country code<input name="countryCode" maxlength="3" placeholder="NG"></label><label>Contact email<input name="contactEmail" type="email" required maxlength="180"></label><label class="partnership-form__wide">Notes<textarea name="notes" rows="3" maxlength="2000"></textarea></label><button class="partnership-button" type="submit">Start onboarding</button></form></section>
    <section class="partnership-panel"><div class="partnership-panel__heading"><div><p class="partnership-kicker">Integration registry</p><h2>Configure an integration</h2></div></div><form class="partnership-form" method="post" action="/admin/partnerships/integrations"><label>Partner<select name="partnerId" required><option value="">Choose partner</option><% partners.forEach((partner) => { %><option value="<%= partner.id %>"><%= partner.display_name %></option><% }) %></select></label><label>Integration name<input name="name" required placeholder="Settlement status feed"></label><label>Method<select name="integrationType" required><% integrationTypes.forEach((type) => { %><option value="<%= type %>"><%= type.replace(/_/g, ' ') %></option><% }) %></select></label><label>Service area<select name="serviceArea" required><% serviceAreas.forEach((area) => { %><option value="<%= area %>"><%= area %></option><% }) %></select></label><label>Provider<input name="provider" required placeholder="Partner platform"></label><label class="partnership-form__wide">Endpoint URL<input name="endpointUrl" type="url" placeholder="https://partner.example.com/api"></label><button class="partnership-button" type="submit">Save integration</button></form></section>
  </div>
  <div class="partnership-grid">
    <section class="partnership-panel"><div class="partnership-panel__heading"><div><p class="partnership-kicker">Secure access</p><h2>Issue credential</h2></div></div><form class="partnership-form" method="post" action="/admin/partnerships/credentials"><label>Partner<select name="partnerId" required><option value="">Choose partner</option><% partners.forEach((partner) => { %><option value="<%= partner.id %>"><%= partner.display_name %></option><% }) %></select></label><label class="partnership-form__wide">Scopes<select name="scopes" multiple required><% accessScopes.forEach((scope) => { %><option value="<%= scope %>"><%= scope %></option><% }) %></select></label><button class="partnership-button" type="submit">Issue partner key</button></form></section>
    <section class="partnership-panel"><div class="partnership-panel__heading"><div><p class="partnership-kicker">Access control</p><h2>Grant a scope</h2></div></div><form class="partnership-form" method="post" action="/admin/partnerships/access"><label>Partner<select name="partnerId" required><option value="">Choose partner</option><% partners.forEach((partner) => { %><option value="<%= partner.id %>"><%= partner.display_name %></option><% }) %></select></label><label>Scope<select name="scope" required><% accessScopes.forEach((scope) => { %><option value="<%= scope %>"><%= scope %></option><% }) %></select></label><button class="partnership-button" type="submit">Grant access</button></form></section>
  </div>
  <section class="partnership-panel"><div class="partnership-panel__heading"><div><p class="partnership-kicker">Onboarding decisions</p><h2>Partner registry</h2></div><span><%= partners.length %> shown</span></div><div class="partnership-table-wrap"><table class="partnership-table"><thead><tr><th>Partner</th><th>Type</th><th>Status</th><th>Integrations</th><th>Credentials</th><th>Decision</th></tr></thead><tbody><% partners.forEach((partner) => { %><tr><td><strong><%= partner.display_name %></strong><small><%= partner.legal_name %> · <%= partner.contact_email %></small></td><td><%= partner.partner_type.replace(/_/g, ' ') %></td><td><span class="partnership-status partnership-status--<%= partner.status %>"><%= partner.status %></span></td><td><%= partner.integration_count %></td><td><%= partner.credential_count %></td><td><form class="partnership-inline-form" method="post" action="/admin/partnerships/partners/<%= partner.id %>/status"><select name="status"><option value="onboarding">Onboarding</option><option value="active">Approve</option><option value="suspended">Suspend</option><option value="rejected">Reject</option></select><button class="partnership-button" type="submit">Save</button></form></td></tr><% }) %><% if (!partners.length) { %><tr><td colspan="6">No partners registered yet.</td></tr><% } %></tbody></table></div></section>
  <div class="partnership-grid"><section class="partnership-panel"><div class="partnership-panel__heading"><div><p class="partnership-kicker">Integration health</p><h2>Connected services</h2></div></div><div class="partnership-list"><% integrations.forEach((item) => { %><div><strong><%= item.name %></strong><span><%= item.partner_name %> · <%= item.service_area %> · <%= item.status %></span></div><% }) %><% if (!integrations.length) { %><p>No integrations configured.</p><% } %></div></section><section class="partnership-panel"><div class="partnership-panel__heading"><div><p class="partnership-kicker">Exchange monitoring</p><h2>Recent partner events</h2></div></div><div class="partnership-list"><% exchanges.slice(0, 8).forEach((item) => { %><div><strong><%= item.event_type %></strong><span><%= item.partner_name || 'Unknown partner' %> · <%= item.status %> · <%= item.latency_ms %> ms</span></div><% }) %><% if (!exchanges.length) { %><p>No partner exchanges recorded.</p><% } %></div></section></div>
</main>
