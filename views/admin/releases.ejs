<main class="release-page">
  <header class="release-hero"><div><p class="release-kicker">ACC system evolution layer</p><h1>Versioning &amp; release management</h1><p>Control semantic versions, prepare releases, verify compatibility, deploy safely, monitor outcomes, and preserve rollback evidence.</p></div><form class="release-form release-form--compact" method="post" action="/admin/releases/versions"><label>Version<input name="version" required placeholder="v1.2.3"></label><label>Component<input name="component" value="acc-platform"></label><label>Commit SHA<input name="commitSha"></label><button type="submit">Register version</button></form></header>
  <% if (message) { %><p class="release-feedback"><%= message %></p><% } %>
  <section class="release-metrics"><article><span>Planned releases</span><strong><%= counts.planned %></strong><small>Queued, active, or ready</small></article><article><span>Monitoring watchlist</span><strong><%= counts.activeMonitoring %></strong><small>Watch and incident observations</small></article><article><span>Compatibility reviews</span><strong><%= counts.openCompatibility %></strong><small>Entries not yet verified</small></article></section>
  <div class="release-grid"><section class="release-panel"><div class="release-heading"><div><p class="release-kicker">Structured cycle</p><h2>Release plan</h2></div></div><form class="release-form" method="post" action="/admin/releases/plans"><label>Version<select name="version" required><option value="">Registered version</option><% versions.forEach((version) => { %><option value="<%= version.version %>"><%= version.version %></option><% }); %></select></label><div class="release-form--compact"><label>Type<select name="releaseType"><option value="major">Major</option><option value="minor">Minor</option><option value="patch">Patch</option><option value="hotfix">Hotfix</option></select></label><label>Schedule<input name="scheduledAt" type="datetime-local"></label></div><label>Title<input name="title" required></label><label>Scope<textarea name="scope" required placeholder="Features and changes included"></textarea></label><label>QA report ID<input name="qaReportId" type="number" min="1" placeholder="Optional Chapter 40 report ID"></label><button type="submit">Create release plan</button></form><div class="release-list"><% plans.slice(0,8).forEach((plan) => { %><article><strong><%= plan.version %> &middot; <%= plan.title %></strong><span><%= plan.releaseType %> / <%= plan.status %> &middot; <%= plan.scheduledAt ? new Date(plan.scheduledAt).toLocaleString() : 'Schedule pending' %></span><small><%= plan.scope %></small><div class="release-actions"><form method="post" action="/admin/releases/deploy"><input type="hidden" name="releasePlanId" value="<%= plan.id %>"><button type="submit">Record deploy</button></form><form method="post" action="/admin/releases/rollback"><input type="hidden" name="releasePlanId" value="<%= plan.id %>"><input type="hidden" name="reason" value="Operator rollback from release control room"><button type="submit">Rollback</button></form></div></article><% }); %><% if (!plans.length) { %><p>No release plans have been created.</p><% } %></div></section>
  <section class="release-panel"><div class="release-heading"><div><p class="release-kicker">Documentation</p><h2>Release notes</h2></div></div><form class="release-form" method="post" action="/admin/releases/notes"><label>Release plan<select name="releasePlanId" required><option value="">Select release</option><% plans.forEach((plan) => { %><option value="<%= plan.id %>"><%= plan.version %> &middot; <%= plan.title %></option><% }); %></select></label><div class="release-form--compact"><label>Category<select name="category"><option value="feature">Feature</option><option value="bug_fix">Bug fix</option><option value="change">Change</option><option value="security">Security</option><option value="breaking">Breaking</option></select></label><label>Audience<select name="audience"><option value="user">User</option><option value="admin">Admin</option><option value="internal">Internal</option></select></label></div><label>Title<input name="title" required></label><label>Notes<textarea name="body" required></textarea></label><button type="submit">Save release note</button></form><div class="release-list"><% notes.slice(0,8).forEach((note) => { %><article><strong><%= note.version %> &middot; <%= note.title %></strong><span><%= note.category %> / <%= note.audience %></span><small><%= note.body %></small></article><% }); %><% if (!notes.length) { %><p>No release notes have been written.</p><% } %></div></section></div>
  <div class="release-grid"><section class="release-panel"><div class="release-heading"><div><p class="release-kicker">Integration safety</p><h2>Backward compatibility</h2></div></div><form class="release-form" method="post" action="/admin/releases/compatibility"><label>Release plan<select name="releasePlanId" required><option value="">Select release</option><% plans.forEach((plan) => { %><option value="<%= plan.id %>"><%= plan.version %> &middot; <%= plan.title %></option><% }); %></select></label><label>Integration name<input name="integrationName" required placeholder="Partner API v1"></label><div class="release-form--compact"><label>Minimum version<input name="minimumVersion" placeholder="v1.0.0"></label><label>Status<select name="compatibilityStatus"><option value="required">Required</option><option value="verified">Verified</option><option value="deprecated">Deprecated</option><option value="breaking">Breaking</option></select></label></div><label>Verification notes<textarea name="verificationNotes"></textarea></label><button type="submit">Record compatibility</button></form><div class="release-list"><% compatibility.slice(0,8).forEach((item) => { %><article><strong><%= item.version %> &middot; <%= item.integrationName %></strong><span class="release-pill"><%= item.compatibilityStatus %></span><small>Minimum supported: <%= item.minimumVersion || 'Not specified' %></small></article><% }); %></div></section>
  <section class="release-panel"><div class="release-heading"><div><p class="release-kicker">After deployment</p><h2>Release monitoring</h2></div></div><form class="release-form" method="post" action="/admin/releases/monitoring"><label>Release plan<select name="releasePlanId" required><option value="">Select release</option><% plans.forEach((plan) => { %><option value="<%= plan.id %>"><%= plan.version %> &middot; <%= plan.title %></option><% }); %></select></label><div class="release-form--compact"><label>Environment ID<input name="environmentId" type="number" min="1" placeholder="Deployment environment ID"></label><label>Status<select name="status"><option value="healthy">Healthy</option><option value="watch">Watch</option><option value="incident">Incident</option><option value="resolved">Resolved</option></select></label><label>Error rate<input name="errorRate" type="number" min="0" step="0.01"></label><label>Response time (ms)<input name="responseTimeMs" type="number" min="0"></label></div><label>Issue summary<textarea name="issueSummary"></textarea></label><button type="submit">Record observation</button></form><div class="release-list"><% monitoring.slice(0,8).forEach((item) => { %><article><strong><%= item.version %> &middot; <%= item.environmentKey || 'platform' %></strong><span class="release-pill release-pill--<%= item.status %>"><%= item.status %></span><small><%= item.issueSummary || 'No issue summary' %> &middot; <%= new Date(item.recordedAt).toLocaleString() %></small></article><% }); %></div></section></div>
  <div class="release-grid"><section class="release-panel"><div class="release-heading"><div><p class="release-kicker">Controlled rollout</p><h2>Feature flags</h2></div></div><div class="release-list"><% flags.forEach((flag) => { %><article><strong><%= flag.displayName %></strong><span><%= flag.enabled ? 'Enabled' : 'Disabled' %></span><small><%= flag.description || flag.featureKey %></small><div class="release-actions"><form method="post" action="/admin/releases/features/<%= flag.featureKey %>"><input type="hidden" name="enabled" value="<%= flag.enabled ? 'false' : 'true' %>"><button type="submit"><%= flag.enabled ? 'Disable' : 'Enable' %></button></form></div></article><% }); %></div></section><section class="release-panel"><div class="release-heading"><div><p class="release-kicker">Traceability</p><h2>Release audit</h2></div></div><div class="release-list"><% audit.slice(0,12).forEach((event) => { %><article><strong><%= event.eventType %> <%= event.version || '' %></strong><span><%= event.outcome %></span><small><%= new Date(event.createdAt).toLocaleString() %></small></article><% }); %><% if (!audit.length) { %><p>No release activity has been recorded.</p><% } %></div></section></div>
</main>
