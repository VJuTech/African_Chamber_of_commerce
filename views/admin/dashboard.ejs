<section class="management-dashboard" aria-labelledby="management-dashboard-title">
  <div class="management-toolbar" aria-label="ACC management tools">
    <button class="management-back" type="button" data-management-back data-fallback="/admin/dashboard">
      <span aria-hidden="true">&larr;</span>
      <span>Back</span>
    </button>

    <div class="management-menu" data-management-menu>
      <button class="management-menu__trigger" type="button" aria-expanded="false" aria-controls="managementMenuPanel">
        <span class="management-menu__trigger-icon" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>ACC Management</span>
        <span class="management-menu__chevron" aria-hidden="true">+</span>
      </button>
      <div class="management-menu__panel" id="managementMenuPanel" aria-label="ACC management sections">
        <div class="management-menu__intro">
          <span class="management-eyebrow">ACC control room</span>
          <strong>Manage the chamber platform</strong>
          <p>Move between access, requirements, and system operations from one place.</p>
        </div>
        <nav class="management-menu__links" aria-label="ACC management navigation">
          <a href="/admin/dashboard" data-management-link="/admin/dashboard"><span class="management-menu__index" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M4 13h6V4H4v9Zm0 7h6v-4H4v4Zm10 0h6v-9h-6v9Zm0-16v4h6V4h-6Z" /></svg></span><span><strong>Dashboard</strong><small>Operational snapshot</small></span><span aria-hidden="true">&rarr;</span></a>
          <a href="/workspace" data-management-link="/workspace"><span class="management-menu__index" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v13a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 18.5v-13ZM7 7h10M7 11h10M7 15h6" /></svg></span><span><strong>Workspace</strong><small>Member tools and services</small></span><span aria-hidden="true">&rarr;</span></a>
          <a href="/admin/control-center" data-management-link="/admin/control-center"><span class="management-menu__index" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M4 6h16M4 12h16M4 18h16M8 6v0m8 6v0m-5 6v0" /></svg></span><span><strong>Control center</strong><small>Users, commerce, and operations</small></span><span aria-hidden="true">&rarr;</span></a>
          <a href="/admin/access-control" data-management-link="/admin/access-control"><span class="management-menu__index" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M12 3 5 6v5c0 4.5 2.9 8.2 7 10 4.1-1.8 7-5.5 7-10V6l-7-3Zm0 5v5m0 0 3 2m-3-2-3 2" /></svg></span><span><strong>Access control</strong><small>Users, roles, and audit activity</small></span><span aria-hidden="true">&rarr;</span></a>
          <a href="/admin/requirements" data-management-link="/admin/requirements"><span class="management-menu__index" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="m5 12 4 4L19 6M4 4h16v16H4V4Z" /></svg></span><span><strong>Requirements</strong><small>Traceability and compliance coverage</small></span><span aria-hidden="true">&rarr;</span></a>
          <a href="/admin/system-overview" data-management-link="/admin/system-overview"><span class="management-menu__index" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M4 19h16M6 16V9m6 7V5m6 11v-4" /></svg></span><span><strong>System overview</strong><small>Architecture and integration health</small></span><span aria-hidden="true">&rarr;</span></a>
          <a href="/admin/api" data-management-link="/admin/api"><span class="management-menu__index" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="m8 8-4 4 4 4m8-8 4 4-4 4m-3-11-2 14" /></svg></span><span><strong>API &amp; integrations</strong><small>Clients, webhooks, and usage</small></span><span aria-hidden="true">&rarr;</span></a>
          <a href="/admin/deployment" data-management-link="/admin/deployment"><span class="management-menu__index" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 17v3h14v-3" /></svg></span><span><strong>Deployment &amp; infrastructure</strong><small>Environments, health, and recovery</small></span><span aria-hidden="true">&rarr;</span></a>
          <a href="/admin/customer-care" data-management-link="/admin/customer-care"><span class="management-menu__index" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M5 6.5A2.5 2.5 0 0 1 7.5 4h9A2.5 2.5 0 0 1 19 6.5v6a2.5 2.5 0 0 1-2.5 2.5H12l-4 4v-4h-.5A2.5 2.5 0 0 1 5 12.5v-6ZM9 9h6m-6 3h4" /></svg></span><span><strong>Customer care</strong><small>Assistant handoffs and replies</small></span><span aria-hidden="true">&rarr;</span></a>
          <a href="/admin/settings" data-management-link="/admin/settings"><span class="management-menu__index" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm0-5v2m0 14v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M3 12h2m14 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" /></svg></span><span><strong>System settings</strong><small>Platform configuration and feature flags</small></span><span aria-hidden="true">&rarr;</span></a>
          <a href="/admin/data-management" data-management-link="/admin/data-management"><span class="management-menu__index" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M5 5h14v4H5V5Zm0 6h14v4H5v-4Zm0 6h14v2H5v-2Z" /></svg></span><span><strong>Data management</strong><small>Integrity, lifecycle, backups, and recovery</small></span><span aria-hidden="true">&rarr;</span></a>
          <a href="/admin/performance" data-management-link="/admin/performance"><span class="management-menu__index" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M4 19h16M6 16V9m6 7V5m6 11v-4" /></svg></span><span><strong>Performance</strong><small>Latency, capacity, scaling, and peak load</small></span><span aria-hidden="true">&rarr;</span></a>
        </nav>
      </div>
    </div>
  </div>

  <header class="management-dashboard__hero">
    <div>
      <p class="management-eyebrow">ACC operations centre</p>
      <h1 id="management-dashboard-title">Management dashboard</h1>
      <p>One control surface for platform access, requirement traceability, and system health.</p>
    </div>
    <div class="management-dashboard__identity">
      <span>Signed in as</span>
      <strong><%= user && user.name ? user.name : 'ACC Administrator' %></strong>
      <small><%= user && user.email ? user.email : '' %></small>
    </div>
  </header>

  <div class="management-metrics" aria-label="Management metrics">
    <article><span>Users</span><strong><%= metrics.users %></strong><small>Accounts in PostgreSQL</small></article>
    <article><span>RBAC roles</span><strong><%= metrics.roles %></strong><small>Available platform roles</small></article>
    <article><span>Requirements</span><strong><%= metrics.completeRequirements %>/<%= metrics.requirements %></strong><small>Traceability complete</small></article>
    <article><span>Integrations</span><strong><%= metrics.healthyIntegrations %>/<%= metrics.integrations %></strong><small>Currently healthy</small></article>
  </div>

  <div class="management-card-grid">
    <article class="management-card management-card--access">
      <div class="management-card__top"><span class="management-card__number">01</span><span class="management-card__status">RBAC</span></div>
      <h2>Access control</h2>
      <p>Review users, assign normalized roles, and inspect the latest audit activity.</p>
      <div class="management-card__summary"><strong><%= access.users.length %></strong><span>users shown in access review</span></div>
      <a class="management-card__link" href="/admin/access-control">Open access control <span aria-hidden="true">&rarr;</span></a>
    </article>

    <article class="management-card management-card--requirements">
      <div class="management-card__top"><span class="management-card__number">02</span><span class="management-card__status"><%= metrics.completeRequirements %> complete</span></div>
      <h2>Requirements</h2>
      <p>Track functional coverage, validation rules, compliance controls, and change history.</p>
      <div class="management-card__summary"><strong><%= metrics.requirements %></strong><span>active requirements in traceability</span></div>
      <a class="management-card__link" href="/admin/requirements">Open requirements <span aria-hidden="true">&rarr;</span></a>
    </article>

    <article class="management-card management-card--system">
      <div class="management-card__top"><span class="management-card__number">03</span><span class="management-card__status"><%= metrics.healthyIntegrations %> healthy</span></div>
      <h2>System overview</h2>
      <p>Monitor architecture layers, external services, live platform counts, and operational status.</p>
      <div class="management-card__summary"><strong><%= metrics.integrations %></strong><span>registered platform integrations</span></div>
      <a class="management-card__link" href="/admin/system-overview">Open system overview <span aria-hidden="true">&rarr;</span></a>
    </article>

    <article class="management-card management-card--requirements">
      <div class="management-card__top"><span class="management-card__number">04</span><span class="management-card__status"><%= metrics.openComplianceFlags %> open flags</span></div>
      <h2>Compliance operations</h2>
      <p>Review KYC and business verification queues, AML signals, restrictions, and compliance audit activity.</p>
      <div class="management-card__summary"><strong><%= metrics.pendingKyc + metrics.pendingBusiness %></strong><span>verification cases pending</span></div>
      <a class="management-card__link" href="/admin/compliance">Open compliance operations <span aria-hidden="true">&rarr;</span></a>
    </article>

    <article class="management-card management-card--system">
      <div class="management-card__top"><span class="management-card__number">05</span><span class="management-card__status"><%= metrics.integrityWarnings %> warnings</span></div>
      <h2>Data management</h2>
      <p>Monitor structured storage, integrity checks, retention, backups, recovery requests, and change history.</p>
      <div class="management-card__summary"><strong><%= metrics.recoveryRequests %></strong><span>recovery requests requiring attention</span></div>
      <a class="management-card__link" href="/admin/data-management">Open data management <span aria-hidden="true">&rarr;</span></a>
    </article>

    <article class="management-card management-card--access">
      <div class="management-card__top"><span class="management-card__number">07</span><span class="management-card__status">Support</span></div>
      <h2>Customer care</h2>
      <p>Continue assistant conversations and respond to members who request an authorized ACC representative.</p>
      <div class="management-card__summary"><strong>&rarr;</strong><span>Open the customer-care queue</span></div>
      <a class="management-card__link" href="/admin/customer-care">Open customer care <span aria-hidden="true">&rarr;</span></a>
    </article>

    <article class="management-card management-card--system">
      <div class="management-card__top"><span class="management-card__number">06</span><span class="management-card__status"><%= metrics.performanceErrorRate %>% errors</span></div>
      <h2>Performance &amp; scalability</h2>
      <p>Track response targets, throughput, concurrency, scaling posture, caching, CDN delivery, and optimization evidence.</p>
      <div class="management-card__summary"><strong><%= metrics.performanceApiLatency %> ms</strong><span>average API response over 24 hours</span></div>
      <a class="management-card__link" href="/admin/performance">Open performance controls <span aria-hidden="true">&rarr;</span></a>
    </article>
  </div>

  <section class="management-latest" aria-labelledby="management-latest-title">
    <div class="management-section-heading"><div><p class="management-eyebrow">Operational snapshot</p><h2 id="management-latest-title">Integration health</h2></div><a href="/admin/system-overview">View full status <span aria-hidden="true">&rarr;</span></a></div>
    <div class="management-integrations">
      <% overview.integrations.forEach((integration) => { %>
        <div class="management-integration"><span class="management-integration__dot management-integration__dot--<%= integration.status %>"></span><div><strong><%= integration.displayName %></strong><small><%= integration.provider %> &middot; <%= integration.environment %></small></div><span class="management-integration__status"><%= integration.status.replace('_', ' ') %></span></div>
      <% }); %>
    </div>
  </section>
    <div class="management-activity-grid">
      <section class="management-latest" aria-labelledby="management-users-title">
        <div class="management-section-heading"><div><p class="management-eyebrow">People</p><h2 id="management-users-title">Recent user activity</h2></div><a href="/admin/access-control">Manage access <span aria-hidden="true">&rarr;</span></a></div>
        <div class="management-user-list">
          <% access.users.slice(0, 5).forEach((account) => { %>
            <div class="management-user-row"><div><strong><%= account.name %></strong><small><%= account.email %></small></div><span><%= account.assigned_roles || 'Registered User' %></span></div>
          <% }); %>
          <% if (!access.users.length) { %><p class="management-empty">No user activity is available yet.</p><% } %>
        </div>
      </section>

      <section class="management-latest" aria-labelledby="management-audit-title">
        <div class="management-section-heading"><div><p class="management-eyebrow">Traceability</p><h2 id="management-audit-title">Latest audit events</h2></div><a href="/admin/access-control">View audit trail <span aria-hidden="true">&rarr;</span></a></div>
        <div class="management-audit-list">
          <% access.auditLogs.slice(0, 5).forEach((log) => { %>
            <div class="management-audit-row"><strong><%= log.event_type %></strong><span><%= log.outcome || 'recorded' %></span><small><%= new Date(log.created_at).toLocaleString() %></small></div>
          <% }); %>
          <% if (!access.auditLogs.length) { %><p class="management-empty">No audit events are available yet.</p><% } %>
        </div>
      </section>
    </div>
</section>
