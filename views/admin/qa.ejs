<main class="qa-page">
  <header class="qa-hero"><div><p class="qa-kicker">ACC quality control layer</p><h1>Testing &amp; QA</h1><p>Plan validation, execute automated and manual checks, track defects, and assemble release evidence before deployment.</p></div><form class="qa-form qa-form--compact" method="post" action="/admin/qa/reports"><label>Report name<input name="name" placeholder="Release readiness report" required></label><label>Report type<select name="reportType"><option value="test_results">Test results</option><option value="bug_summary">Bug summary</option><option value="release_readiness">Release readiness</option></select></label><button type="submit">Generate report</button></form></header>
  <% if (message) { %><p class="qa-feedback"><%= message %></p><% } %>
  <section class="qa-metrics"><article><span>Test cases</span><strong><%= counts.totalCases %></strong><small>Active validation scenarios</small></article><article><span>Executions</span><strong><%= counts.totalRuns %></strong><small><%= counts.passed %> passed</small></article><article><span>Failed</span><strong><%= counts.failed %></strong><small>Require triage or retest</small></article><article><span>Open defects</span><strong><%= counts.openBugs %></strong><small><%= counts.criticalBugs %> critical</small></article><article><span>Reports</span><strong><%= reports.length %></strong><small>Durable review evidence</small></article></section>
  <div class="qa-grid"><section class="qa-panel"><div class="qa-heading"><div><p class="qa-kicker">Release workflow</p><h2>Test plan</h2></div></div><form class="qa-form" method="post" action="/admin/qa/plans"><label>Plan name<input name="name" required placeholder="Chapter 40 release validation"></label><label>Release key<input name="releaseKey" required placeholder="2026.09"></label><label>Scope<textarea name="scope" required placeholder="Features and workflows included"></textarea></label><button type="submit">Create plan</button></form><div class="qa-list"><% plans.slice(0,6).forEach((plan) => { %><article><strong><%= plan.name %></strong><span><%= plan.releaseKey %> &middot; <%= plan.status %></span><small><%= plan.scope %></small></article><% }); %><% if (!plans.length) { %><p>No test plans have been created.</p><% } %></div></section>
  <section class="qa-panel"><div class="qa-heading"><div><p class="qa-kicker">Scenario library</p><h2>Test case</h2></div></div><form class="qa-form" method="post" action="/admin/qa/cases"><label>Plan<select name="planId"><option value="">Unassigned</option><% plans.forEach((plan) => { %><option value="<%= plan.id %>"><%= plan.name %></option><% }); %></select></label><label>Case key<input name="caseKey" required placeholder="QA-UNIT-001"></label><label>Title<input name="title" required></label><div class="qa-form--compact"><label>Test type<select name="testType"><option value="unit">Unit</option><option value="integration">Integration</option><option value="system">System</option><option value="uat">UAT</option><option value="performance">Performance</option><option value="security">Security</option></select></label><label>Mode<select name="executionMode"><option value="automated">Automated</option><option value="manual">Manual</option></select></label></div><label>Scenario<textarea name="scenario" required></textarea></label><label>Expected result<textarea name="expectedResult" required></textarea></label><button type="submit">Add test case</button></form></section></div>
  <div class="qa-grid"><section class="qa-panel qa-panel--wide"><div class="qa-heading"><div><p class="qa-kicker">Execution evidence</p><h2>Run a test and record results</h2></div></div><form class="qa-form qa-form--compact" method="post" action="/admin/qa/runs"><label>Test case<select name="caseId" required><% cases.forEach((testCase) => { %><option value="<%= testCase.id %>"><%= testCase.caseKey %> &middot; <%= testCase.title %></option><% }); %></select></label><label>Run type<select name="runType"><option value="unit">Unit</option><option value="integration">Integration</option><option value="system">System</option><option value="uat">UAT</option><option value="regression">Regression</option><option value="performance">Performance</option><option value="security">Security</option></select></label><label>Mode<select name="executionMode"><option value="automated">Automated</option><option value="manual">Manual</option></select></label><label>Result<select name="result"><option value="passed">Passed</option><option value="failed">Failed</option><option value="blocked">Blocked</option><option value="skipped">Skipped</option><option value="pending">Pending</option></select></label><label>Duration (ms)<input type="number" name="durationMs" min="0"></label><label class="qa-form__full">Notes<textarea name="notes"></textarea></label><button type="submit">Record execution</button></form><div class="qa-table-wrap"><table class="qa-table"><thead><tr><th>Case</th><th>Type</th><th>Mode</th><th>Result</th><th>Executed</th></tr></thead><tbody><% runs.slice(0,15).forEach((run) => { %><tr><td><strong><%= run.caseKey %></strong><small><%= run.title %></small></td><td><%= run.runType %></td><td><%= run.executionMode %></td><td><span class="qa-pill qa-pill--<%= run.result %>"><%= run.result %></span></td><td><%= new Date(run.executedAt).toLocaleString() %></td></tr><% }); %><% if (!runs.length) { %><tr><td colspan="5">No test executions have been recorded.</td></tr><% } %></tbody></table></div></section></div>
  <div class="qa-grid"><section class="qa-panel"><div class="qa-heading"><div><p class="qa-kicker">Defect control</p><h2>Bug tracking</h2></div></div><form class="qa-form" method="post" action="/admin/qa/bugs"><label>Bug key<input name="bugKey" required placeholder="BUG-0001"></label><label>Title<input name="title" required></label><label>Description<textarea name="description" required></textarea></label><div class="qa-form--compact"><label>Severity<select name="severity"><option value="low">Low</option><option value="medium">Medium</option><option value="high">High</option><option value="critical">Critical</option></select></label><label>Test case<select name="testCaseId"><option value="">Unlinked</option><% cases.forEach((testCase) => { %><option value="<%= testCase.id %>"><%= testCase.caseKey %></option><% }); %></select></label></div><button type="submit">Log defect</button></form><div class="qa-list"><% bugs.slice(0,10).forEach((bug) => { %><article><strong><%= bug.bugKey %> &middot; <%= bug.title %></strong><span class="qa-pill qa-pill--<%= bug.status %>"><%= bug.severity %> / <%= bug.status %></span><form method="post" action="/admin/qa/bugs/<%= bug.id %>"><select name="status"><option value="in_progress">In progress</option><option value="fixed">Fixed</option><option value="retest">Retest</option><option value="closed">Closed</option></select><input type="hidden" name="resolutionNotes" value="Updated from QA control room"><button type="submit">Update</button></form></article><% }); %><% if (!bugs.length) { %><p>No defects have been logged.</p><% } %></div></section><section class="qa-panel"><div class="qa-heading"><div><p class="qa-kicker">Review archive</p><h2>Test reports</h2></div></div><div class="qa-list"><% reports.forEach((report) => { %><article><strong><%= report.name %></strong><span><%= report.reportType %></span><small><%= new Date(report.createdAt).toLocaleString() %> &middot; <%= report.reportKey %></small></article><% }); %><% if (!reports.length) { %><p>No QA reports have been generated.</p><% } %></div></section></div>
</main>
