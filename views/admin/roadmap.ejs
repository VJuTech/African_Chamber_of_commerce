<main class="roadmap-page roadmap-admin"><header class="roadmap-hero roadmap-hero--admin"><div><p class="roadmap-eyebrow">ACC Management · Chapter 45</p><h1>Roadmap governance</h1><p>Turn strategic intent into an accountable delivery portfolio with evidence from members, technology reviews, and operational scale planning.</p></div><a class="roadmap-button roadmap-button--light" href="/roadmap">View public roadmap</a></header><% if (message) { %><div class="roadmap-alert"><%= message %></div><% } %>
<section class="roadmap-metrics"><% [['Features', metrics.totalFeatures], ['Active delivery', metrics.activeFeatures], ['Released', metrics.releasedFeatures], ['New feedback', metrics.newFeedback], ['Innovation', metrics.activeInnovations], ['Tech reviews', metrics.openEvaluations], ['Scale attention', metrics.scalabilityAttention]].forEach((item) => { %><div><span><%= item[0] %></span><strong><%= item[1] || 0 %></strong></div><% }) %></section>
<section class="roadmap-admin-grid"><div class="roadmap-panel roadmap-panel--wide"><div class="roadmap-section__heading"><div><p class="roadmap-kicker">Incremental delivery</p><h2>Feature portfolio</h2></div></div><div class="roadmap-table"><div class="roadmap-table__row roadmap-table__row--head"><span>Initiative</span><span>Phase</span><span>Priority</span><span>Status</span></div><% features.forEach((item) => { %><div class="roadmap-table__row"><span><strong><%= item.title %></strong><small><%= item.owner_name || 'Unassigned' %> · <%= item.target_quarter || 'No target' %></small></span><span><%= item.phase_name || 'Unassigned' %></span><span><%= item.priority %></span><span><form method="post" action="/admin/roadmap/features/<%= item.id %>/status"><select name="status" onchange="this.form.submit()"><% featureStatuses.forEach((status) => { %><option value="<%= status %>" <%= item.status === status ? 'selected' : '' %>><%= status.replace(/_/g, ' ') %></option><% }) %></select></form></span></div><% }) %></div><form class="roadmap-form roadmap-form--compact" method="post" action="/admin/roadmap/features"><h3>Add feature</h3><label>Title<input name="title" required maxlength="180"></label><label>Description<textarea name="description" rows="2"></textarea></label><label>Phase<select name="phaseId"><option value="">Unassigned</option><% phases.forEach((phase) => { %><option value="<%= phase.id %>"><%= phase.name %></option><% }) %></select></label><label>Priority<select name="priority"><% priorities.forEach((priority) => { %><option><%= priority %></option><% }) %></select></label><label>Target quarter<input name="targetQuarter" placeholder="2027 Q1"></label><button class="roadmap-button" type="submit">Add feature</button></form></div>
<div class="roadmap-panel"><p class="roadmap-kicker">Strategic alignment</p><h2>Goals</h2><div class="roadmap-list"><% goals.forEach((item) => { %><div><strong><%= item.title %></strong><span><%= item.goal_area %> · <%= item.status %></span></div><% }) %></div><form class="roadmap-form roadmap-form--compact" method="post" action="/admin/roadmap/goals"><label>Goal title<input name="title" required maxlength="180"></label><label>Area<input name="goalArea" required maxlength="100"></label><label>Description<textarea name="description" rows="2"></textarea></label><button class="roadmap-button" type="submit">Add goal</button></form></div>
<div class="roadmap-panel"><p class="roadmap-kicker">Technology watch</p><h2>Evaluations</h2><div class="roadmap-list"><% evaluations.forEach((item) => { %><div><strong><%= item.technology_name %></strong><span><%= item.category %> · <%= item.status %></span></div><% }) %></div><form class="roadmap-form roadmap-form--compact" method="post" action="/admin/roadmap/evaluations"><label>Technology<input name="technologyName" required maxlength="180"></label><label>Category<input name="category" required maxlength="100"></label><label>Use case<textarea name="useCase" required rows="2"></textarea></label><label>Recommendation<textarea name="recommendation" rows="2"></textarea></label><button class="roadmap-button" type="submit">Record evaluation</button></form></div>
<div class="roadmap-panel"><p class="roadmap-kicker">Scale planning</p><h2>Capacity risks</h2><div class="roadmap-list"><% scalability.forEach((item) => { %><div><strong><%= item.area %></strong><span><%= item.current_capacity %> → <%= item.target_capacity %></span><small><%= item.status %> · target <%= item.target_date || 'TBC' %></small></div><% }) %></div><form class="roadmap-form roadmap-form--compact" method="post" action="/admin/roadmap/scalability"><label>Area<input name="area" required maxlength="120"></label><label>Current capacity<input name="currentCapacity" required maxlength="180"></label><label>Target capacity<input name="targetCapacity" required maxlength="180"></label><label>Strategy<textarea name="strategy" required rows="2"></textarea></label><label>Target date<input name="targetDate" type="date"></label><button class="roadmap-button" type="submit">Add scale plan</button></form></div>
<div class="roadmap-panel"><p class="roadmap-kicker">Stakeholder voice</p><h2>Feedback queue</h2><div class="roadmap-list"><% feedback.forEach((item) => { %><div><strong><%= item.message.slice(0, 110) %><%= item.message.length > 110 ? '…' : '' %></strong><span><%= item.stakeholder_name || 'Member' %> · rating <%= item.rating || 'n/a' %></span><form method="post" action="/admin/roadmap/feedback/<%= item.id %>/status"><select name="status" onchange="this.form.submit()"><% feedbackStatuses.forEach((status) => { %><option value="<%= status %>" <%= item.status === status ? 'selected' : '' %>><%= status.replace(/_/g, ' ') %></option><% }) %></select></form></div><% }) %></div></div></section>
<section class="roadmap-panel roadmap-audit"><p class="roadmap-kicker">Governance trail</p><h2>Recent roadmap audit events</h2><div class="roadmap-table"><% auditLogs.slice(0, 12).forEach((log) => { %><div class="roadmap-table__row"><span><strong><%= log.action %></strong><small><%= log.entity_type %> #<%= log.entity_id %></small></span><span><%= log.actor_name || 'System' %></span><span><%= new Date(log.created_at).toLocaleString() %></span></div><% }) %></div></section></main>
