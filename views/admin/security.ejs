<section class="security-page admin-security-page">
  <header class="security-hero"><div><p class="security-eyebrow">Chapter 28 / security operations</p><h1>Security monitoring</h1><p>Review authentication events, lockout activity, alerts, and access-control evidence from PostgreSQL.</p></div><a class="secondary-btn" href="/admin/control-center">Control center</a></header>
  <form method="get" action="/admin/security" class="security-search"><label for="search">Search event, outcome, or email</label><input id="search" name="search" value="<%= search %>" /><button type="submit" class="primary-btn">Search</button></form>
  <div class="security-metrics"><article><span>Tracked event types</span><strong><%= attempts.length %></strong></article><article><span>Open alerts</span><strong><%= alerts.filter((alert) => alert.status === 'unread').length %></strong></article><article><span>Audit records shown</span><strong><%= auditLogs.length %></strong></article></div>
  <section class="security-panel"><h2>Security audit log</h2><div class="security-table-wrap"><table class="security-table"><thead><tr><th>Event</th><th>Account</th><th>Outcome</th><th>IP</th><th>Time</th></tr></thead><tbody><% auditLogs.forEach((entry) => { %><tr><td><strong><%= entry.eventType %></strong></td><td><%= entry.email || 'Unknown account' %></td><td><span class="security-status"><%= entry.outcome %></span></td><td><%= entry.ipAddress || 'Unavailable' %></td><td><%= new Date(entry.createdAt).toLocaleString() %></td></tr><% }) %><% if (!auditLogs.length) { %><tr><td colspan="5">No security audit records match this search.</td></tr><% } %></tbody></table></div></section>
  <section class="security-panel"><h2>Recent alerts</h2><div class="security-list"><% alerts.slice(0, 12).forEach((alert) => { %><article><div><strong><%= alert.title %></strong><span><%= alert.email || 'Unknown account' %> · <%= alert.message %></span></div><time><%= new Date(alert.created_at).toLocaleString() %></time></article><% }) %></div></section>
</section>
