<main class="data-page">
  <header class="data-hero"><div><p class="data-eyebrow">Chapter 35 / data backbone</p><h1>Data management</h1><p>Inspect structured storage, integrity, lifecycle, backup, recovery, versioning, and audit evidence from PostgreSQL.</p></div><a class="data-button" href="/admin/dashboard">Management dashboard</a></header>
  <% if (message) { %><p class="data-notice" role="status"><%= message %></p><% } %>
  <% if (error) { %><p class="data-notice" role="alert"><%= error %></p><% } %>
  <div class="data-actions"><form method="post" action="/admin/data-management/integrity-checks"><button class="data-button" type="submit">Run integrity checks</button></form><form method="post" action="/admin/data-management/backups"><input type="hidden" name="environmentKey" value="production"><button class="data-button data-button--quiet" type="submit">Request scheduled backup</button></form></div>
  <section class="data-panel"><h2>Structured data catalog</h2><table class="data-table"><thead><tr><th>Resource</th><th>Category</th><th>Storage</th><th>Retention</th><th>Protection</th></tr></thead><tbody><% catalog.forEach((item) => { %><tr><td><strong><%= item.resourceKey %></strong><br><small><%= item.description %></small></td><td><%= item.category %></td><td><%= item.tableName %></td><td><%= item.retentionDays %> days</td><td><%= item.sensitive ? 'Sensitive access' : 'Standard access' %></td></tr><% }) %></tbody></table></section>
  <div class="data-grid"><section class="data-panel"><h2>Integrity evidence</h2><table class="data-table"><thead><tr><th>Check</th><th>Status</th><th>Rows</th><th>Checked</th></tr></thead><tbody><% integrity.forEach((item) => { %><tr><td><%= item.checkKey %></td><td class="data-status--<%= item.status %>"><%= item.status %></td><td><%= item.rowsChecked %></td><td><%= item.checkedAt ? new Date(item.checkedAt).toLocaleString() : 'Not run' %></td></tr><% }) %><% if (!integrity.length) { %><tr><td colspan="4">No checks have been run yet.</td></tr><% } %></tbody></table></section><section class="data-panel"><h2>Backup schedules</h2><table class="data-table"><thead><tr><th>Schedule</th><th>Frequency</th><th>Storage</th><th>Encrypted</th></tr></thead><tbody><% schedules.forEach((item) => { %><tr><td><%= item.scheduleKey %></td><td><%= item.frequency %></td><td><%= item.storageProvider %></td><td><%= item.encrypted ? 'Yes' : 'No' %></td></tr><% }) %></tbody></table></section></div>
  <div class="data-grid"><section class="data-panel"><h2>Recovery request</h2><form class="data-form" method="post" action="/admin/data-management/recovery"><label for="targetResource">Target resource</label><select id="targetResource" name="targetResource"><option value="">Full platform recovery</option><% catalog.forEach((item) => { %><option value="<%= item.resourceKey %>"><%= item.resourceKey %></option><% }) %></select><label for="targetEnvironment">Target environment</label><select id="targetEnvironment" name="targetEnvironment"><option value="staging">Staging</option><option value="production">Production</option></select><label for="reason">Reason</label><textarea id="reason" name="reason" required placeholder="Describe the failure or restoration need"></textarea><button class="data-button" type="submit">Submit recovery request</button></form></section><section class="data-panel"><h2>Record lifecycle evidence</h2><form class="data-form" method="post" action="/admin/data-management/archive"><label for="archiveResource">Resource</label><select id="archiveResource" name="resourceKey" required><% catalog.forEach((item) => { %><option value="<%= item.resourceKey %>"><%= item.resourceKey %></option><% }) %></select><input name="recordId" required placeholder="Record ID"><textarea name="snapshot" required placeholder='JSON snapshot, e.g. {"status":"inactive"}'></textarea><input name="reason" required placeholder="Archive reason"><button class="data-button" type="submit">Archive record</button></form></section><section class="data-panel"><h2>Record version</h2><form class="data-form" method="post" action="/admin/data-management/versions"><label for="versionResource">Resource</label><select id="versionResource" name="resourceKey" required><% catalog.forEach((item) => { %><option value="<%= item.resourceKey %>"><%= item.resourceKey %></option><% }) %></select><label for="versionRecordId">Record ID</label><input id="versionRecordId" name="recordId" required placeholder="Record ID"><label for="changeType">Change type</label><select id="changeType" name="changeType"><option value="created">Created</option><option value="updated" selected>Updated</option><option value="deleted">Deleted</option><option value="restored">Restored</option></select><label for="versionSnapshot">Snapshot</label><textarea id="versionSnapshot" name="snapshot" required placeholder='JSON snapshot, e.g. {"status":"active"}'></textarea><button class="data-button" type="submit">Record version</button></form></section></div>
  <section class="data-panel"><h2>Archived records and recovery queue</h2><table class="data-table"><thead><tr><th>Resource</th><th>Record</th><th>Status</th><th>Reason</th><th>Created</th><th>Actions</th></tr></thead><tbody><% archives.forEach((item) => { %><tr><td><%= item.resourceKey %></td><td><%= item.recordId %></td><td><%= item.status %></td><td><%= item.reason %></td><td><%= new Date(item.archivedAt).toLocaleString() %></td><td><% if (item.status === 'archived') { %><form method="post" action="/admin/data-management/archive/<%= item.id %>/status"><input type="hidden" name="status" value="restored"><button class="data-button data-button--quiet" type="submit">Restore evidence</button></form><form method="post" action="/admin/data-management/archive/<%= item.id %>/status"><input type="hidden" name="status" value="purged"><button class="data-button data-button--quiet" type="submit">Purge evidence</button></form><% } %></td></tr><% }); recovery.forEach((item) => { %><tr><td>Recovery</td><td><%= item.targetResource || 'platform' %></td><td><%= item.status %></td><td><%= item.reason %></td><td><%= new Date(item.requestedAt).toLocaleString() %></td><td><% if (item.status === 'requested') { %><form method="post" action="/admin/data-management/recovery/<%= item.id %>/status"><input type="hidden" name="status" value="approved"><button class="data-button data-button--quiet" type="submit">Approve</button></form><% } else if (item.status === 'approved') { %><form method="post" action="/admin/data-management/recovery/<%= item.id %>/status"><input type="hidden" name="status" value="in_progress"><button class="data-button data-button--quiet" type="submit">Start recovery</button></form><% } else if (item.status === 'in_progress') { %><form method="post" action="/admin/data-management/recovery/<%= item.id %>/status"><input type="hidden" name="status" value="completed"><button class="data-button data-button--quiet" type="submit">Complete</button></form><% } %></td></tr><% }) %></tbody></table></section>
  <div class="data-grid"><section class="data-panel"><h2>Version coverage</h2><table class="data-table"><thead><tr><th>Resource</th><th>Versions recorded</th></tr></thead><tbody><% versions.forEach((item) => { %><tr><td><%= item.resourceKey %></td><td><%= item.versions %></td></tr><% }) %></tbody></table></section><section class="data-panel"><h2>Data audit activity</h2><table class="data-table"><thead><tr><th>Event</th><th>Resource</th><th>Outcome</th><th>Time</th></tr></thead><tbody><% auditLogs.slice(0, 12).forEach((item) => { %><tr><td><%= item.eventType %></td><td><%= item.resourceKey || 'platform' %></td><td><%= item.outcome %></td><td><%= new Date(item.createdAt).toLocaleString() %></td></tr><% }) %></tbody></table></section></div>
</main>
