<section class="admin-page"><header class="admin-page__heading"><div><p class="admin-eyebrow">Administration / businesses</p><h1>Business management</h1><p>Review registrations and control verification and platform visibility.</p></div><form class="admin-search" method="get"><input name="search" value="<%= search %>" placeholder="Search business or owner" aria-label="Search businesses"><button type="submit">Search</button></form></header><div class="admin-panel"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Business</th><th>Owner</th><th>Status</th><th>Verification</th><th>Action</th></tr></thead><tbody><% businesses.forEach((business) => { %><tr><td><strong><%= business.business_name %></strong><small><%= business.country_of_registration %> / <%= business.business_type %></small></td><td><%= business.owner_name %></td><td><span class="admin-badge"><%= business.status %></span></td><td><span class="admin-badge"><%= business.verification_status %></span></td><td><form class="admin-inline-form admin-inline-form--wide" method="post" action="/admin/businesses/<%= business.id %>/action"><select name="action" aria-label="Action for <%= business.business_name %>"><option value="approve">Approve</option><option value="verify">Verify</option><option value="restrict">Restrict</option><option value="remove">Remove</option></select><input name="notes" placeholder="Decision note" aria-label="Decision note"><button type="submit">Apply</button></form></td></tr><% }); %></tbody></table></div></div></section>
