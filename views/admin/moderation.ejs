<section class="admin-page"><header class="admin-page__heading"><div><p class="admin-eyebrow">Administration / moderation</p><h1>Content moderation</h1><p>Review reported listings, reviews, and messages. Every decision is recorded.</p></div></header><div class="admin-panel"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Content</th><th>Reason</th><th>Report</th><th>Action</th></tr></thead><tbody><% reports.forEach((report) => { %><tr><td><strong><%= report.content_type %> #<%= report.content_id %></strong><small><%= report.details || 'No additional details' %></small></td><td><%= report.reason %></td><td><%= new Date(report.created_at).toLocaleString() %></td><td><form class="admin-inline-form" method="post" action="/admin/moderation/<%= report.id %>/action"><select name="action"><option value="remove">Remove content</option><option value="resolve">Resolve</option><option value="dismiss">Dismiss</option></select><button type="submit">Record</button></form></td></tr><% }); %><% if (!reports.length) { %><tr><td colspan="4">The moderation queue is clear.</td></tr><% } %></tbody></table></div></div></section>
