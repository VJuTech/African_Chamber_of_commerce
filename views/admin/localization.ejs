<section class="admin-page localization-admin" aria-labelledby="localization-admin-title">
  <header class="admin-page__heading"><div><p class="admin-eyebrow">Administration / platform language</p><h1 id="localization-admin-title">Localization management</h1><p>Maintain the language catalog, translated interface content, display rates, and the localization audit trail.</p></div></header>
  <% if (message) { %><div class="ux-feedback ux-feedback--success" role="status"><%= message %></div><% } %>
  <div class="localization-admin__grid">
    <section class="admin-panel"><div class="admin-panel__heading"><h2>Supported languages</h2></div><div class="localization-admin__rows"><% languages.forEach((language) => { %><form class="localization-admin__row" method="post" action="/admin/localization/languages/<%= language.code %>"><div><strong><%= language.display_name %></strong><small><%= language.code %> / <%= language.native_name %></small></div><select name="enabled"><option value="true" <%= language.is_enabled ? 'selected' : '' %>>Enabled</option><option value="false" <%= !language.is_enabled ? 'selected' : '' %>>Disabled</option></select><button type="submit">Save</button></form><% }); %></div></section>
    <section class="admin-panel"><div class="admin-panel__heading"><h2>Add or update translation</h2></div><form class="localization-admin__form" method="post" action="/admin/localization/translations"><label>Locale<input name="locale" placeholder="fr" required></label><label>Key<input name="translationKey" placeholder="navigation.settings" required></label><label>Value<textarea name="translationValue" rows="3" required></textarea></label><label>Context<input name="context" placeholder="Navigation label"></label><button type="submit">Save translation</button></form></section>
    <section class="admin-panel"><div class="admin-panel__heading"><h2>Exchange rate</h2></div><form class="localization-admin__form" method="post" action="/admin/localization/rates"><label>Base currency<select name="baseCurrency"><% currencies.forEach((currency) => { %><option value="<%= currency.code %>"><%= currency.code %></option><% }); %></select></label><label>Target currency<select name="targetCurrency"><% currencies.forEach((currency) => { %><option value="<%= currency.code %>"><%= currency.code %></option><% }); %></select></label><label>Rate<input name="rate" type="number" min="0.00000001" step="any" required></label><label>Source<input name="source" value="admin" required></label><button type="submit">Record rate</button></form></section>
  </div>
  <section class="admin-panel localization-admin__table"><div class="admin-panel__heading"><h2>Recent translations</h2><span><%= translations.length %> records</span></div><div class="localization-admin__list"><% translations.slice(0, 20).forEach((translation) => { %><div><strong><%= translation.locale %> / <%= translation.translation_key %></strong><span><%= translation.translation_value %></span><small>v<%= translation.version %> <%= translation.updated_by_name || 'system' %></small></div><% }); %></div></section>
  <section class="admin-panel localization-admin__table"><div class="admin-panel__heading"><h2>Localization audit activity</h2></div><div class="localization-admin__list"><% audits.slice(0, 20).forEach((audit) => { %><div><strong><%= audit.event_type %></strong><span><%= audit.locale || 'platform' %></span><small><%= audit.actor_name || 'system' %> / <%= formatDate(audit.created_at) %></small></div><% }); %></div></section>
</section>
