<main class="logging-page">
  <header class="logging-hero"><div><p class="logging-kicker">ACC diagnostics centre</p><h1>Logging &amp; error handling</h1><p>Trace system activity, understand failures, review anomaly alerts, and verify retention controls from one protected surface.</p></div><form class="logging-filter" method="get" action="/admin/logging"><label>Severity<select name="severity"><option value="">All severities</option><option value="critical" <%= severity === 'critical' ? 'selected' : '' %>>Critical</option><option value="warning" <%= severity === 'warning' ? 'selected' : '' %>>Warning</option><option value="info" <%= severity === 'info' ? 'selected' : '' %>>Info</option></select></label><button type="submit">Filter</button></form></header>
  <% if (message) { %><p class="logging-feedback"><%= message %></p><% } %>
  <section class="logging-metrics"><article><span>Events</span><strong><%= counts.total %></strong><small>Hash-chained application records</small></article><article><span>Failures</span><strong><%= counts.failures %></strong><small><%= counts.critical %> critical events</small></article><article><span>Warnings</span><strong><%= counts.warnings %></strong><small>Classified for review</small></article><article><span>Open alerts</span><strong><%= alerts.filter((alert) => alert.status === 'open').length %></strong><small>Anomalies needing attention</small></article></section>
  <div class="logging-grid"><section class="logging-panel logging-panel--wide"><div class="logging-heading"><div><p class="logging-kicker">Centralized stream</p><h2>Application events</h2></div><span>Secure access</span></div><div class="logging-table-wrap"><table class="logging-table"><thead><tr><th>Event</th><th>Severity</th><th>Outcome</th><th>Request</th><th>Recorded</th></tr></thead><tbody><% logs.forEach((log) => { %><tr><td><strong><%= log.eventType %></strong><small><%= log.message %></small></td><td><span class="logging-severity logging-severity--<%= log.severity %>"><%= log.severity %></span></td><td><%= log.outcome %></td><td><%= log.method || '' %> <%= log.path || '' %></td><td><%= new Date(log.createdAt).toLocaleString() %><small><%= log.recordHash.slice(0, 16) %>...</small></td></tr><% }); %><% if (!logs.length) { %><tr><td colspan="5" class="logging-empty">No application events match this filter.</td></tr><% } %></tbody></table></div></section>
  <section class="logging-panel"><div class="logging-heading"><div><p class="logging-kicker">Error response</p><h2>Recent errors</h2></div></div><div class="logging-list"><% errors.slice(0, 12).forEach((error) => { %><div><strong><%= error.errorName || 'Application error' %></strong><span class="logging-severity logging-severity--<%= error.severity %>"><%= error.severity %></span><small><%= error.message %></small><em><%= new Date(error.createdAt).toLocaleString() %></em></div><% }); %><% if (!errors.length) { %><p class="logging-empty">No errors have been recorded.</p><% } %></div></section></div>
  <div class="logging-grid"><section class="logging-panel"><div class="logging-heading"><div><p class="logging-kicker">Monitoring</p><h2>Anomaly alerts</h2></div></div><div class="logging-list"><% alerts.forEach((alert) => { %><div><strong><%= alert.alertType %></strong><span class="logging-severity logging-severity--<%= alert.severity %>"><%= alert.occurrenceCount %> events</span><small><%= alert.message %></small><em><%= alert.status %> &middot; <%= new Date(alert.lastSeenAt).toLocaleString() %></em><% if (alert.status !== 'resolved') { %><form method="post" action="/admin/logging/alerts/<%= alert.id %>"><button name="status" value="acknowledged">Acknowledge</button><button name="status" value="resolved">Resolve</button></form><% } %></div><% }); %><% if (!alerts.length) { %><p class="logging-empty">No anomaly alerts have been detected.</p><% } %></div></section><section class="logging-panel"><div class="logging-heading"><div><p class="logging-kicker">Retention policy</p><h2>Storage controls</h2></div><span>PostgreSQL</span></div><div class="logging-list"><% retention.forEach((policy) => { %><div><strong><%= policy.logType %> logs</strong><span><%= policy.retentionDays %> days</span><small>Active retention window</small></div><% }); %></div><p class="logging-note">Log records are stored centrally in PostgreSQL. Application records include a previous-record reference and SHA-256 hash for tamper evidence.</p></section></div>
</main>
