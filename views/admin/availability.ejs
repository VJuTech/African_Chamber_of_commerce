<section class="availability-page" aria-labelledby="availability-title">
  <header class="availability-hero">
    <div><p class="management-eyebrow">Chapter 37 / Stability layer</p><h1 id="availability-title">Availability &amp; reliability</h1><p>Monitor service health, continuity posture, incidents, failover evidence, and recovery activity from the ACC control room.</p></div>
    <div class="availability-hero__target"><span>30-day observed health</span><strong><%= uptime.rate %>%</strong><small>Target: 99.9% or higher</small></div>
  </header>
  <% if (message) { %><div class="availability-notice" role="status"><%= message %></div><% } %>
  <section class="availability-actions"><div><p class="management-eyebrow">Operator action</p><h2>Run a health pass</h2><p>Checks the PostgreSQL connection and registered service endpoints, then records incidents and recovery actions.</p></div><form method="post" action="/admin/availability/health-checks"><button class="button button--primary" type="submit">Run health checks</button></form></section>
  <section class="availability-section"><div class="availability-heading"><div><p class="management-eyebrow">AVAIL-005 / AVAIL-007</p><h2>Service status</h2></div><span><%= uptime.healthy %> healthy checks / <%= uptime.checks %> total</span></div><div class="availability-services"><% services.forEach((service) => { %><article class="availability-service availability-service--<%= service.lastStatus %>"><div class="availability-service__top"><div><span class="availability-dot"></span><h3><%= service.displayName %></h3></div><strong><%= service.lastStatus %></strong></div><p><%= service.criticality === 'critical' ? 'Core service' : 'Can degrade gracefully' %> · response target <%= service.expectedResponseMs %> ms</p><small><%= service.lastCheckedAt ? new Date(service.lastCheckedAt).toLocaleString() : 'Not checked yet' %></small><% if (service.degradedMode) { %><em>Degraded mode active</em><% } %></article><% }); %></div></section>
  <div class="availability-grid"><section class="availability-section"><div class="availability-heading"><div><p class="management-eyebrow">AVAIL-009 / AVAIL-010</p><h2>Open incidents</h2></div></div><div class="availability-list"><% incidents.filter((item) => item.status !== 'resolved').forEach((incident) => { %><article class="availability-list__row"><div><strong><%= incident.title %></strong><span><%= incident.severity %> · <%= incident.incidentType %> · <%= new Date(incident.detectedAt).toLocaleString() %></span></div><form method="post" action="/admin/availability/incidents/<%= incident.id %>/resolve"><button class="button button--quiet" type="submit">Resolve</button></form></article><% }); %><% if (!incidents.filter((item) => item.status !== 'resolved').length) { %><p class="availability-empty">No open availability incidents.</p><% } %></div></section><section class="availability-section"><div class="availability-heading"><div><p class="management-eyebrow">AVAIL-004 / AVAIL-006</p><h2>Failover &amp; recovery</h2></div></div><div class="availability-list"><% [...failovers, ...recovery].slice(0, 8).forEach((item) => { %><div class="availability-list__row"><div><strong><%= item.serviceName || item.actionType %></strong><span><%= item.triggerType || item.notes || 'Recovery action' %></span></div><em><%= item.outcome || item.status %></em></div><% }); %><% if (!failovers.length && !recovery.length) { %><p class="availability-empty">No failover or recovery actions recorded.</p><% } %></div></section></div>
  <section class="availability-section"><div class="availability-heading"><div><p class="management-eyebrow">AVAIL-003 / AVAIL-008</p><h2>Redundancy &amp; backup posture</h2></div><span>Continuity evidence</span></div><div class="availability-redundancy"><% redundancy.forEach((component) => { %><article><div><strong><%= component.componentKey.replace(/_/g, ' ') %></strong><span><%= component.componentType %></span></div><p><%= component.primaryReference %></p><small>Standby: <%= component.secondaryReference || 'Provider-managed' %></small><em class="availability-badge availability-badge--<%= component.status %>"><%= component.status %> · <%= component.failoverMode %></em></article><% }); %></div></section>
  <section class="availability-section"><div class="availability-heading"><div><p class="management-eyebrow">Latest evidence</p><h2>Health check history</h2></div><a href="/admin/deployment">Open deployment controls &rarr;</a></div><div class="availability-table"><% checks.slice(0, 12).forEach((check) => { %><div><strong><%= check.serviceName %></strong><span class="availability-badge availability-badge--<%= check.status %>"><%= check.status %></span><span><%= check.responseTimeMs %> ms</span><small><%= new Date(check.checkedAt).toLocaleString() %></small></div><% }); %><% if (!checks.length) { %><p class="availability-empty">Run the first health pass to create evidence.</p><% } %></div></section>
</section>
