<main class="performance-page">
  <header class="performance-hero"><div><p class="performance-eyebrow">Chapter 36 / growth readiness layer</p><h1>Performance &amp; scalability</h1><p>Measure response time, throughput, concurrency, capacity, caching, delivery, and optimization from one PostgreSQL-backed operations console.</p></div><a class="performance-button" href="/admin/dashboard">Management dashboard</a></header>
  <% if (message) { %><p class="performance-notice" role="status"><%= message %></p><% } %>
  <div class="performance-grid"><article class="performance-metric"><span>Requests / 24h</span><strong><%= summary.requests %></strong><small>Measured throughput volume</small></article><article class="performance-metric"><span>Average API latency</span><strong><%= summary.api_latency %> ms</strong><small>Target: 500 ms average</small></article><article class="performance-metric"><span>Average page latency</span><strong><%= summary.page_latency %> ms</strong><small>Target: 3,000 ms</small></article><article class="performance-metric"><span>Error rate</span><strong><%= summary.errorRate %>%</strong><small><%= summary.concurrent_users %> active users in period</small></article></div>
  <div class="performance-layout"><div><section class="performance-panel"><h2>Capacity and delivery posture</h2><% profiles.forEach((profile) => { %><form class="performance-profile" method="post" action="/admin/performance/profiles/<%= profile.environmentKey %>"><h3><%= profile.environmentKey %></h3><div class="performance-profile__flags"><label class="performance-check"><input type="checkbox" name="loadBalancerEnabled" <%= profile.loadBalancerEnabled ? 'checked' : '' %>> Load balancing</label><label class="performance-check"><input type="checkbox" name="horizontalScalingEnabled" <%= profile.horizontalScalingEnabled ? 'checked' : '' %>> Horizontal scaling</label><label class="performance-check"><input type="checkbox" name="verticalScalingEnabled" <%= profile.verticalScalingEnabled ? 'checked' : '' %>> Vertical scaling</label><label class="performance-check"><input type="checkbox" name="cacheEnabled" <%= profile.cacheEnabled ? 'checked' : '' %>> Shared cache</label><label class="performance-check"><input type="checkbox" name="cdnEnabled" <%= profile.cdnEnabled ? 'checked' : '' %>> CDN delivery</label></div><div class="performance-profile__flags"><label>Target concurrency<input name="targetConcurrency" type="number" min="1" value="<%= profile.targetConcurrency %>"></label><label>CPU limit %<input name="cpuLimitPercent" type="number" min="1" max="100" value="<%= profile.cpuLimitPercent %>"></label><label>Memory limit %<input name="memoryLimitPercent" type="number" min="1" max="100" value="<%= profile.memoryLimitPercent %>"></label><label>Cache provider<input name="cacheProvider" value="<%= profile.cacheProvider %>"></label><label>CDN provider<input name="cdnProvider" value="<%= profile.cdnProvider || '' %>"></label><button class="performance-button" type="submit">Save <%= profile.environmentKey %> posture</button></div></form><% }) %></section>
  <section class="performance-panel"><h2>Recent request telemetry</h2><table class="performance-table"><thead><tr><th>Request</th><th>Status</th><th>Latency</th><th>Channel</th><th>Time</th></tr></thead><tbody><% recent.forEach((item) => { %><tr><td><%= item.method %> <%= item.path %></td><td class="performance-status--<%= item.error ? 'failed' : 'passed' %>"><%= item.statusCode %></td><td><%= item.responseTimeMs %> ms</td><td><%= item.isApi ? 'API' : 'Page' %></td><td><%= new Date(item.createdAt).toLocaleString() %></td></tr><% }); if (!recent.length) { %><tr><td colspan="5">No request metrics have been captured yet.</td></tr><% } %></tbody></table></section></div>
  <aside><section class="performance-panel"><h2>Peak-load check</h2><form class="performance-form" method="post" action="/admin/performance/peak-load"><label>Environment<select name="environmentKey"><% profiles.forEach((profile) => { %><option value="<%= profile.environmentKey %>"><%= profile.environmentKey %></option><% }) %></select></label><label>Requested concurrency<input name="requestedConcurrency" type="number" min="1" value="100" required></label><button class="performance-button" type="submit">Record capacity check</button></form></section><section class="performance-panel"><h2>Cache health</h2><p><strong><%= cache.entries %></strong> active entries</p><p><strong><%= cache.hits %></strong> recorded cache hits</p><p class="performance-profile__meta">Shared cache is PostgreSQL-backed and expires entries by TTL.</p></section><section class="performance-panel"><h2>Optimization action</h2><form class="performance-form" method="post" action="/admin/performance/optimizations"><label>Title<input name="title" required maxlength="200" placeholder="Add index to directory query"></label><label>Area<select name="area"><option value="query">Query</option><option value="code">Application code</option><option value="cache">Caching</option><option value="infrastructure">Infrastructure</option></select></label><label>Status<select name="status"><option value="planned">Planned</option><option value="in_progress">In progress</option><option value="completed">Completed</option></select></label><label>Baseline response time<input name="baselineResponseTimeMs" type="number" min="0"></label><label>Measured response time<input name="measuredResponseTimeMs" type="number" min="0"></label><textarea name="notes" placeholder="Evidence, query plan, or rollout notes"></textarea><button class="performance-button" type="submit">Record optimization</button></form></section></aside></div>
  <div class="performance-layout"><section class="performance-panel"><h2>Peak-load evidence</h2><table class="performance-table"><thead><tr><th>Environment</th><th>Concurrency</th><th>Latency</th><th>Error rate</th><th>Status</th></tr></thead><tbody><% peakChecks.forEach((item) => { %><tr><td><%= item.environmentKey %></td><td><%= item.requestedConcurrency %></td><td><%= item.averageResponseTimeMs %> ms</td><td><%= item.errorRate %>%</td><td class="performance-status--<%= item.status %>"><%= item.status %></td></tr><% }); if (!peakChecks.length) { %><tr><td colspan="5">No peak-load checks recorded.</td></tr><% } %></tbody></table></section><section class="performance-panel"><h2>Optimization register</h2><table class="performance-table"><thead><tr><th>Action</th><th>Area</th><th>Status</th><th>Before / after</th></tr></thead><tbody><% optimizations.forEach((item) => { %><tr><td><strong><%= item.title %></strong><br><small><%= item.notes || '' %></small></td><td><%= item.area %></td><td><%= item.status %></td><td><%= item.baselineResponseTimeMs || '-' %> / <%= item.measuredResponseTimeMs || '-' %> ms</td></tr><% }); if (!optimizations.length) { %><tr><td colspan="4">No optimization actions recorded.</td></tr><% } %></tbody></table></section></div>
</main>
