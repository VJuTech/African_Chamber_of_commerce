<main class="support-page support-admin">
  <header class="support-hero"><div><p class="support-kicker">ACC operations centre</p><h1>Maintenance &amp; support</h1><p>Coordinate user support, maintenance windows, service levels, and continuous improvement.</p></div><a class="support-button" href="/support">Open help center <span aria-hidden="true">&rarr;</span></a></header>
  <% if (message) { %><p class="support-feedback"><%= message %></p><% } %>
  <section class="support-metrics"><article><span>Total tickets</span><strong><%= metrics.total %></strong><small>PostgreSQL records</small></article><article><span>Open queue</span><strong><%= metrics.open %></strong><small>Awaiting first action</small></article><article><span>Critical</span><strong><%= metrics.critical %></strong><small>Priority attention</small></article><article><span>SLA breaches</span><strong><%= Number(metrics.overdue_response) + Number(metrics.overdue_resolution) %></strong><small>Response or resolution overdue</small></article></section>
  <div class="support-admin-grid"><section class="support-panel support-panel--wide"><div class="support-section__heading"><div><p class="support-kicker">Ticket operations</p><h2>Support queue</h2></div><span>Manage status and ownership</span></div><div class="support-table-wrap"><table class="support-table"><thead><tr><th>Ticket</th><th>Priority</th><th>Status</th><th>Reporter</th><th>Action</th></tr></thead><tbody><% tickets.forEach((ticket) => { %><tr><td><strong><%= ticket.ticketNumber %></strong><small><%= ticket.title %></small></td><td><span class="support-priority support-priority--<%= ticket.priority %>"><%= ticket.priority %></span></td><td><span class="support-status support-status--<%= ticket.status %>"><%= ticket.status.replace('_', ' ') %></span></td><td><%= ticket.reporterName %></td><td><form class="support-inline-form" method="post" action="/admin/support/tickets/<%= ticket.id %>"><select name="status" aria-label="Update <%= ticket.ticketNumber %> status"><option value="open" <%= ticket.status === 'open' ? 'selected' : '' %>>Open</option><option value="in_progress" <%= ticket.status === 'in_progress' ? 'selected' : '' %>>In progress</option><option value="resolved" <%= ticket.status === 'resolved' ? 'selected' : '' %>>Resolved</option><option value="closed" <%= ticket.status === 'closed' ? 'selected' : '' %>>Closed</option></select><button type="submit" title="Update ticket">Save</button></form></td></tr><% }); %><% if (!tickets.length) { %><tr><td colspan="5" class="support-empty">No support tickets have been reported.</td></tr><% } %></tbody></table></div></section>
  <section class="support-panel"><div class="support-section__heading"><div><p class="support-kicker">Planned work</p><h2>Schedule maintenance</h2></div></div><form class="support-form support-form--compact" method="post" action="/admin/support/maintenance"><label>Window title<input name="title" required maxlength="220"></label><label>Description<textarea name="description" rows="3"></textarea></label><label>Maintenance type<select name="maintenanceType"><option value="preventive">Preventive</option><option value="corrective">Corrective</option><option value="adaptive">Adaptive</option><option value="perfective">Perfective</option></select></label><div class="support-form__grid"><label>Starts<input type="datetime-local" name="startsAt" required></label><label>Ends<input type="datetime-local" name="endsAt" required></label></div><label class="support-check"><input type="checkbox" name="notifyUsers" checked> Notify users</label><button class="support-button" type="submit">Schedule window <span aria-hidden="true">&rarr;</span></button></form></section></div>
  <div class="support-admin-grid"><section class="support-panel"><div class="support-section__heading"><div><p class="support-kicker">Continuity</p><h2>Maintenance windows</h2></div></div><div class="support-list"><% windows.forEach((window) => { %><div><strong><%= window.title %></strong><small><%= window.maintenanceType %> &middot; <%= window.status %></small><span><%= new Date(window.startsAt).toLocaleString() %></span></div><% }); %><% if (!windows.length) { %><p class="support-empty">No maintenance windows scheduled.</p><% } %></div></section><section class="support-panel"><div class="support-section__heading"><div><p class="support-kicker">Improvement loop</p><h2>Recent changes</h2></div></div><div class="support-list"><% logs.slice(0, 8).forEach((log) => { %><div><strong><%= log.summary %></strong><small><%= log.eventType %></small><span><%= new Date(log.createdAt).toLocaleString() %></span></div><% }); %><% if (!logs.length) { %><p class="support-empty">No maintenance activity has been logged.</p><% } %></div></section></div>
</main>
