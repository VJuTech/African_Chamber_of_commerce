<section class="admin-page"><header class="admin-page__heading"><div><p class="admin-eyebrow">Administration / reporting</p><h1><%= reportType %> report</h1><p>Current data queried directly from PostgreSQL.</p></div><a class="admin-button" href="/admin/reports/<%= reportType %>?format=csv">Export CSV</a></header><div class="admin-panel"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><% if (rows.length) { Object.keys(rows[0]).forEach((key) => { %><th><%= key.replaceAll('_', ' ') %></th><% }); } %></tr></thead><tbody><% rows.forEach((row) => { %><tr><% Object.keys(rows[0]).forEach((key) => { %><td><%= row[key] == null ? '' : row[key] %></td><% }); %></tr><% }); %></tbody></table></div></div></section>
