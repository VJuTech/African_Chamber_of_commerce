<section class="admin-control" aria-labelledby="admin-control-title">
  <header class="admin-control__hero"><div><p class="admin-eyebrow">Chapter 26 / control center</p><h1 id="admin-control-title">ACC administration</h1><p>Live operational visibility across members, commerce, content, configuration, and compliance.</p></div><span class="admin-live-status">PostgreSQL source of truth</span></header>
  <% if (message) { %><div class="admin-alert" role="status"><%= message %></div><% } %>
  <div class="admin-stat-grid"><article><span>All users</span><strong><%= counts.users %></strong><small><%= counts.active_users %> active in the last 24 hours</small></article><article><span>Businesses</span><strong><%= counts.businesses %></strong><small><%= counts.pending_businesses %> awaiting attention</small></article><article><span>Active listings</span><strong><%= counts.active_listings %></strong><small>Currently visible on marketplace</small></article><article><span>Transactions</span><strong><%= counts.transactions %></strong><small>Orders in the last 30 days</small></article><article><span>Payment volume</span><strong><%= counts.payment_volume %></strong><small>Successful recorded payments</small></article><article><span>Moderation queue</span><strong><%= counts.moderation_queue %></strong><small>Open reports requiring review</small></article></div>
  <nav class="admin-module-grid" aria-label="Administration modules"><a href="/admin/analytics"><strong>Analytics intelligence</strong><span>Global KPIs, trends, and exports</span></a><a href="/admin/security"><strong>Security monitoring</strong><span>Authentication, alerts, lockouts, and audit evidence</span></a><a href="/admin/users"><strong>User management</strong><span>Suspend, activate, and assign roles</span></a><a href="/admin/businesses"><strong>Business management</strong><span>Approve, verify, restrict, or remove</span></a><a href="/admin/moderation"><strong>Content moderation</strong><span>Review listings, reviews, and messages</span></a><a href="/admin/settings"><strong>System configuration</strong><span>Settings, modules, and feature flags</span></a><a href="/admin/reports/users"><strong>Reports and exports</strong><span>Users, transactions, and financial records</span></a><a href="/admin/logs"><strong>System logs</strong><span>Search platform and administrative events</span></a></nav>
  <section class="admin-panel"><div class="admin-panel__heading"><div><p class="admin-eyebrow">Activity stream</p><h2>Administrative actions</h2></div><a href="/admin/logs">Search logs &rarr;</a></div><div class="admin-log-list"><% activity.forEach((item) => { %><div><strong><%= item.action %></strong><span><%= item.resource_type %> <%= item.resource_id || '' %></span><time><%= new Date(item.created_at).toLocaleString() %></time></div><% }); %><% if (!activity.length) { %><p>No administrative actions recorded yet.</p><% } %></div></section>
</section>
