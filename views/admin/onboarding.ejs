<main class="onb-page">
  <section class="onb-hero">
    <div><p class="onb-kicker">ACC growth operations</p><h1>Onboarding &amp; migration</h1><p>Move members and businesses into ACC with durable validation, import progress, API sources, and human-assisted follow-up.</p></div>
    <div><span class="onb-pill"><%= counts.activeJobs %> active jobs</span></div>
  </section>
  <% if (message) { %><p class="onb-feedback"><%= message %></p><% } %>
  <section class="onb-metrics" aria-label="Onboarding metrics"><article><span>Jobs</span><strong><%= counts.jobs %></strong><small>migration jobs recorded</small></article><article><span>Active</span><strong><%= counts.activeJobs %></strong><small>jobs in progress</small></article><article><span>Imported</span><strong><%= counts.imported %></strong><small>records created</small></article><article><span>Errors</span><strong><%= counts.errors %></strong><small>rows needing review</small></article><article><span>Assistance</span><strong><%= counts.assistance %></strong><small>open guided tasks</small></article></section>
  <div class="onb-grid">
    <section class="onb-panel"><div class="onb-heading"><h2>Bulk file import</h2><span class="onb-pill">CSV / XLSX</span></div><form class="onb-form" action="/admin/onboarding/files" method="post" enctype="multipart/form-data"><label>Record type<select name="importType" required><option value="users">Users</option><option value="businesses">Businesses</option></select></label><label>Source file<input type="file" name="migrationFile" accept=".csv,.xlsx,.xls" required></label><button type="submit">Validate and import file</button></form><small>Imports are staged, validated row by row, and audited in PostgreSQL. User passwords are converted to hashes and never displayed.</small></section>
    <section class="onb-panel"><div class="onb-heading"><h2>Register API source</h2><span class="onb-pill">Controlled source</span></div><form class="onb-form" action="/admin/onboarding/api-sources" method="post"><label>Source key<input name="sourceKey" required placeholder="partner-crm"></label><label>Source name<input name="sourceName" required placeholder="Partner CRM"></label><label>Record type<select name="importType" required><option value="users">Users</option><option value="businesses">Businesses</option></select></label><label>Endpoint URL<input type="url" name="endpointUrl" placeholder="https://partner.example/api/export"></label><button type="submit">Save API source</button></form></section>
    <section class="onb-panel onb-panel--wide"><div class="onb-heading"><h2>Migration jobs</h2><span class="onb-pill">PostgreSQL progress</span></div><div class="onb-table-wrap"><table class="onb-table"><thead><tr><th>Job</th><th>Type</th><th>Status</th><th>Rows</th><th>Imported</th><th>Errors</th><th>Created</th></tr></thead><tbody><% jobs.forEach((job) => { %><tr><td><strong><%= job.jobKey %></strong><small><%= job.sourceName || job.sourceType %></small></td><td><%= job.importType %></td><td><span class="onb-pill <%= job.status.includes('error') || job.status === 'failed' ? 'onb-pill--error' : '' %>"><%= job.status %></span></td><td><%= job.processedRows %>/<%= job.totalRows %></td><td><%= job.importedRows %></td><td><%= job.errorRows %></td><td><%= new Date(job.createdAt).toLocaleString() %></td></tr><% }); %><% if (!jobs.length) { %><tr><td colspan="7">No migration jobs have been created.</td></tr><% } %></tbody></table></div></section>
    <section class="onb-panel"><div class="onb-heading"><h2>Assisted onboarding</h2><span class="onb-pill">Operator tasks</span></div><form class="onb-form" action="/admin/onboarding/assistance" method="post"><label>Subject type<select name="subjectType"><option value="user">User</option><option value="business">Business</option><option value="migration_job">Migration job</option></select></label><label>Subject ID<input name="subjectId" type="number" min="1" required></label><label>Task title<input name="taskTitle" required placeholder="Help complete business verification"></label><label>Notes<textarea name="notes"></textarea></label><button type="submit">Create assistance task</button></form></section>
    <section class="onb-panel"><div class="onb-heading"><h2>Rows requiring review</h2><span class="onb-pill onb-pill--error"><%= errors.length %></span></div><div class="onb-list"><% errors.slice(0,10).forEach((item) => { %><article><strong><%= item.jobKey %> · row <%= item.rowNumber %></strong><span><%= Array.isArray(item.errors) ? item.errors.join('; ') : item.errors %></span></article><% }); %><% if (!errors.length) { %><p>No migration errors are waiting for review.</p><% } %></div></section>
  </div>
</main>
