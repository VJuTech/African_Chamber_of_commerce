<section class="admin-page"><header class="admin-page__heading"><div><p class="admin-eyebrow">Administration / users</p><h1>User management</h1><p>Control account access and review normalized platform roles.</p></div><form class="admin-search" method="get"><input name="search" value="<%= search %>" placeholder="Search name, email, or role" aria-label="Search users"><button type="submit">Search</button></form></header><div class="admin-panel"><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>User</th><th>Status</th><th>Roles</th><th>Last login</th><th>Action</th></tr></thead><tbody><% users.forEach((account) => { %><tr><td><strong><%= account.name %></strong><small><%= account.email %></small></td><td><span class="admin-badge"><%= account.status %></span></td><td><%= account.assigned_roles || account.role %></td><td><%= account.last_login_at ? new Date(account.last_login_at).toLocaleString() : 'Never' %></td><td><form class="admin-inline-form" method="post" action="/admin/users/<%= account.id %>/status"><select name="status" aria-label="Status for <%= account.name %>"><option value="active" <%= account.status === 'active' ? 'selected' : '' %>>Active</option><option value="suspended" <%= account.status === 'suspended' ? 'selected' : '' %>>Suspended</option><option value="inactive" <%= account.status === 'inactive' ? 'selected' : '' %>>Inactive</option></select><button type="submit">Save</button></form></td></tr><% }); %></tbody></table></div></div></section>
