<!-- Chapter 23 contract creation and template selection form. -->
<div class="contract-shell">
  <section class="contract-hero"><div><p class="contract-kicker">Chapter 23 / New agreement</p><h1>Create a contract</h1><p>Capture the parties, obligations, dates, and commercial references for a new agreement.</p></div><a class="contract-button contract-button--secondary" href="/contracts">Back to contracts</a></section>
  <section class="contract-panel"><form class="contract-form" method="post" action="/contracts/create"><div class="contract-form__grid"><div class="contract-field contract-field--full"><label for="title">Contract title</label><input id="title" name="title" type="text" maxlength="255" required placeholder="e.g. Pan-African supply agreement" /></div><div class="contract-field contract-field--full"><label for="description">Description</label><textarea id="description" name="description" required placeholder="Summarize the commercial purpose of this agreement."></textarea></div><div class="contract-field"><label for="partyIds">Party IDs</label><input id="partyIds" name="partyIds" type="text" required placeholder="Example: 100, 200" /><small class="contract-help">Include all participating ACC user IDs.</small></div><div class="contract-field"><label for="templateType">Contract template</label><select id="templateType" name="templateType"><% Object.keys(templates).forEach(function(key) { %><option value="<%= key %>"><%= templates[key].name %></option><% }) %></select></div><div class="contract-field"><label for="effectiveDate">Effective date</label><input id="effectiveDate" name="effectiveDate" type="date" required /></div><div class="contract-field"><label for="expirationDate">Expiration date</label><input id="expirationDate" name="expirationDate" type="date" required /></div><div class="contract-field"><label for="procurementOrderId">Procurement order ID</label><input id="procurementOrderId" name="procurementOrderId" type="number" value="<%= selectedOrder ? selectedOrder.id : '' %>" placeholder="Optional" /></div><div class="contract-field"><label for="orderId">ACC order ID</label><input id="orderId" name="orderId" type="number" placeholder="Optional" /></div><div class="contract-field"><label for="paymentId">Payment ID</label><input id="paymentId" name="paymentId" type="number" placeholder="Optional" /></div><div class="contract-field"><label for="scopeOfWork">Scope of work</label><textarea id="scopeOfWork" name="scopeOfWork" placeholder="Describe deliverables and responsibilities."></textarea></div><div class="contract-field"><label for="paymentTerms">Payment terms</label><textarea id="paymentTerms" name="paymentTerms" placeholder="Describe amount, currency, timing, and conditions."></textarea></div><div class="contract-field contract-field--full"><label for="deliveryObligations">Delivery obligations</label><textarea id="deliveryObligations" name="deliveryObligations"></textarea></div><div class="contract-field contract-field--full"><label for="penaltiesConditions">Penalties and conditions</label><textarea id="penaltiesConditions" name="penaltiesConditions"></textarea></div></div><div class="contract-actions"><button class="contract-button" type="submit">Save draft</button><a class="contract-button contract-button--quiet" href="/contracts">Cancel</a></div></form></section>
</div>
