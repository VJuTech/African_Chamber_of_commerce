<!-- Chapter 23 contract workspace for authorized business parties. -->
<div class="contract-shell">
  <section class="contract-hero"><div><p class="contract-kicker">Chapter 23 / Legal backbone</p><h1>Contracts</h1><p>Create, share, sign, and monitor legally structured agreements connected to ACC commerce.</p></div><a class="contract-button" href="/contracts/create">Create contract</a></section>
  <% if (message) { %><div class="contract-notice"><%= message %></div><% } %>
  <section class="contract-panel"><div class="contract-panel__header"><div><h2>My contracts</h2><p>Only contracts where you are a participating party are shown.</p></div></div><% if (contracts.length) { %><ul class="contract-list"><% contracts.forEach(function(contract) { %><li class="contract-list__item"><h3><a href="/contracts/<%= contract.id %>"><%= contract.title %></a></h3><p class="contract-meta"><span><%= contract.reference %></span><span><%= contract.templateType %></span><span>Version <%= contract.version %></span><span class="contract-status contract-status--<%= contract.status %>"><%= contract.status.replace(/_/g, ' ') %></span></p><p class="contract-meta"><span>Effective <%= contract.effectiveDate %></span><span>Expires <%= contract.expirationDate %></span></p></li><% }) %></ul><% } else { %><p class="contract-help">No contracts are associated with your account yet.</p><% } %></section>
</div>
