<!-- Chapter 23 contract detail, lifecycle, signature, version, and document page. -->
<div class="contract-shell">
  <section class="contract-hero"><div><p class="contract-kicker"><%= contract.reference %> / <%= contract.templateType %></p><h1><%= contract.title %></h1><p><%= contract.description %></p></div><a class="contract-button contract-button--secondary" href="/contracts">Back to contracts</a></section>
  <% if (message) { %><div class="contract-notice"><%= message %></div><% } %>
  <div class="contract-grid"><section class="contract-panel"><div class="contract-panel__header"><div><h2>Agreement overview</h2><p>Commercial terms and lifecycle status.</p></div><span class="contract-status contract-status--<%= contract.status %>"><%= contract.status.replace(/_/g, ' ') %></span></div><dl class="contract-summary"><div><dt>Parties</dt><dd><%= contract.partyIds.join(', ') %></dd></div><div><dt>Effective date</dt><dd><%= contract.effectiveDate %></dd></div><div><dt>Expiration date</dt><dd><%= contract.expirationDate %></dd></div><div><dt>Scope of work</dt><dd><%= contract.scopeOfWork %></dd></div><div><dt>Payment terms</dt><dd><%= contract.paymentTerms %></dd></div><div><dt>Delivery obligations</dt><dd><%= contract.deliveryObligations %></dd></div><div><dt>Penalties and conditions</dt><dd><%= contract.penaltiesConditions %></dd></div><div><dt>Linked records</dt><dd>Procurement: <%= contract.procurementOrderId || 'None' %> · Order: <%= contract.orderId || 'None' %> · Payment: <%= contract.paymentId || 'None' %></dd></div></dl><div class="contract-actions"><% if (contract.status === 'draft') { %><form method="post" action="/contracts/<%= contract.id %>/template"><input type="hidden" name="templateType" value="<%= contract.templateType %>" /><button class="contract-button" type="submit">Generate from template</button></form><% } %><% if (['draft', 'pending_signature'].includes(contract.status)) { %><a class="contract-button contract-button--quiet" href="/contracts/<%= contract.id %>/sign">Review and sign</a><form method="post" action="/contracts/<%= contract.id %>/share"><button class="contract-button" type="submit">Share for signatures</button></form><% } %><% if (['draft', 'pending_signature'].includes(contract.status)) { %><form method="post" action="/contracts/<%= contract.id %>/modify"><input type="hidden" name="content" value="<%= contract.content %>" /><button class="contract-button contract-button--quiet" type="submit">Save current version</button></form><% } %><% if (['active', 'pending_signature'].includes(contract.status)) { %><form method="post" action="/contracts/<%= contract.id %>/terminate"><input type="hidden" name="reason" value="Termination requested by contract party." /><button class="contract-button contract-button--secondary" type="submit">Terminate contract</button></form><% } %></div></section>
    <section class="contract-panel"><div class="contract-panel__header"><div><h2>Contract document</h2><p>Version <%= contract.version %> · Generated content and stored supporting files.</p></div></div><div class="contract-document"><%= contract.content || 'Generate a template to create the contract document.' %></div><form class="contract-form" method="post" action="/contracts/<%= contract.id %>/documents" enctype="multipart/form-data"><div class="contract-field"><label for="contractDocument">Supporting document</label><input id="contractDocument" name="contractDocument" type="file" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" required /></div><div class="contract-field"><label for="documentType">Document type</label><select id="documentType" name="documentType"><option value="main">Main contract</option><option value="attachment">Supporting attachment</option><option value="proof">Execution proof</option></select></div><button class="contract-button contract-button--quiet" type="submit">Store document securely</button></form><% if (documents.length) { %><ul class="contract-document-list"><% documents.forEach(function(document) { %><li><span><%= document.fileName %> · <%= document.documentType %></span><a href="/contracts/<%= contract.id %>/documents/<%= document.id %>">Download</a></li><% }) %></ul><% } %></section>
    <section class="contract-panel contract-panel--wide"><div class="contract-panel__header"><div><h2>Signature status</h2><p>Every signature is tied to the current contract version.</p></div></div><% if (signatures.length) { %><% signatures.forEach(function(signature) { %><article class="contract-signature"><div class="contract-signature__details"><strong>Party <%= signature.signerId %></strong><p><%= signature.status %><%= signature.signedAt ? ' · ' + signature.signedAt : '' %></p></div><% if (signature.status === 'pending' && contract.status === 'pending_signature' && Number(signature.signerId) === Number(user.id)) { %><a class="contract-button" href="/contracts/<%= contract.id %>/sign">Sign now</a><% } else { %><span class="contract-status"><%= signature.status %></span><% } %></article><% }) %><% } else { %><p class="contract-help">Share the draft to request signatures.</p><% } %></section>
  </div>
</div>
