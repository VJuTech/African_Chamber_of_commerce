<!-- Chapter 23 focused electronic signature page. -->
<div class="contract-shell"><section class="contract-hero"><div><p class="contract-kicker"><%= contract.reference %> / Signature</p><h1>Review and sign</h1><p>Confirm that you have reviewed the agreement before recording your electronic signature.</p></div><a class="contract-button contract-button--secondary" href="/contracts/<%= contract.id %>">Back to contract</a></section><section class="contract-panel"><h2><%= contract.title %></h2><p class="contract-help">Version <%= contract.version %> · Effective <%= contract.effectiveDate %> · Expires <%= contract.expirationDate %></p><div class="contract-document"><%= contract.content || 'The contract body has not been generated yet.' %></div><form class="contract-form" method="post" action="/contracts/<%= contract.id %>/sign"><div class="contract-field"><label for="signatureText">Electronic signature confirmation</label><input id="signatureText" name="signatureText" type="text" required placeholder="Type your full legal name" /><small class="contract-help">A cryptographic hash of this confirmation, contract version, and signer is recorded for verification.</small></div><button class="contract-button" type="submit">Sign contract</button></form></section></div>
