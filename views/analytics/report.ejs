<section class="analytics-page"><header class="analytics-hero"><div><p class="analytics-eyebrow">Analytics / report</p><h1><%= type %> report</h1><p>Results from <%= bounds.start.toISOString().slice(0, 10) %> through <%= bounds.end.toISOString().slice(0, 10) %>.</p></div><div class="analytics-export-links"><a href="?from=<%= from %>&to=<%= to %>&format=csv">CSV</a><a href="?from=<%= from %>&to=<%= to %>&format=xlsx">Excel</a><a href="?from=<%= from %>&to=<%= to %>&format=pdf">PDF</a></div></header><section class="analytics-panel"><div class="analytics-table-wrap"><table class="analytics-table"><thead><tr><% if (rows.length) { Object.keys(rows[0]).forEach((key) => { %><th><%= key.replaceAll('_', ' ') %></th><% }); } %></tr></thead><tbody><% rows.forEach((row) => { %><tr><% Object.keys(rows[0]).forEach((key) => { %><td><%= row[key] == null ? '' : row[key] %></td><% }); %></tr><% }); %><% if (!rows.length) { %><tr><td>No records found for this period.</td></tr><% } %></tbody></table></div></section></section>
