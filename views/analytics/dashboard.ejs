<section class="analytics-page" data-analytics-page data-refresh-url="<%= refreshUrl %>">
  <header class="analytics-hero"><div><p class="analytics-eyebrow"><%= global ? 'Administration / intelligence' : 'Business intelligence' %></p><h1><%= global ? 'Platform analytics' : 'Business analytics' %></h1><p>Accurate, date-scoped insight from ACC activity, commerce, listings, and payments.</p></div><span class="analytics-live"><i></i>Live database view</span></header>
  <form class="analytics-filters" method="get" action="<%= global ? '/admin/analytics' : '/analytics' %>"><label>From<input type="date" name="from" value="<%= from %>"></label><label>To<input type="date" name="to" value="<%= to %>"></label><button type="submit">Apply range</button></form>
  <div class="analytics-kpis"><article><span>Active users</span><strong data-kpi="active_users"><%= kpis.active_users %></strong><small>Distinct activity in range</small></article><article><span>New users</span><strong data-kpi="new_users"><%= kpis.new_users %></strong><small>Registrations in range</small></article><article><span>Transactions</span><strong data-kpi="transactions"><%= kpis.transactions %></strong><small>Orders in range</small></article><article><span>Revenue</span><strong data-kpi="revenue"><%= kpis.revenue %></strong><small>Successful payments</small></article><article><span>Payment success</span><strong><%= kpis.successful_payments %></strong><small><%= kpis.failed_payments %> failed</small></article></div>
  <div class="analytics-grid"><section class="analytics-panel analytics-panel--wide"><div class="analytics-panel__heading"><div><p class="analytics-eyebrow">Trend analysis</p><h2>Daily activity</h2></div><span data-refresh-status>Updated now</span></div><div class="analytics-chart" data-trend-chart><% daily.forEach((point) => { const chartLevel = Math.min(8, Math.max(1, Number(point.transactions_count) || 1)); %><div class="analytics-bar analytics-bar--<%= chartLevel %>" title="<%= point.day %>: <%= point.transactions_count %> transactions"><span><%= point.transactions_count %></span><small><%= point.day %></small></div><% }); %></div></section><section class="analytics-panel"><div class="analytics-panel__heading"><div><p class="analytics-eyebrow">Engagement</p><h2>Activity mix</h2></div></div><div class="analytics-list"><% engagement.forEach((item) => { %><div><strong><%= item.event_name %></strong><span><%= item.count %></span></div><% }); %><% if (!engagement.length) { %><p>No tracked activity in this period.</p><% } %></div></section></div>
  <section class="analytics-panel"><div class="analytics-panel__heading"><div><p class="analytics-eyebrow">Reporting</p><h2>Exportable reports</h2></div></div><div class="analytics-report-links"><% ['sales','users','financial'].forEach((type) => { %><a href="<%= global ? '/admin' : '' %>/analytics/reports/<%= type %>?from=<%= from %>&to=<%= to %>"><strong><%= type %> report</strong><small>View, filter, and export</small></a><% }); %></div></section>
  <% if (!global && businesses.length) { %><section class="analytics-panel"><div class="analytics-panel__heading"><div><p class="analytics-eyebrow">Business access</p><h2>Authorized businesses</h2></div></div><div class="analytics-business-list"><% businesses.forEach((business) => { %><span><%= business.business_name %></span><% }); %></div></section><% } %>
</section>
<script src="/scripts/analytics.js" defer></script>
