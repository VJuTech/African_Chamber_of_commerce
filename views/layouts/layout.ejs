<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Include the shared head partial with metadata and styling. -->
    <%- include('../Partials/head') %>
  </head>
  <body>
    <!-- Shared navigation bar for the application shell. -->
    <nav class="navbar" aria-label="Main navigation">
      <a class="brand" href="/" aria-label="African Chamber of Commerce home">
        <img src="/images/site/acc-logo (1).png" alt="African Chamber of Commerce logo" class="brand__logo" />
        <span class="brand__text">African Chamber of Commerce</span>
      </a>

      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primaryNav" aria-label="Toggle navigation">
        <span class="nav-toggle__line"></span>
        <span class="nav-toggle__line"></span>
        <span class="nav-toggle__line"></span>
      </button>

      <div class="nav-links" id="primaryNav">
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/">Home</a>
          <a href="/dashboard">Dashboard</a>
          <a href="/marketplace">Marketplace</a>
          <a href="/subscriptions">Subscriptions</a>
          <a href="/directory">Discover</a>
          <a href="/trust">Trust</a>
          <a href="/network">Networking</a>
          <a href="/assistant">ACC Assistance</a>
          <a href="/profile">My Profile</a>
          <a href="/messages">Messages</a>
          <a href="/logout">Logout</a>
        <% } else { %>
          <a href="/">Home</a>
          <a href="/directory">Discover</a>
          <a href="/assistant">ACC Assistance</a>
          <a href="/network">Networking</a>
          <a href="/login">Login</a>
          <a href="/register">Register</a>
        <% } %>
      </div>
    </nav>

    <!-- Main content area where page-specific templates are rendered. -->
    <main class="container">
      <%- body %>
    </main>

    <%- include('../Partials/footer') %>

    <div class="global-assistant-widget" id="globalAssistantWidget">
      <button class="global-assistant-toggle" type="button" aria-expanded="false" aria-controls="globalAssistantPanel">Chat</button>
      <div class="global-assistant-panel" id="globalAssistantPanel" aria-live="polite">
        <div class="global-assistant-header">
          <strong>ACC Assistant</strong>
          <button type="button" class="global-assistant-close" aria-label="Close assistant">×</button>
        </div>
        <div class="assistant-quick-actions">
          <button type="button" class="assistant-quick-chip" data-question="How do I join ACC?">How do I join ACC?</button>
          <button type="button" class="assistant-quick-chip" data-question="How do I connect with businesses?">Connect with businesses</button>
          <button type="button" class="assistant-quick-chip" data-question="How do I register a business?">Register a business</button>
        </div>
        <div class="global-assistant-messages">
          <div class="assistant-message assistant-message--bot">Hello! Ask me about ACC membership, networking, or business growth.</div>
        </div>
        <form class="global-assistant-form" id="globalAssistantForm">
          <textarea name="question" rows="3" placeholder="Ask ACC..." required></textarea>
          <button type="submit">Send</button>
        </form>
      </div>
    </div>

    <!-- Shared JavaScript keeps form enhancements out of the templates. -->
    <script src="/scripts/app.js" defer></script>
    <script>
      (function () {
        const widget = document.getElementById('globalAssistantWidget');
        const toggle = document.querySelector('.global-assistant-toggle');
        const panel = document.getElementById('globalAssistantPanel');
        const closeButton = document.querySelector('.global-assistant-close');
        const form = document.getElementById('globalAssistantForm');
        const messages = document.querySelector('.global-assistant-messages');

        if (widget && toggle && panel && form && messages) {
          toggle.addEventListener('click', function () {
            const isOpen = panel.classList.toggle('is-open');
            toggle.setAttribute('aria-expanded', String(isOpen));
          });

          if (closeButton) {
            closeButton.addEventListener('click', function () {
              panel.classList.remove('is-open');
              toggle.setAttribute('aria-expanded', 'false');
            });
          }

          const sendMessage = async function (value) {
            const userMessage = document.createElement('div');
            userMessage.className = 'assistant-message assistant-message--user';
            userMessage.textContent = value;
            messages.appendChild(userMessage);

            const typing = document.createElement('div');
            typing.className = 'assistant-message assistant-message--bot assistant-message--typing';
            typing.innerHTML = '<span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span>';
            messages.appendChild(typing);
            messages.scrollTop = messages.scrollHeight;

            const response = await fetch('/assistant', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify({ question: value })
            });

            const data = await response.json();
            typing.remove();

            const botMessage = document.createElement('div');
            botMessage.className = 'assistant-message assistant-message--bot';
            botMessage.textContent = data.answer || 'I can help with ACC membership, networking, and business growth.';
            messages.appendChild(botMessage);
            messages.scrollTop = messages.scrollHeight;
          };

          form.addEventListener('submit', async function (event) {
            event.preventDefault();
            const textarea = form.querySelector('textarea');
            const value = (textarea && textarea.value || '').trim();
            if (!value) return;

            textarea.value = '';
            await sendMessage(value);
          });

          document.querySelectorAll('.assistant-quick-chip').forEach(function (chip) {
            chip.addEventListener('click', function () {
              const question = chip.getAttribute('data-question') || chip.textContent;
              if (!question) return;
              sendMessage(question);
            });
          });
        }
      })();
    </script>
    <% if (typeof pageScript !== 'undefined' && pageScript) { %>
      <script src="<%= pageScript %>" defer></script>
    <% } %>
  </body>
</html>
