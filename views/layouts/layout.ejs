<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Include the shared head partial with metadata and styling. -->
    <%- include('../Partials/head') %>
  </head>
  <body>
    <!-- Shared navigation bar for the application shell. -->
    <nav class="navbar" aria-label="Main navigation">
      <a class="brand" href="/" aria-label="African Chamber of Commerce home">
        <img src="/images/site/acc-logo (1).png" alt="African Chamber of Commerce logo" class="brand__logo" />
        <span class="brand__text">African Chamber of Commerce</span>
      </a>

      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primaryNav" aria-label="Toggle navigation">
        <span class="nav-toggle__line"></span>
        <span class="nav-toggle__line"></span>
        <span class="nav-toggle__line"></span>
      </button>

      <div class="nav-links" id="primaryNav">
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/">Home</a>
          <div class="nav-menu" data-nav-menu>
            <button class="nav-menu__trigger" type="button" aria-expanded="false" aria-controls="memberMenu">Explore <span aria-hidden="true">+</span></button>
            <div class="nav-menu__panel" id="memberMenu">
              <div class="nav-menu__intro"><span class="nav-menu__label">Member workspace</span><strong>Move business forward</strong><p>Find opportunities, partners, and practical tools in one place.</p></div>
              <div class="nav-menu__groups">
                <div class="nav-menu__group"><span>Discover</span><a href="/dashboard">Dashboard<small>Your ACC overview</small></a><a href="/directory">Business directory<small>Find verified companies</small></a><a href="/network">Networking<small>Build valuable connections</small></a></div>
                <div class="nav-menu__group"><span>Trade</span><a href="/marketplace">Marketplace<small>Buy and sell across Africa</small></a><a href="/procurement">Procurement<small>Source from trusted suppliers</small></a><a href="/contracts">Contracts<small>Manage signed agreements</small></a><a href="/logistics">Logistics<small>Track delivery and fulfillment</small></a><a href="/orders">Orders<small>Review commerce activity</small></a></div>
                <div class="nav-menu__group"><span>Member services</span><a href="/subscriptions">Subscriptions<small>Plans, billing, and benefits</small></a><a href="/analytics">Analytics<small>Business insights and reports</small></a><a href="/disputes">Dispute resolution<small>Protect a transaction</small></a><a href="/trust">Trust<small>Reputation and reviews</small></a><a href="/assistant">ACC Assistance<small>Get platform guidance</small></a></div>
              </div>
            </div>
          </div>
          <a href="/profile">My Profile</a>
          <a href="/messages">Messages</a>
          <a href="/notifications">Notifications</a>
          <% if (user.roles && user.roles.some((role) => ['acc_management_admin', 'system_admin', 'platform_admin', 'super_admin', 'moderator', 'support_staff', 'compliance_officer'].includes(role))) { %><a href="/admin/control-center">ACC Management</a><% } %>
          <a href="/logout">Logout</a>
        <% } else { %>
          <a href="/">Home</a>
          <div class="nav-menu" data-nav-menu>
            <button class="nav-menu__trigger" type="button" aria-expanded="false" aria-controls="publicMenu">Explore <span aria-hidden="true">+</span></button>
            <div class="nav-menu__panel nav-menu__panel--public" id="publicMenu">
              <div class="nav-menu__intro"><span class="nav-menu__label">African commerce</span><strong>Discover the network</strong><p>Explore trusted businesses and opportunities across the continent.</p></div>
              <div class="nav-menu__groups"><div class="nav-menu__group"><span>Explore</span><a href="/directory">Business directory<small>Discover verified companies</small></a><a href="/network">Networking<small>Meet potential partners</small></a><a href="/marketplace">Marketplace<small>Browse products and services</small></a></div><div class="nav-menu__group"><span>Support</span><a href="/assistant">ACC Assistance<small>Get help finding your way</small></a><a href="/login">Member login<small>Open your workspace</small></a><a href="/register">Join the chamber<small>Create your member account</small></a></div></div>
            </div>
          </div>
          <a href="/login">Login</a>
          <a href="/register">Register</a>
        <% } %>
      </div>
    </nav>

    <% if (typeof user !== 'undefined' && user) { %>
      <!-- Authenticated workspace sidebar keeps high-frequency member routes nearby. -->
      <div class="workspace-shell">
        <aside class="workspace-sidebar" id="workspaceSidebar" aria-label="Workspace navigation">
          <div class="workspace-sidebar__heading">
            <span class="workspace-sidebar__eyebrow">Member workspace</span>
            <strong>ACC workspace</strong>
          </div>
          <nav class="workspace-sidebar__nav">
            <% const hasManagementAccess = user.roles && user.roles.some((role) => ['acc_management_admin', 'system_admin', 'platform_admin', 'super_admin', 'moderator', 'support_staff', 'compliance_officer'].includes(role)); %>
            <a class="workspace-sidebar__link" href="<%= hasManagementAccess ? '/admin/dashboard' : '/dashboard' %>"><span class="workspace-sidebar__icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M4 13h6V4H4v9Zm0 7h6v-4H4v4Zm10 0h6v-9h-6v9Zm0-16v4h6V4h-6Z" /></svg></span><span>Dashboard</span></a>
            <a class="workspace-sidebar__link" href="/workspace"><span class="workspace-sidebar__icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v13a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 18.5v-13ZM7 7h10M7 11h10M7 15h6" /></svg></span><span>Workspace</span></a>
            <div class="workspace-sidebar__group" data-sidebar-group>
              <button class="workspace-sidebar__toggle" type="button" aria-expanded="false" aria-controls="workspaceTrade"><span><span class="workspace-sidebar__icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M5 7h14l-1 13H6L5 7Zm3 0a4 4 0 0 1 8 0M8 11h.01M16 11h.01" /></svg></span>Commerce</span><span aria-hidden="true">+</span></button>
              <div class="workspace-sidebar__submenu" id="workspaceTrade"><a href="/marketplace">Marketplace</a><a href="/marketplace/my-listings">My listings</a><a href="/procurement">Procurement &amp; sourcing</a><a href="/contracts">Contracts</a><a href="/orders">Orders</a><a href="/logistics">Logistics &amp; delivery</a><a href="/payments">Payments</a></div>
            </div>
            <div class="workspace-sidebar__group" data-sidebar-group>
                <button class="workspace-sidebar__toggle" type="button" aria-expanded="false" aria-controls="workspaceCommunity"><span><span class="workspace-sidebar__icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M16 20v-1.5A3.5 3.5 0 0 0 12.5 15h-5A3.5 3.5 0 0 0 4 18.5V20m6-9a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm5-5a2.5 2.5 0 1 1 0 5m1 4h1.5A2.5 2.5 0 0 1 20 17.5V20" /></svg></span>Community</span><span aria-hidden="true">+</span></button>
              <div class="workspace-sidebar__submenu" id="workspaceCommunity"><a href="/directory">Business directory</a><a href="/network">Networking</a><a href="/messages">Messages</a><a href="/notifications">Notifications</a><a href="/events">Events</a></div>
            </div>
            <div class="workspace-sidebar__group" data-sidebar-group>
                <button class="workspace-sidebar__toggle" type="button" aria-expanded="false" aria-controls="workspaceAccount"><span><span class="workspace-sidebar__icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8a7 7 0 0 1 14 0" /></svg></span>Account</span><span aria-hidden="true">+</span></button>
              <div class="workspace-sidebar__submenu" id="workspaceAccount"><a href="/profile">My profile</a><a href="/business/register">Register a business</a><a href="/subscriptions">Subscriptions &amp; billing</a><a href="/trust">Trust centre</a></div>
            </div>
            <a class="workspace-sidebar__link" href="/disputes"><span class="workspace-sidebar__icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M5 5h14v11H9l-4 4V5Zm4 5h6m-6 3h4" /></svg></span><span>Dispute resolution</span></a>
            <a class="workspace-sidebar__link" href="/assistant"><span class="workspace-sidebar__icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M5 6.5A2.5 2.5 0 0 1 7.5 4h9A2.5 2.5 0 0 1 19 6.5v6a2.5 2.5 0 0 1-2.5 2.5H12l-4 4v-4h-.5A2.5 2.5 0 0 1 5 12.5v-6ZM9 9h6m-6 3h4" /></svg></span><span>ACC Assistance</span></a>
          </nav>
          <a class="workspace-sidebar__signout" href="/logout">Sign out <span aria-hidden="true">&rarr;</span></a>
        </aside>
        <main class="container workspace-main">
          <%- body %>
        </main>
      </div>
    <% } else { %>
      <!-- Main content area where public page-specific templates are rendered. -->
      <main class="container">
        <%- body %>
      </main>
    <% } %>

    <%- include('../Partials/footer') %>

    <div class="global-assistant-widget" id="globalAssistantWidget">
      <button class="global-assistant-toggle" type="button" aria-expanded="false" aria-controls="globalAssistantPanel">Chat</button>
      <div class="global-assistant-panel" id="globalAssistantPanel" aria-live="polite">
        <div class="global-assistant-header">
          <strong>ACC Assistant</strong>
          <button type="button" class="global-assistant-close" aria-label="Close assistant">×</button>
        </div>
        <div class="assistant-quick-actions">
          <button type="button" class="assistant-quick-chip" data-question="How do I join ACC?">How do I join ACC?</button>
          <button type="button" class="assistant-quick-chip" data-question="How do I connect with businesses?">Connect with businesses</button>
          <button type="button" class="assistant-quick-chip" data-question="How do I register a business?">Register a business</button>
          <button type="button" class="assistant-quick-chip assistant-quick-chip--care" data-escalate="true">Speak with customer care</button>
        </div>
        <div class="global-assistant-messages">
          <div class="assistant-message assistant-message--bot">Hello! Ask me about ACC membership, networking, or business growth.</div>
        </div>
        <form class="global-assistant-form" id="globalAssistantForm">
          <textarea name="question" rows="3" placeholder="Ask ACC..." required></textarea>
          <button type="submit">Send</button>
          <button type="button" class="global-assistant-care" id="globalAssistantCare">Speak with customer care</button>
          <p class="assistant-status" id="globalAssistantStatus" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>

    <!-- Shared JavaScript keeps form enhancements out of the templates. -->
    <script src="/scripts/app.js" defer></script>
    <script>
      (function () {
        const widget = document.getElementById('globalAssistantWidget');
        const toggle = document.querySelector('.global-assistant-toggle');
        const panel = document.getElementById('globalAssistantPanel');
        const closeButton = document.querySelector('.global-assistant-close');
        const form = document.getElementById('globalAssistantForm');
        const messages = document.querySelector('.global-assistant-messages');
        const careButton = document.getElementById('globalAssistantCare');
        const status = document.getElementById('globalAssistantStatus');
        let lastQuestion = '';
        let lastAnswer = '';

        if (widget && toggle && panel && form && messages) {
          toggle.addEventListener('click', function () {
            const isOpen = panel.classList.toggle('is-open');
            toggle.setAttribute('aria-expanded', String(isOpen));
          });

          if (closeButton) {
            closeButton.addEventListener('click', function () {
              panel.classList.remove('is-open');
              toggle.setAttribute('aria-expanded', 'false');
            });
          }

          const sendMessage = async function (value) {
            const userMessage = document.createElement('div');
            userMessage.className = 'assistant-message assistant-message--user';
            userMessage.textContent = value;
            messages.appendChild(userMessage);

            const typing = document.createElement('div');
            typing.className = 'assistant-message assistant-message--bot assistant-message--typing';
            typing.innerHTML = '<span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span>';
            messages.appendChild(typing);
            messages.scrollTop = messages.scrollHeight;

            const response = await fetch('/assistant', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify({ question: value })
            });

            const data = await response.json();
            typing.remove();
            lastQuestion = value;
            lastAnswer = data.answer || '';

            const botMessage = document.createElement('div');
            botMessage.className = 'assistant-message assistant-message--bot';
            botMessage.textContent = data.answer || 'I can help with ACC membership, networking, and business growth.';
            messages.appendChild(botMessage);
            messages.scrollTop = messages.scrollHeight;
          };

          const requestCare = async function () {
            if (!lastQuestion) {
              if (status) status.textContent = 'Ask a question first so customer care can see the context.';
              return;
            }
            careButton.disabled = true;
            if (status) status.textContent = 'Sending your request to customer care...';
            const response = await fetch('/assistant/escalate', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ question: lastQuestion, assistantResponse: lastAnswer }) });
            const data = await response.json();
            if (status) status.textContent = data.message || 'Customer care has been notified.';
            careButton.disabled = false;
          };

          if (careButton) careButton.addEventListener('click', requestCare);

          form.addEventListener('submit', async function (event) {
            event.preventDefault();
            const textarea = form.querySelector('textarea');
            const value = (textarea && textarea.value || '').trim();
            if (!value) return;

            textarea.value = '';
            await sendMessage(value);
          });

          document.querySelectorAll('.assistant-quick-chip').forEach(function (chip) {
            chip.addEventListener('click', function () {
              const question = chip.getAttribute('data-question') || chip.textContent;
              if (!question) return;
              if (chip.getAttribute('data-escalate') === 'true') { requestCare(); return; }
              sendMessage(question);
            });
          });
        }
      })();
    </script>
    <% if (typeof pageScript !== 'undefined' && pageScript) { %>
      <script src="<%= pageScript %>" defer></script>
    <% } %>
  </body>
</html>
