<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Include the shared head partial with metadata and styling. -->
    <%- include('../Partials/head') %>
  </head>
  <body>
    <!-- Shared navigation bar for the application shell. -->
    <nav class="navbar" aria-label="Main navigation">
      <a class="brand" href="/" aria-label="African Chamber of Commerce home">
        <img src="/images/site/acc-logo (1).png" alt="African Chamber of Commerce logo" class="brand__logo" />
        <span class="brand__text">African Chamber of Commerce</span>
      </a>
      <div class="nav-links">
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/dashboard">Dashboard</a>
          <a href="/profile">My Profile</a>
          <a href="/logout">Logout</a>
        <% } else { %>
          <a href="/login">Login</a>
          <a href="/register">Register</a>
        <% } %>
      </div>
    </nav>

    <!-- Main content area where page-specific templates are rendered. -->
    <main class="container">
      <%- body %>
    </main>
    <!-- Shared JavaScript keeps form enhancements out of the templates. -->
    <script src="/scripts/app.js" defer></script>
    <% if (typeof pageScript !== 'undefined' && pageScript) { %>
      <script src="<%= pageScript %>" defer></script>
    <% } %>
  </body>
</html>
